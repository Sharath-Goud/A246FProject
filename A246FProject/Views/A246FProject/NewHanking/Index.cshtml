@model A246FProject.Models.NewHankingViewModel
@using Microsoft.AspNetCore.Mvc.Rendering
@using System.Data

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>New Hanking</title>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        body {
            background: linear-gradient(135deg,#0d0d1a,#0a0a2e,#0d1b2a);
            min-height: 100vh;
            color: #e2e8f0;
            padding: 20px;
        }

        /* CARD */

        .form-card {
            background: rgba(255,255,255,.04);
            border: 1px solid rgba(255,255,255,.08);
            border-radius: 16px;
            overflow: hidden;
            margin-bottom: 20px;
        }

        .form-card-header {
            background: rgba(167,139,250,.12);
            border-bottom: 1px solid rgba(167,139,250,.2);
            padding: 14px 22px;
            font-size: 18px;
            font-weight: 600;
            color: #fff;
        }

        .form-body {
            padding: 22px;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .form-row {
            display: grid;
            grid-template-columns: repeat(3,1fr);
            gap: 16px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
        }

        label {
            font-size: 11px;
            color: #8d95c7;
            letter-spacing: .5px;
            font-weight: 500;
            margin-bottom: 8px;
        }

        input,
        select {
            height: 44px;
            background: rgba(255,255,255,.06);
            border: 1px solid rgba(255,255,255,.12);
            border-radius: 8px;
            padding: 0 14px;
            font-size: 13px;
            color: #fff;
            outline: none;
        }

            input::placeholder {
                color: rgba(255,255,255,.35);
            }

            select option {
                background: #1a1040;
            }

            input:focus,
            select:focus {
                border-color: #a78bfa;
                background: rgba(167,139,250,.08);
            }

        /* BUTTONS */

        .btn-search {
            width: 100%;
            height: 44px;
            background: linear-gradient(135deg,#a78bfa,#7c3aed);
            border: none;
            border-radius: 8px;
            color: #fff;
            cursor: pointer;
            font-size: 14px;
            font-weight: 500;
        }

        .btn-submit {
            background: linear-gradient(135deg,#60a5fa,#2563eb);
            border: none;
            border-radius: 8px;
            padding: 10px 24px;
            color: #fff;
            cursor: pointer;
            font-size: 13px;
        }

        tbody tr td {
            font-size: 12px;
        }

        .results-table {
            background: rgba(255,255,255,.04);
            border: 1px solid rgba(255,255,255,.08);
            border-radius: 16px;
            overflow: hidden;
        }

        .table-scroll {
            overflow-x: auto;
            width: 100%;
        }

        .custom-table {
            width: 100%;
            min-width: 1200px;
            border-collapse: collapse;
        }

            .custom-table thead {
                background: rgba(167,139,250,.08);
            }

                .custom-table thead th {
                    padding: 14px 12px;
                    text-align: left;
                    font-size: 12px;
                    font-weight: 600;
                    color: rgba(255,255,255,.85);
                    border-bottom: 1px solid rgba(255,255,255,.08);
                    white-space: nowrap;
                }

            .custom-table tbody td {
                padding: 12px;
                text-align: left;
                color: #e2e8f0;
                border-top: 1px solid rgba(255,255,255,.05);
            }

                .custom-table tbody td input {
                    width: 100%;
                }

        .empty-row {
            height: 100px;
            color: rgba(255,255,255,.25);
            font-size: 13px;
        }

        .actions {
            margin-top: 16px;
        }

        @@media (max-width:900px) {
            .form-row {
                grid-template-columns: 1fr;
            }
        }
    </style>

</head>

<body>

    <div class="form-card">

        <div class="form-card-header">
            New Hanking
        </div>

        <form asp-action="Index" method="post">

            <div class="form-body">

                <!-- Row 1 -->

                <div class="form-row">

                    <div class="form-group">
                        <label>Line</label>

                        <select asp-for="LineId"
                                id="LineId"
                                asp-items="@(new SelectList(Model.Lines,
                    "LineId",
                    "LineName"))">
                            <option value="">-- Select Line --</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Project</label>

                        <select asp-for="ProjectId"
                                id="ProjectId"
                                asp-items="@(new SelectList(Model.Projects,
                                    "ProjectId",
                                    "ProjectName"))">
                            <option value="">-- Select Project --</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Model</label>

                        <select asp-for="ModelId"
                                id="ModelId"
                                asp-items="@(new SelectList(Model.ModelNos,
                                    "ModelId",
                                    "Model"))">
                            <option value="">-- Select Model --</option>
                        </select>
                    </div>

                </div>

                <!-- Row 2 -->

                <div class="form-row">

                    <div class="form-group">
                        <label>Part</label>

                        <select asp-for="PartId"
                                id="PartId"
                                asp-items="@(new SelectList(Model.PartNos,
                                    "PartId",
                                    "Part"))">
                            <option value="">-- Select Part --</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Machine</label>

                        <select asp-for="MachineId"
                                id="MachineId"
                                asp-items="@(new SelectList(Model.Machines,
                    "MachineId",
                    "Machine"))">
                            <option value="">-- Select Machine --</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Production Line Leader</label>

                        <input asp-for="ProdLineLeader"
                               type="text"
                               placeholder="Production Line Leader" />
                    </div>

                </div>

                <!-- Row 3 -->

                <div class="form-row">

                    <div class="form-group">
                        <label>Checked By</label>

                        <input asp-for="CheckedBy"
                               type="text" />
                    </div>

                    <div class="form-group">
                        <label>Approved By</label>

                        <input asp-for="ApprovedBy"
                               type="text" />
                    </div>

                    <div class="form-group"
                         style="justify-content:flex-end;">

                        <button type="submit"
                                class="btn-search">
                            Search
                        </button>
                    </div>
                </div>
            </div>
        </form>

    </div>

    <!-- TABLE -->

    <div class="results-table">

        <div class="table-scroll">

            <table class="custom-table">

                <thead>
                    <tr>
                        <th>
                            Work Station
                        </th>
                        <th>Inspection Project</th>
                        <th>Inspection Specifications</th>
                        <th>Frequency</th>
                        <th>section</th>
                        <th>Value1</th>
                        <th>Value2</th>
                        <th>Value3</th>
                        <th>Value4</th>
                        <th>Value5</th>
                        <th>Save</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.dtChecklist != null && Model.dtChecklist.Rows.Count > 0)
                    {
                        foreach (System.Data.DataRow row in Model.dtChecklist.Rows)
                        {
                            <tr data-section-id="@row["SectionId"]">
                                <td>@row["WorkStation"]</td>
                                <td>@row["InspectionProject"]</td>
                                <td>@row["InspectionSpecifications"]</td>
                                <td>@row["Frequency"]</td>
                                <td>@row["Section"]</td>

                                <td><input type="text" class="val-input" data-slot="1" /></td>
                                <td><input type="text" class="val-input" data-slot="2" /></td>
                                <td><input type="text" class="val-input" data-slot="3" /></td>
                                <td><input type="text" class="val-input" data-slot="4" /></td>
                                <td><input type="text" class="val-input" data-slot="5" /></td>

                                <td>
                                    <button type="button" class="btn-search row-save-btn">
                                        Save
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="11" class="empty-row">
                                No records found. Use search to load data.
                            </td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>

    </div>

    <div class="actions">

        <button class="btn-submit">
            Submit
        </button>

    </div>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
                $("#ProjectId").change(function () {

            var projectId = $(this).val();

            $.ajax({
                url: '/NewHanking/GetModelNoByProject',
                type: 'POST',
                data: { projectId: projectId },

                success: function (data) {

                    $("#ModelId").empty();
                    $("#ModelId").append('<option value="">-- Select Model --</option>');

                    $.each(data, function (i, item) {

                        $("#ModelId").append(
                            '<option value="' + item.modelId + '">' + item.model + '</option>'
                        );
                    });

                },
                error: function (xhr) {

                    alert("Ajax Error");
                }
            });

        });

        $("#ModelId").change(function () {

            var modelId = $("#ModelId").val();

            $.ajax({
                url: '/NewHanking/GetPartNoByModel',
                type: 'POST',
                data: { modelId: modelId },

                success: function (data) {

                    $("#PartId").empty();

                    $("#PartId").append(
                        '<option value="">-- Select Part --</option>'
                    );

                    $.each(data, function (i, item) {

                        $("#PartId").append(
                            '<option value="' +
                            item.partId +
                            '">' +
                            item.part +
                            '</option>'
                        );
                    });
                }
            });

        });
    </script>
    <script>
    function buildItemFromRow($row) {
        var sectionId = parseInt($row.data("section-id"), 10);
        var vals = {};
        $row.find(".val-input").each(function () {
            var slot = $(this).data("slot");
            var raw = $(this).val();
            if (raw === "" || raw === null) {
                vals["value" + slot] = null;
            }
            else if (isNaN(raw)) {
                alert("Please enter only numeric values.");
                throw "Invalid value";
            }
            else {
                vals["value" + slot] = parseFloat(raw);
            }
        });

        return {
            sectionId: sectionId,
            value1: vals.value1,
            value2: vals.value2,
            value3: vals.value3,
            value4: vals.value4,
            value5: vals.value5
        };
    }

    function getHeaderContext() {
        return {
            lineId: parseInt($("#LineId").val(), 10) || 0,
            projectId: parseInt($("#ProjectId").val(), 10) || 0,
            modelId: parseInt($("#ModelId").val(), 10) || 0,
            partId: parseInt($("#PartId").val(), 10) || 0,
            machineId: parseInt($("#MachineId").val(), 10) || 0,
            prodLineLeader: $("input[name='ProdLineLeader']").val(),
            checkedBy: $("input[name='CheckedBy']").val(),
            approvedBy: $("input[name='ApprovedBy']").val()
        };
    }

    function submitItems(items) {
        var ctx = getHeaderContext();

        var payload = {
            lineId: ctx.lineId,
            projectId: ctx.projectId,
            modelId: ctx.modelId,
            partId: ctx.partId,
            machineId: ctx.machineId,
            prodLineLeader: ctx.prodLineLeader,
            checkedBy: ctx.checkedBy,
            approvedBy: ctx.approvedBy,
            items: items
        };

        return $.ajax({
            url: '/NewHanking/SubmitChecklist',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(payload)
        });
    }

            $(document).on("click", ".row-save-btn", function () {

            let clickedRow = $(this).closest("tr");

            let rowsToSave = [];

            $(".custom-table tbody tr[data-section-id]").each(function () {

                let row = $(this);

                let value1 = $.trim(row.find(".val-input[data-slot='1']").val());
                let value2 = $.trim(row.find(".val-input[data-slot='2']").val());
                let value3 = $.trim(row.find(".val-input[data-slot='3']").val());
                let value4 = $.trim(row.find(".val-input[data-slot='4']").val());
                let value5 = $.trim(row.find(".val-input[data-slot='5']").val());

                let hasValue =
                    value1 !== "" ||
                    value2 !== "" ||
                    value3 !== "" ||
                    value4 !== "" ||
                    value5 !== "";

                if (hasValue) {

                    let item = buildItemFromRow(row);

                    item._htmlRow = row;

                    rowsToSave.push(item);

                }

                // Stop after clicked row
                if (row[0] === clickedRow[0]) {
                    return false;
                }

            });

            if (rowsToSave.length === 0) {

                alert("Please enter at least one value before saving.");

                return;

            }

            let items = rowsToSave.map(function (x) {

                return {

                    sectionId: x.sectionId,

                    value1: x.value1,
                    value2: x.value2,
                    value3: x.value3,
                    value4: x.value4,
                    value5: x.value5

                };

            });

            submitItems(items)

                .done(function (res) {

                    if (res.success) {

                        alert("Rows Saved Successfully");

                        rowsToSave.forEach(function (x) {

                            x._htmlRow.remove();

                        });

                        if ($(".custom-table tbody tr[data-section-id]").length === 0) {

                            $(".custom-table tbody").html(`
                                <tr>
                                    <td colspan="11" class="empty-row">
                                        No records found.
                                    </td>
                                </tr>
                            `);

                        }

                    }
                    else {

                        alert(res.message);

                    }

                })

                .fail(function () {

                    alert("Save Error");

                });

        });

    $(".btn-submit").on("click", function (e) {
        e.preventDefault();

        var items = [];
        $(".custom-table tbody tr[data-section-id]").each(function () {
            items.push(buildItemFromRow($(this)));
        });

        if (items.length === 0) {
            alert("No data to submit.");
            return;
        }

        submitItems(items)
        .done(function (res) {

            if (res.success) {

                alert("All rows saved successfully.");

                $(".val-input").val("");

                $("#LineId").val("");
                $("#ProjectId").val("");
                $("#ModelId").empty().append('<option value="">-- Select Model --</option>');
                $("#PartId").empty().append('<option value="">-- Select Part --</option>');
                $("#MachineId").val("");

                $("input[name='ProdLineLeader']").val("");
                $("input[name='CheckedBy']").val("");
                $("input[name='ApprovedBy']").val("");

            }
            else {
                alert("Submit failed: " + res.message);
            }

        })
        .fail(function (xhr) {
            alert("Submit error.");
        });
    });
</script>
</body>
</html>