@model A246FProject.Models.NewHankingViewModel
@using Microsoft.AspNetCore.Mvc.Rendering
@using System.Data

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>New Hanking</title>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        body {
            background: linear-gradient(135deg,#0d0d1a,#0a0a2e,#0d1b2a);
            min-height: 100vh;
            color: #e2e8f0;
            padding: 20px;
        }

        /* CARD */

        .form-card {
            background: rgba(255,255,255,.04);
            border: 1px solid rgba(255,255,255,.08);
            border-radius: 16px;
            overflow: hidden;
            margin-bottom: 20px;
        }

        .form-card-header {
            background: rgba(167,139,250,.12);
            border-bottom: 1px solid rgba(167,139,250,.2);
            padding: 14px 22px;
            font-size: 18px;
            font-weight: 600;
            color: #fff;
        }

        .form-body {
            padding: 22px;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .form-row {
            display: grid;
            grid-template-columns: repeat(3,1fr);
            gap: 16px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
        }

        label {
            font-size: 11px;
            color: #8d95c7;
            letter-spacing: .5px;
            font-weight: 500;
            margin-bottom: 8px;
        }

        input,
        select {
            height: 44px;
            background: rgba(255,255,255,.06);
            border: 1px solid rgba(255,255,255,.12);
            border-radius: 8px;
            padding: 0 14px;
            font-size: 13px;
            color: #fff;
            outline: none;
        }

            input::placeholder {
                color: rgba(255,255,255,.35);
            }

            select option {
                background: #1a1040;
            }

            input:focus,
            select:focus {
                border-color: #a78bfa;
                background: rgba(167,139,250,.08);
            }

        /* BUTTONS */

        .btn-search {
            width: 100%;
            height: 44px;
            background: linear-gradient(135deg,#a78bfa,#7c3aed);
            border: none;
            border-radius: 8px;
            color: #fff;
            cursor: pointer;
            font-size: 14px;
            font-weight: 500;
        }

        .btn-submit {
            background: linear-gradient(135deg,#60a5fa,#2563eb);
            border: none;
            border-radius: 8px;
            padding: 10px 24px;
            color: #fff;
            cursor: pointer;
            font-size: 13px;
        }

        tbody tr td {
            font-size: 12px;
        }

        .results-table {
            background: rgba(255,255,255,.04);
            border: 1px solid rgba(255,255,255,.08);
            border-radius: 16px;
            overflow: hidden;
        }

        .table-scroll {
            overflow-x: auto;
            width: 100%;
        }

        .custom-table {
            width: 100%;
            min-width: 1200px;
            border-collapse: collapse;
        }

            .custom-table thead {
                background: rgba(167,139,250,.08);
            }

                .custom-table thead th {
                    padding: 14px 12px;
                    text-align: left;
                    font-size: 12px;
                    font-weight: 600;
                    color: rgba(255,255,255,.85);
                    border-bottom: 1px solid rgba(255,255,255,.08);
                    white-space: nowrap;
                }

            .custom-table tbody td {
                padding: 12px;
                text-align: left;
                color: #e2e8f0;
                border-top: 1px solid rgba(255,255,255,.05);
            }

                .custom-table tbody td input {
                    width: 100%;
                }

        .empty-row {
            height: 100px;
            color: rgba(255,255,255,.25);
            font-size: 13px;
        }

        .actions {
            margin-top: 16px;
        }

        @@media (max-width:900px) {
            .form-row {
                grid-template-columns: 1fr;
            }
        }

        .ng-row {
            background: rgba(220, 53, 69, 0.20) !important;
            border-left: 4px solid #dc3545 !important;
        }

            .ng-row td {
                background: rgba(220, 53, 69, 0.08) !important;
                color: #ff8080 !important;
            }

        .ng-value {
            border: 2px solid #dc3545 !important;
            background: rgba(220, 53, 69, 0.18) !important;
            color: #ff8080 !important;
        }

        .ok-value {
            border: 2px solid #28a745 !important;
            background: rgba(40, 167, 69, 0.12) !important;
            color: #90ee90 !important;
        }
    </style>

</head>

<body>

    <div class="form-card">

        <div class="form-card-header">
            New Hanking
        </div>

        <form asp-action="Index" method="post">

            <div class="form-body">

                <!-- Row 1 -->

                <div class="form-row">

                    <div class="form-group">
                        <label>Line</label>

                        <select asp-for="LineId"
                                id="LineId"
                                asp-items="@(new SelectList(Model.Lines,
                    "LineId",
                    "LineName"))">
                            <option value="">-- Select Line --</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Project</label>

                        <select asp-for="ProjectId"
                                id="ProjectId"
                                asp-items="@(new SelectList(Model.Projects,
                                    "ProjectId",
                                    "ProjectName"))">
                            <option value="">-- Select Project --</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Model</label>

                        <select asp-for="ModelId"
                                id="ModelId"
                                asp-items="@(new SelectList(Model.ModelNos,
                                    "ModelId",
                                    "Model"))">
                            <option value="">-- Select Model --</option>
                        </select>
                    </div>

                </div>

                <!-- Row 2 -->

                <div class="form-row">

                    <div class="form-group">
                        <label>Part</label>

                        <select asp-for="PartId"
                                id="PartId"
                                asp-items="@(new SelectList(Model.PartNos,
                                    "PartId",
                                    "Part"))">
                            <option value="">-- Select Part --</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Machine</label>

                        <select asp-for="MachineId"
                                id="MachineId"
                                asp-items="@(new SelectList(Model.Machines,
                    "MachineId",
                    "Machine"))">
                            <option value="">-- Select Machine --</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Production Line Leader</label>

                        <input asp-for="ProdLineLeader"
                               type="text"
                               placeholder="Production Line Leader" />
                    </div>

                </div>

                <!-- Row 3 -->

                <div class="form-row">

                    <div class="form-group">
                        <label>Checked By</label>

                        <input asp-for="CheckedBy"
                               type="text" />
                    </div>

                    <div class="form-group">
                        <label>Approved By</label>

                        <input asp-for="ApprovedBy"
                               type="text" />
                    </div>

                    <div class="form-group"
                         style="justify-content:flex-end;">

                        <button type="submit"
                                class="btn-search">
                            Search
                        </button>
                    </div>
                </div>
            </div>
        </form>

        @if (ViewBag.Message != null)
        {
            <div id="validationMessage"
                 style="
         background:#dc3545;
         color:white;
         padding:10px 15px;
         border-radius:8px;
         margin:10px 0;
         font-size:13px;
         font-weight:500;">

                @ViewBag.Message

            </div>
        }

    </div>

    <!-- TABLE -->

    <div class="results-table">

        <div class="table-scroll">

            <table class="custom-table">

                <thead>
                    <tr>
                        <th>
                            Work Station
                        </th>
                        <th>Inspection Project</th>
                        <th>Inspection Specifications</th>
                        <th>Frequency</th>
                        <th>section</th>
                        <th>Value1</th>
                        <th>Value2</th>
                        <th>Value3</th>
                        <th>Value4</th>
                        <th>Value5</th>
                        <th>Save</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.dtChecklist != null && Model.dtChecklist.Rows.Count > 0)
                    {
                        foreach (System.Data.DataRow row in Model.dtChecklist.Rows)
                        {
                            <tr data-section-id="@row["SectionId"]"
                                data-specification="@row["InspectionSpecifications"]">

                                <td>@row["WorkStation"]</td>
                                <td>@row["InspectionProject"]</td>
                                <td>@row["InspectionSpecifications"]</td>
                                <td>@row["Frequency"]</td>
                                <td>@row["Section"]</td>

                                <td><input type="text" class="val-input" data-slot="1" /></td>
                                <td><input type="text" class="val-input" data-slot="2" /></td>
                                <td><input type="text" class="val-input" data-slot="3" /></td>
                                <td><input type="text" class="val-input" data-slot="4" /></td>
                                <td><input type="text" class="val-input" data-slot="5" /></td>

                                <td>
                                    <button type="button" class="btn-search row-save-btn">
                                        Save
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="11" class="empty-row">
                                No records found. Use search to load data.
                            </td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>

    </div>

    <div class="actions">

        <button class="btn-submit">
            Submit
        </button>

    </div>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
                $("#ProjectId").change(function () {

            var projectId = $(this).val();

            $.ajax({
                url: '/NewHanking/GetModelNoByProject',
                type: 'POST',
                data: { projectId: projectId },

                success: function (data) {

                    $("#ModelId").empty();
                    $("#ModelId").append('<option value="">-- Select Model --</option>');

                    $.each(data, function (i, item) {

                        $("#ModelId").append(
                            '<option value="' + item.modelId + '">' + item.model + '</option>'
                        );
                    });

                },
                error: function (xhr) {

                    alert("Ajax Error");
                }
            });

        });

        $("#ModelId").change(function () {

            var modelId = $("#ModelId").val();

            $.ajax({
                url: '/NewHanking/GetPartNoByModel',
                type: 'POST',
                data: { modelId: modelId },

                success: function (data) {

                    $("#PartId").empty();

                    $("#PartId").append(
                        '<option value="">-- Select Part --</option>'
                    );

                    $.each(data, function (i, item) {

                        $("#PartId").append(
                            '<option value="' +
                            item.partId +
                            '">' +
                            item.part +
                            '</option>'
                        );
                    });
                }
            });

        });
    </script>
    <script>

                function getSpecificationRange(specification) {

            if (!specification) {
                return null;
            }

            let spec = specification.toString()
                .trim()
                .replace(/\s+/g, "")
                .replace(/mm/gi, "");

            /*
               Pattern 1:

               126.63±1.0

               Result:
               Min = 125.63
               Max = 127.63
            */

            let plusMinusMatch = spec.match(
                /^([+-]?\d+(?:\.\d+)?)±([+-]?\d+(?:\.\d+)?)$/
            );

            if (plusMinusMatch) {

                let target = parseFloat(plusMinusMatch[1]);
                let tolerance = parseFloat(plusMinusMatch[2]);

                return {
                    min: target - tolerance,
                    max: target + tolerance
                };
            }


            /*
               Pattern 2:

               6.22+0.83/0.00

               Result:
               Min = 6.22 - 0.00 = 6.22
               Max = 6.22 + 0.83 = 7.05
            */

            let asymmetricMatch = spec.match(
                /^([+-]?\d+(?:\.\d+)?)\+(\d+(?:\.\d+)?)\/(\d+(?:\.\d+)?)$/
            );

            if (asymmetricMatch) {

                let target = parseFloat(asymmetricMatch[1]);
                let plusTolerance = parseFloat(asymmetricMatch[2]);
                let minusTolerance = parseFloat(asymmetricMatch[3]);

                return {
                    min: target - minusTolerance,
                    max: target + plusTolerance
                };
            }


            /*
               Pattern 3:

               1000

               Exact value expected.
            */

            let exactMatch = spec.match(
                /^([+-]?\d+(?:\.\d+)?)$/
            );

            if (exactMatch) {

                let exactValue = parseFloat(exactMatch[1]);

                return {
                    min: exactValue,
                    max: exactValue
                };
            }

            return null;
        }

        function validateInputValue($input) {

            let $row = $input.closest("tr");

            let specification = $row.data("specification");

            let range = getSpecificationRange(specification);

            let rawValue = $.trim($input.val());


            // Empty values are allowed
            if (rawValue === "") {

                $input.removeClass("ng-value ok-value");

                return {
                    valid: true,
                    message: ""
                };

            }


            // NG text is not allowed
            if (rawValue.toUpperCase() === "NG") {

                $input
                    .removeClass("ok-value")
                    .addClass("ng-value");

                return {
                    valid: false,
                    message: "NG value is not allowed"
                };

            }


            // Numeric validation
            let numericValue = Number(rawValue);

            if (isNaN(numericValue)) {

                $input
                    .removeClass("ok-value")
                    .addClass("ng-value");

                return {
                    valid: false,
                    message: "Please enter a valid numeric value"
                };

            }


            // If specification does not have a numeric range
            if (!range) {

                $input
                    .removeClass("ng-value")
                    .removeClass("ok-value");

                return {
                    valid: true,
                    message: ""
                };

            }


            // Minimum validation
            if (numericValue < range.min) {

                $input
                    .removeClass("ok-value")
                    .addClass("ng-value");

                return {
                    valid: false,
                    message:
                        "Value " + numericValue +
                        " is below Minimum " + range.min
                };

            }


            // Maximum validation
            if (numericValue > range.max) {

                $input
                    .removeClass("ok-value")
                    .addClass("ng-value");

                return {
                    valid: false,
                    message:
                        "Value " + numericValue +
                        " is above Maximum " + range.max
                };

            }


            // Valid value
            $input
                .removeClass("ng-value")
                .addClass("ok-value");


            return {

                valid: true,
                message: ""

            };

        }

        function validateHankingRow(row) {

            let invalidValues = [];


            // Remove previous NG row style
            row.removeClass("ng-row");


            // Validate all value fields
            row.find(".val-input").each(function () {

                let input = $(this);

                let value = $.trim(input.val());


                // Validate only entered values
                if (value !== "") {

                    let result =
                        validateInputValue(input);


                    if (!result.valid) {

                        invalidValues.push(

                            "Value " +
                            input.data("slot") +
                            " = " +
                            value +
                            " (" +
                            result.message +
                            ")"

                        );

                    }

                }

            });


            // Mark entire row as NG
            if (invalidValues.length > 0) {

                row.addClass("ng-row");

                return {

                    valid: false,

                    message:
                        invalidValues.join("\n")

                };

            }


            return {

                valid: true,

                message: ""

            };

        }

                $(document).on(
            "input change",
            ".val-input",
            function () {

                let row =
                    $(this).closest("tr[data-section-id]");


                validateHankingRow(row);

            }
        );

                function buildItemFromRow(row) {

            let sectionId =
                parseInt(
                    row.data("section-id")
                );


            let value1 =
                $.trim(
                    row.find(
                        ".val-input[data-slot='1']"
                    ).val()
                );

            let value2 =
                $.trim(
                    row.find(
                        ".val-input[data-slot='2']"
                    ).val()
                );

            let value3 =
                $.trim(
                    row.find(
                        ".val-input[data-slot='3']"
                    ).val()
                );

            let value4 =
                $.trim(
                    row.find(
                        ".val-input[data-slot='4']"
                    ).val()
                );

            let value5 =
                $.trim(
                    row.find(
                        ".val-input[data-slot='5']"
                    ).val()
                );


            return {

                sectionId: sectionId,

                value1:
                    value1 === ""
                        ? null
                        : parseFloat(value1),

                value2:
                    value2 === ""
                        ? null
                        : parseFloat(value2),

                value3:
                    value3 === ""
                        ? null
                        : parseFloat(value3),

                value4:
                    value4 === ""
                        ? null
                        : parseFloat(value4),

                value5:
                    value5 === ""
                        ? null
                        : parseFloat(value5)

            };

        }

    function getHeaderContext() {
        return {
            lineId: parseInt($("#LineId").val(), 10) || 0,
            projectId: parseInt($("#ProjectId").val(), 10) || 0,
            modelId: parseInt($("#ModelId").val(), 10) || 0,
            partId: parseInt($("#PartId").val(), 10) || 0,
            machineId: parseInt($("#MachineId").val(), 10) || 0,
            prodLineLeader: $("input[name='ProdLineLeader']").val(),
            checkedBy: $("input[name='CheckedBy']").val(),
            approvedBy: $("input[name='ApprovedBy']").val()
        };
    }

    function submitItems(items) {
        var ctx = getHeaderContext();

        var payload = {
            lineId: ctx.lineId,
            projectId: ctx.projectId,
            modelId: ctx.modelId,
            partId: ctx.partId,
            machineId: ctx.machineId,
            prodLineLeader: ctx.prodLineLeader,
            checkedBy: ctx.checkedBy,
            approvedBy: ctx.approvedBy,
            items: items
        };

        return $.ajax({
            url: '/NewHanking/SubmitChecklist',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(payload)
        });
    }

        $(document).on(
            "click",
            ".row-save-btn",
            function () {

                let clickedRow =
                    $(this).closest(
                        "tr[data-section-id]"
                    );


                let rowsToSave = [];

                let validationErrors = [];


                $(".custom-table tbody tr[data-section-id]")
                    .each(function () {

                        let row = $(this);


                        let value1 =
                            $.trim(
                                row.find(
                                    ".val-input[data-slot='1']"
                                ).val()
                            );

                        let value2 =
                            $.trim(
                                row.find(
                                    ".val-input[data-slot='2']"
                                ).val()
                            );

                        let value3 =
                            $.trim(
                                row.find(
                                    ".val-input[data-slot='3']"
                                ).val()
                            );

                        let value4 =
                            $.trim(
                                row.find(
                                    ".val-input[data-slot='4']"
                                ).val()
                            );

                        let value5 =
                            $.trim(
                                row.find(
                                    ".val-input[data-slot='5']"
                                ).val()
                            );


                        let hasValue =

                            value1 !== "" ||
                            value2 !== "" ||
                            value3 !== "" ||
                            value4 !== "" ||
                            value5 !== "";


                        // Validate only rows having values
                        if (hasValue) {

                            let validationResult =
                                validateHankingRow(row);


                            if (!validationResult.valid) {

                                validationErrors.push(
                                    validationResult.message
                                );

                            }

                        }


                        // Add only rows having values
                        if (hasValue) {

                            let item =
                                buildItemFromRow(row);


                            item._htmlRow = row;


                            rowsToSave.push(item);

                        }


                        // Stop at clicked Save row
                        if (row[0] === clickedRow[0]) {

                            return false;

                        }

                    });


                // Stop saving when invalid values exist
                if (validationErrors.length > 0) {

                    alert(

                        "❌ Cannot save because NG / invalid values were found.\n\n" +

                        validationErrors.join("\n\n")

                    );

                    return;

                }


                if (rowsToSave.length === 0) {

                    alert(
                        "Please enter at least one value before saving."
                    );

                    return;

                }


                // Remove _htmlRow before sending
                let items =
                    rowsToSave.map(function (x) {

                        return {

                            sectionId:
                                x.sectionId,

                            value1:
                                x.value1,

                            value2:
                                x.value2,

                            value3:
                                x.value3,

                            value4:
                                x.value4,

                            value5:
                                x.value5

                        };

                    });


                submitItems(items)

                    .done(function (res) {

                        if (
                            res &&
                            res.success === false
                        ) {

                            alert(
                                res.message ||
                                "Save Failed"
                            );

                            return;

                        }


                        alert(
                            res.message ||
                            "Saved Successfully"
                        );


                        // Remove only saved rows
                        rowsToSave.forEach(
                            function (x) {

                                x._htmlRow.remove();

                            }
                        );


                        // Show empty row
                        if (

                            $(".custom-table tbody tr[data-section-id]")
                                .length === 0

                        ) {

                            $(".custom-table tbody")
                                .html(

                                    `<tr>

                                        <td colspan="11"
                                            class="empty-row">

                                            No records found.

                                        </td>

                                    </tr>`

                                );

                        }

                    })

                    .fail(function () {

                        alert(
                            "Save Failed"
                        );

                    });

            }
        );

                $(".btn-submit").on(
            "click",
            function (e) {

                e.preventDefault();


                let items = [];

                let validationErrors = [];


                $(".custom-table tbody tr[data-section-id]")
                    .each(function () {

                        let row = $(this);


                        let value1 =
                            $.trim(
                                row.find(
                                    ".val-input[data-slot='1']"
                                ).val()
                            );

                        let value2 =
                            $.trim(
                                row.find(
                                    ".val-input[data-slot='2']"
                                ).val()
                            );

                        let value3 =
                            $.trim(
                                row.find(
                                    ".val-input[data-slot='3']"
                                ).val()
                            );

                        let value4 =
                            $.trim(
                                row.find(
                                    ".val-input[data-slot='4']"
                                ).val()
                            );

                        let value5 =
                            $.trim(
                                row.find(
                                    ".val-input[data-slot='5']"
                                ).val()
                            );


                        let hasValue =

                            value1 !== "" ||
                            value2 !== "" ||
                            value3 !== "" ||
                            value4 !== "" ||
                            value5 !== "";


                        // Validate only entered rows
                        if (hasValue) {

                            let validationResult =
                                validateHankingRow(row);


                            if (!validationResult.valid) {

                                let sectionName =
                                    row.find("td:eq(4)")
                                        .text()
                                        .trim();


                                validationErrors.push(

                                    "Section: " +
                                    sectionName +
                                    "\n" +
                                    validationResult.message

                                );

                                return;

                            }


                            items.push(
                                buildItemFromRow(row)
                            );

                        }

                    });


                // Stop submit when NG exists
                if (validationErrors.length > 0) {

                    alert(

                        "❌ Cannot submit because NG / invalid values were found.\n\n" +

                        validationErrors.join("\n\n")

                    );

                    return;

                }


                if (items.length === 0) {

                    alert(
                        "Please enter at least one value before submitting."
                    );

                    return;

                }


                submitItems(items)

                    .done(function (res) {

                        if (
                            res &&
                            res.success === false
                        ) {

                            alert(
                                res.message ||
                                "Submit Failed"
                            );

                            return;

                        }


                        alert(
                            res.message ||
                            "Saved Successfully"
                        );


                        location.reload();

                    })

                    .fail(function () {

                        alert(
                            "Submit Failed"
