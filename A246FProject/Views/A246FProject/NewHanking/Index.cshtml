<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>New Hanking</title>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        body {
            background: linear-gradient(135deg,#0d0d1a,#0a0a2e,#0d1b2a);
            min-height: 100vh;
            color: #e2e8f0;
            padding: 20px;
        }

        /* CARD */

        .form-card {
            background: rgba(255,255,255,.04);
            border: 1px solid rgba(255,255,255,.08);
            border-radius: 16px;
            overflow: hidden;
            margin-bottom: 20px;
        }

        .form-card-header {
            background: rgba(167,139,250,.12);
            border-bottom: 1px solid rgba(167,139,250,.2);
            padding: 14px 22px;
            font-size: 18px;
            font-weight: 600;
            color: #fff;
        }

        .form-body {
            padding: 22px;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .form-row {
            display: grid;
            grid-template-columns: repeat(3,1fr);
            gap: 16px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
        }

        label {
            font-size: 11px;
            color: #8d95c7;
            text-transform: uppercase;
            letter-spacing: .5px;
            font-weight: 500;
            margin-bottom: 8px;
        }

        input,
        select {
            height: 44px;
            background: rgba(255,255,255,.06);
            border: 1px solid rgba(255,255,255,.12);
            border-radius: 8px;
            padding: 0 14px;
            font-size: 13px;
            color: #fff;
            outline: none;
        }

            input::placeholder {
                color: rgba(255,255,255,.35);
            }

            select option {
                background: #1a1040;
            }

            input:focus,
            select:focus {
                border-color: #a78bfa;
                background: rgba(167,139,250,.08);
            }

        /* BUTTONS */

        .btn-search {
            width: 100%;
            height: 44px;
            background: linear-gradient(135deg,#a78bfa,#7c3aed);
            border: none;
            border-radius: 8px;
            color: #fff;
            cursor: pointer;
            font-size: 14px;
            font-weight: 500;
        }

        .btn-submit {
            background: linear-gradient(135deg,#60a5fa,#2563eb);
            border: none;
            border-radius: 8px;
            padding: 10px 24px;
            color: #fff;
            cursor: pointer;
            font-size: 13px;
        }

        .btn-save {
            background: linear-gradient(135deg,#34d399,#059669);
            border: none;
            border-radius: 6px;
            padding: 7px 14px;
            color: #fff;
            cursor: pointer;
        }

        /* TABLE */

        .results-table {
            background: rgba(255,255,255,.04);
            border: 1px solid rgba(255,255,255,.08);
            border-radius: 16px;
            overflow: hidden;
        }

        .table-scroll {
            overflow-x: auto;
            width: 100%;
        }

        .custom-table {
            width: 100%;
            min-width: 1700px;
            border-collapse: collapse;
        }

            .custom-table thead {
                background: rgba(167,139,250,.08);
            }

                .custom-table thead th {
                    padding: 14px 12px;
                    text-align: center;
                    font-size: 12px;
                    font-weight: 600;
                    color: rgba(255,255,255,.85);
                    border-bottom: 1px solid rgba(255,255,255,.08);
                    white-space: nowrap;
                }

            .custom-table tbody td {
                padding: 12px;
                text-align: center;
                color: #e2e8f0;
                border-top: 1px solid rgba(255,255,255,.05);
            }

                .custom-table tbody td input {
                    width: 100%;
                }

        .empty-row {
            height: 100px;
            color: rgba(255,255,255,.25);
            font-size: 13px;
        }

        .actions {
            margin-top: 16px;
        }

        @@media (max-width:900px) {
            .form-row {
                grid-template-columns: 1fr;
            }
        }
    </style>

</head>

<body>

    <div class="form-card">

        <div class="form-card-header">
            New Hanking
        </div>

        <div class="form-body">

            <!-- Row 1 -->

            <div class="form-row">

                <div class="form-group">
                    <label>LINE</label>
                    <select>
                        <option>-- Select Line --</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>PROJECT</label>
                    <select>
                        <option>-- Select Project --</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>MODEL</label>
                    <select>
                        <option>-- Select Model --</option>
                    </select>
                </div>

            </div>

            <!-- Row 2 -->

            <div class="form-row">

                <div class="form-group">
                    <label>PART</label>
                    <select>
                        <option>-- Select Part --</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>MACHINE</label>
                    <select>
                        <option>-- Select Machine --</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>LINE LEADER</label>
                    <input type="text"
                           placeholder="Production LineLeader">
                </div>

            </div>

            <!-- Row 3 -->

            <div class="form-row">

                <div class="form-group">
                    <label>CHECKED BY</label>
                    <input type="text">
                </div>

                <div class="form-group">
                    <label>APPROVED BY</label>
                    <input type="text">
                </div>

                <div class="form-group">
                    <label>&nbsp;</label>
                    <button class="btn-search">
                        Search
                    </button>
                </div>

            </div>

        </div>

    </div>

    <!-- TABLE -->

    <div class="results-table">

        <div class="table-scroll">

            <table class="custom-table">

                <thead>
                    <tr>
                        <th>
                            Work Station
                        </th>
                        <th>Inspection Project</th>
                        <th>Inspection Specifications</th>
                        <th>Frequency</th>
                        <th>section</th>
                        <th>Value1</th>
                        <th>Value2</th>
                        <th>Value3</th>
                        <th>Value4</th>
                        <th>Value5</th>
                        <th>Save</th>
                    </tr>
                </thead>

                <tbody>

                    <tr>
                        <td colspan="14" class="empty-row">
                            No records found. Use search to load data.
                        </td>
                    </tr>

                </tbody>

            </table>

        </div>

    </div>

    <div class="actions">

        <button class="btn-submit">
            Submit
        </button>

    </div>

</body>
</html>