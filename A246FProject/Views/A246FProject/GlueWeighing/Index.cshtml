@model A246FProject.Models.GlueWeighingViewModel
@using Microsoft.AspNetCore.Mvc.Rendering
@using System.Data
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Glue Weighing</title>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Poppins, sans-serif;
        }

        body {
            background: linear-gradient(135deg, #0d0d1a, #0a0a2e, #0d1b2a);
            min-height: 100vh;
            color: #e2e8f0;
            padding: 20px;
        }

        h1 {
            font-size: 22px;
            font-weight: 600;
            color: #fff;
            margin-bottom: 4px;
        }

        .sub {
            color: rgba(255,255,255,.4);
            font-size: 13px;
            margin-bottom: 18px;
        }

        /* FORM CARD */
        .form-card {
            background: rgba(255,255,255,.04);
            border: 0.5px solid rgba(255,255,255,.08);
            border-radius: 16px;
            overflow: hidden;
            margin-bottom: 16px;
        }

        .form-card-header {
            background: rgba(167,139,250,.12);
            border-bottom: 0.5px solid rgba(167,139,250,.2);
            padding: 14px 22px;
            font-size: 15px;
            font-weight: 600;
            color: #fff;
        }

        .form-body {
            padding: 22px;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .form-row {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 14px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        label {
            font-size: 11px;
            color: rgba(255,255,255,.45);
        }

        .actual-input {
            width: 90px;
            height: 35px;
            padding: 5px 8px;
            border-radius: 8px;
            background: rgba(255,255,255,.06);
            border: 0.5px solid rgba(255,255,255,.12);
            color: #fff;
            font-size: 13px;
            text-align: center;
        }

        input, select {
            background: rgba(255,255,255,.06);
            border: 0.5px solid rgba(255,255,255,.12);
            border-radius: 8px;
            padding: 9px 12px;
            font-size: 13px;
            color: #fff;
            outline: none;
        }

            select option {
                background: #1a1040;
            }

            input:focus, select:focus {
                border-color: rgba(167,139,250,.5);
                background: rgba(167,139,250,.08);
            }

        /* BUTTON */
        .btn-search {
            background: linear-gradient(135deg, #a78bfa, #7c3aed);
            border: none;
            border-radius: 8px;
            padding: 10px 20px;
            color: #fff;
            cursor: pointer;
            font-size: 13px;
        }

        .btn-submit {
            background: linear-gradient(135deg, #60a5fa, #2563eb);
            border: none;
            border-radius: 8px;
            padding: 10px 24px;
            color: #fff;
            cursor: pointer;
            font-size: 13px;
        }

        .results-table {
            background: rgba(255,255,255,.04);
            border: 0.5px solid rgba(255,255,255,.08);
            border-radius: 16px;
            overflow: hidden;
        }

        .header-row {
            display: grid;
            grid-template-columns: 2fr 1fr 1fr 1fr 1fr 120px;
            gap: 0;
            background: rgba(167,139,250,.08);
            padding: 12px 16px;
            align-items: center;
            font-size: 13px;
        }

        .table-row {
            display: grid;
            grid-template-columns: 2fr 1fr 1fr 1fr 1fr 120px;
            padding: 12px 16px;
            border-top: 0.5px solid rgba(255,255,255,.06);
            align-items: center;
            font-size: 12px;
        }

        /* EMPTY STATE */
        .empty {
            padding: 40px;
            text-align: center;
            color: rgba(255,255,255,.25);
            font-size: 13px;
        }

        /* HOVER (optional nice UI touch) */
        .table-row:hover {
            background: rgba(255,255,255,.03);
        }

        .actions {
            margin-top: 16px;
        }

        @@media (max-width: 900px) {
            .form-row {
                grid-template-columns: 1fr;
            }

            .header-row {
                grid-template-columns: repeat(3, 1fr);
                gap: 10px;
            }
        }
    </style>
</head>

<body>
   
    <form asp-action="GetGlueWeighingData" method="post">

        <div class="form-card">

            <div class="form-card-header">
                Glue Weighing
            </div>


            <div class="form-body">


                <div class="form-row">


                    <div class="form-group">

                        <label>Line</label>

                        <select asp-for="LineId"
                                id="LineId"
                                asp-items="@(new SelectList(Model.Lines,"LineId","LineName"))">

                            <option value="">
                                -- Select Line --
                            </option>

                        </select>

                    </div>



                    <div class="form-group">

                        <label>Project</label>

                        <select asp-for="ProjectId"
                                id="ProjectId"
                                asp-items="@(new SelectList(Model.Projects,"ProjectId","ProjectName"))">

                            <option value="">
                                -- Select Project --
                            </option>

                        </select>

                    </div>



                    <div class="form-group">

                        <label>Model</label>

                        <select asp-for="ModelId"
                                id="ModelId"
                                asp-items="@(new SelectList(Model.ModelNos,"ModelId","Model"))">

                            <option value="">
                                -- Select Model --
                            </option>

                        </select>

                    </div>


                </div>




                <div class="form-row">


                    <div class="form-group">

                        <label>Part</label>


                        <select asp-for="PartId"
                                id="PartId"
                                asp-items="@(new SelectList(Model.PartNos,"PartId","Part"))">


                            <option value="">
                                -- Select Part --
                            </option>


                        </select>


                    </div>




                    <div class="form-group">


                        <label>Adhesive</label>


                        <select asp-for="AdhesiveId"
                                id="AdhesiveId"
                                asp-items="@(new SelectList(Model.Adhesives,"AdhesiveId","AdhesiveName"))">


                            <option value="">
                                -- Select Adhesive --
                            </option>


                        </select>


                    </div>


                    <div class="form-group">


                        <label>Line Leader</label>


                        <input asp-for="ProdLineLeader"
                               type="text"
                               placeholder="Production Line Leader" />


                    </div>


                </div>


                <div class="form-row">


                    <div class="form-group">


                        <label>Checked By</label>


                        <input asp-for="CheckedBy"
                               type="text" />


                    </div>

                    <div class="form-group">

                        <label>Approved By</label>

                        <input asp-for="ApprovedBy"
                               type="text" />


                    </div>

                    <div class="form-group"
                         style="justify-content:flex-end;">

                        <button type="submit"
                                class="btn-search">

                            Search

                        </button>


                    </div>


                </div>


            </div>


        </div>


    </form>

    <form asp-action="SaveGlueWeighing" method="post">

        <input type="hidden" asp-for="LineId" />

        <input type="hidden" asp-for="ProjectId" />

        <input type="hidden" asp-for="ModelId" />

        <input type="hidden" asp-for="PartId" />

        <input type="hidden" asp-for="ProdLineLeader" />

        <input type="hidden" asp-for="CheckedBy" />

        <input type="hidden" asp-for="ApprovedBy" />

        <div class="results-table">

            <div class="header-row">


                <div>
                    Testing Parameter
                </div>


                <div>
                    LSL
                </div>


                <div>
                    Mean Value
                </div>


                <div>
                    USL
                </div>


                <div>
                    Actual Value
                </div>


                <div>
                    Action
                </div>


            </div>

            @if (Model.dtChecklist != null &&
            Model.dtChecklist.Rows.Count > 0)
            {

                int index = 0;
                foreach (DataRow row in Model.dtChecklist.Rows)
                {
                    <div class="table-row">

                        <div>
                            @row["Adhesive"]
                        </div>

                        <div>
                            @row["LowerLimit"]
                        </div>

                        <div>
                            @row["CenterLimit"]
                        </div>

                        <div>
                            @row["UpperLimit"]
                        </div>

                        <div>

                            <input type="hidden"
                                   name="GlueWeighingResults[@index].AdhesiveId"
                                   value="@row["AdhesiveId"]" />

                            <input type="text"
                                   name="GlueWeighingResults[@index].DataValue"
                                   class="actual-input"
                                   placeholder="Enter Value" />

                            <input type="hidden"
                                   name="GlueWeighingResults[@index].RootCause"
                                   value="" />

                        </div>

                        <div>
                            <button type="button"
                                    class="btn-search">
                                Save
                            </button>
                        </div>
                    </div>
                    index++;
                }
            }
            else
            {
                <div class="empty">
                    No records found.
                </div>
            }
        </div>

        <div class="actions">
            <button type="submit"
                    class="btn-submit">
                Submit
            </button>
        </div>
    </form>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $("#ProjectId").change(function () {

            var projectId = $(this).val();

            $.ajax({
                url: "/GlueWeighing/GetModelNoByProject",
                type: "POST",
                data: { projectId: projectId },
                success:function(data){
                    $("#ModelId").empty();
                    $("#ModelId").append(
                        '<option value="">-- Select Model --</option>'
                    );
                    $.each(data,function(i,item){

                        $("#ModelId").append(
                            '<option value="'+item.modelId+'">'
                            +item.model+
                            '</option>'
                        );
                    });
                }

            });

            $.ajax({
                url:"/GlueWeighing/GetAdhesiveByProject",
                type:"POST",
                data:{projectId:projectId},
                success:function(data){
                    $("#AdhesiveId").empty();
                    $("#AdhesiveId").append(
                        '<option value="">-- Select Adhesive --</option>'
                    );

                    $.each(data,function(i,item){

                        $("#AdhesiveId").append(
                            '<option value="'+item.adhesiveId+'">'
                            +item.adhesiveName+
                            '</option>'
                        );
                    });
                }

            });
        });


        $("#ModelId").change(function(){

            var modelId=$(this).val();
            $.ajax({
                url:"/GlueWeighing/GetPartNoByModel",
                type:"POST",
                data:{modelId:modelId},
                success:function(data){
                    $("#PartId").empty();

                    $("#PartId").append(
                        '<option value="">-- Select Part --</option>'
                    );
                    $.each(data,function(i,item){
                        $("#PartId").append(

                            '<option value="'+item.partId+'">'
                            +item.part+
                            '</option>'

                        );
                    });
                }
            });
        });
    </script>
</body>
</html>