@model A246FProject.Models.DestructiveViewModel
@using Microsoft.AspNetCore.Mvc.Rendering

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Hot Bar</title>

    <link rel="stylesheet"
          href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css">

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins',sans-serif;
        }

        body {
            background: linear-gradient(135deg,#0d0d1a,#0a0a2e,#0d1b2a);
            min-height: 100vh;
            color: #e2e8f0;
            padding: 20px;
        }

        /* CARD */

        .form-card {
            background: rgba(255,255,255,.04);
            border: 1px solid rgba(255,255,255,.08);
            border-radius: 16px;
            overflow: hidden;
            margin-bottom: 20px;
        }

        .form-card-header {
            background: rgba(167,139,250,.12);
            border-bottom: 1px solid rgba(167,139,250,.2);
            padding: 14px 22px;
            font-size: 16px;
            font-weight: 600;
            color: #fff;
        }

        .form-body {
            padding: 22px;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .form-row {
            display: grid;
            grid-template-columns: repeat(3,1fr);
            gap: 14px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
        }

        label {
            font-size: 11px;
            color: #8d95c7;
            letter-spacing: .5px;
            font-weight: 500;
            margin-bottom: 8px;
        }

        input,
        select {
            background: rgba(255,255,255,.06);
            border: 1px solid rgba(255,255,255,.12);
            border-radius: 8px;
            padding: 10px 12px;
            font-size: 13px;
            color: #fff;
            outline: none;
        }

            input::placeholder {
                color: rgba(255,255,255,.35);
            }

            select option {
                background: #1a1040;
            }

            input:focus,
            select:focus {
                border-color: #a78bfa;
                background: rgba(167,139,250,.08);
            }

        /* BUTTONS */

        .btn-search {
            width: 100%;
            background: linear-gradient(135deg,#a78bfa,#7c3aed);
            border: none;
            border-radius: 8px;
            padding: 11px;
            color: #fff;
            cursor: pointer;
            font-size: 14px;
            font-weight: 500;
        }

        .btn-submit {
            background: linear-gradient(135deg,#60a5fa,#2563eb);
            border: none;
            border-radius: 8px;
            padding: 10px 24px;
            color: #fff;
            cursor: pointer;
            font-size: 13px;
        }

        .btn-save {
            background: linear-gradient(135deg,#34d399,#059669);
            border: none;
            border-radius: 6px;
            padding: 7px 14px;
            color: #fff;
            cursor: pointer;
        }

        /* TABLE */

        .results-table {
            background: rgba(255,255,255,.04);
            border: 1px solid rgba(255,255,255,.08);
            border-radius: 16px;
            overflow: hidden;
        }

        .table-scroll {
            overflow-x: auto;
            width: 100%;
        }

        .custom-table {
            width: 100%;
            min-width: 900px;
            border-collapse: collapse;
        }

            .custom-table thead {
                background: rgba(167,139,250,.08);
            }

                .custom-table thead th {
                    padding: 8px 6px;
                    text-align: left;
                    font-size: 12px;
                    font-weight: 600;
                    color: rgba(255,255,255,.75);
                    border-bottom: 1px solid rgba(255,255,255,.08);
                    white-space: nowrap;
                }

            .custom-table tbody td {
                padding: 8px 6px;
                text-align: left;
                color: #e2e8f0;
                border-top: 1px solid rgba(255,255,255,.05);
            }

                .custom-table tbody td input {
                    width: 100%;
                }

        .empty-row {
            height: 100px;
            color: rgba(255,255,255,.25);
            font-size: 13px;
        }

        .actions {
            margin-top: 16px;
        }

        @@media(max - width:900px) {
            .form-row {
                grid-template-columns: 1fr;
            }
        }

        .results-table {
            background: rgba(255,255,255,.04);
            border: 1px solid rgba(255,255,255,.08);
            border-radius: 12px;
            overflow-x: auto;
            padding: 0;
        }

        .custom-table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
        }

            .custom-table thead tr {
                background: rgba(167,139,250,.12);
            }

            .custom-table th {
                padding: 12px 10px;
                text-align: left;
                color: #fff;
                font-size: 13px;
                font-weight: 600;
                border-bottom: 1px solid rgba(255,255,255,.08);
            }

            .custom-table td {
                padding: 10px;
                color: #fff;
                font-size: 13px;
                border-bottom: 1px solid rgba(255,255,255,.06);
                vertical-align: top;
                line-height: 1.5;
            }

        .value-box {
            width: 80px;
            height: 34px;
            border: 1px solid rgba(255,255,255,.15);
            border-radius: 4px;
            background: rgba(255,255,255,.06);
            color: #fff;
            text-align: left;
        }

        .custom-table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
        }

            .custom-table td[rowspan] {
                vertical-align: top;
                padding-top: 12px;
            }

            .custom-table th:nth-child(1),
            .custom-table td:nth-child(1) {
                width: 120px;
            }

            .custom-table th:nth-child(2),
            .custom-table td:nth-child(2) {
                width: 420px;
            }

            .custom-table th:nth-child(3),
            .custom-table td:nth-child(3) {
                width: 220px;
            }

            .custom-table th:nth-child(4),
            .custom-table td:nth-child(4) {
                width: 120px;
            }

            .custom-table th:nth-child(5),
            .custom-table td:nth-child(5) {
                width: 80px;
                text-align: left;
            }

            .custom-table th:nth-child(6),
            .custom-table td:nth-child(6) {
                width: 100px;
            }

            .custom-table th:nth-child(7),
            .custom-table td:nth-child(7) {
                width: 100px;
            }
    </style>
</head>

<body>

    <div class="form-card">

        <div class="form-card-header">
            Destructive
        </div>
        <form asp-action="Index" method="post">
            <div class="form-body">

                <!-- Row 1 -->

                <div class="form-row">

                    <div class="form-group">
                        <label>Line</label>
                        <select asp-for="LineId"
                                id="LineId"
                                asp-items="@(new SelectList(Model.Lines,
                                                                "LineId",
                                                                "LineName"))">
                            <option value="">-- Select Line --</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Project</label>
                        <select asp-for="ProjectId"
                                id="ProjectId"
                                asp-items="@(new SelectList(Model.Projects,
                                                                "ProjectId",
                                                                "ProjectName"))">
                            <option value="">-- Select Project --</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Model</label>
                        <select asp-for="ModelId"
                                id="ModelId"
                                asp-items="@(new SelectList(Model.ModelNos,
                                                                "ModelId",
                                                                "Model"))">
                            <option value="">-- Select Model --</option>
                        </select>
                    </div>

                </div>

                <!-- Row 2 -->

                <div class="form-row">

                    <div class="form-group">
                        <label>Part</label>
                        <select asp-for="PartId"
                                id="PartId"
                                asp-items="@(new SelectList(Model.PartNos,
                                                                "PartId",
                                                                "Part"))">
                            <option value="">-- Select Part --</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Machine</label>
                        <select asp-for="MachineId"
                                id="MachineId"
                                asp-items="@(new SelectList(Model.Machines,
                                                                "MachineId",
                                                                "Machine"))">
                            <option value="">-- Select Machine --</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Production Line Leader</label>
                        <input asp-for="ProdLineLeader"
                               id="ProdLineLeader"
                               type="text"
                               placeholder="Production Line Leader" />
                    </div>

                </div>

                <!-- Row 3 -->

                <div class="form-row">

                    <div class="form-group">
                        <label>Checked By</label>
                        <input asp-for="CheckedBy"
                               id="CheckedBy"
                               type="text" />
                    </div>

                    <div class="form-group">
                        <label>Approved By</label>
                        <input asp-for="ApprovedBy"
                               id="ApprovedBy"
                               type="text" />
                    </div>

                    <div class="form-group">
                        <label>&nbsp;</label>
                        <button type="submit"
                                class="btn-search">
                            Search
                        </button>
                    </div>

                </div>

            </div>
        </form>
        @if (ViewBag.Message != null)
        {
            <div id="validationMessage"
                 style="
             background:#dc3545;
             color:white;
             padding:10px 15px;
             border-radius:8px;
             margin:10px 0;
             font-size:13px;
             font-weight:500;">

                @ViewBag.Message

            </div>
        }
    </div>

    <!-- TABLE -->

    <div class="results-table">

        <div class="table-scroll">

            <table class="custom-table">

                <thead>
                    <tr>
                        <th>Work Station</th>
                        <th>Inspection Project</th>
                        <th>Inspection Specifications</th>
                        <th>Frequency</th>
                        <th>section</th>
                        <th>Value1</th>
                        <th>Save</th>
                    </tr>
                </thead>

                <tbody id="body">

                    @if (Model.dtChecklist != null &&
                                        Model.dtChecklist.Rows.Count > 0)
                    {
                        @for (int i = 0; i < Model.dtChecklist.Rows.Count; i++)
                        {
                            <tr class="checklist-row">

                                <td>

                                    <input type="hidden"
                                           class="SectionId"
                                           value="@Model.dtChecklist.Rows[i]["SectionId"]" />

                                    <input type="hidden"
                                           class="StartSpec"
                                           value="@Model.dtChecklist.Rows[i]["StartSpec"]" />

                                    <input type="hidden"
                                           class="EndSpec"
                                           value="@Model.dtChecklist.Rows[i]["EndSpec"]" />

                                    @Model.dtChecklist.Rows[i]["WorkStation"]

                                </td>

                                <td>
                                    @Model.dtChecklist.Rows[i]["InspectionProject"]
                                </td>

                                <td>
                                    @Model.dtChecklist.Rows[i]["InspectionSpecifications"]
                                </td>

                                <td>
                                    @Model.dtChecklist.Rows[i]["Frequency"]
                                </td>

                                <td>
                                    @Model.dtChecklist.Rows[i]["Section"]
                                </td>

                                <td>
                                    <input type="text"
                                           class="value-box value1"
                                           data-sectionid="@Model.dtChecklist.Rows[i]["SectionId"]" />
                                </td>

                                <td>
                                    <button type="button"
                                            class="btn-search btnRowSave">
                                        Save
                                    </button>
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="empty-row">
                                No records found.
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

    <div class="actions">

        <button type="button"
                id="btnSubmit"
                class="btn-submit">
            Submit
        </button>

    </div>


    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>

        $("#ProjectId").change(function () {

            var projectId = $(this).val();

            $.ajax({
                url: '/Destructive/GetModelNoByProject',
                type: 'POST',
                data: { projectId: projectId },

                success: function (data) {

                    $("#ModelId").empty();

                    $("#ModelId").append(
                        '<option value="">-- Select Model --</option>'
                    );

                    $.each(data, function (i, item) {

                        $("#ModelId").append(
                            '<option value="' +
                            item.modelId +
                            '">' +
                            item.model +
                            '</option>'
                        );
                    });

                    $("#PartId").empty();

                    $("#PartId").append(
                        '<option value="">-- Select Part --</option>'
                    );
                }
            });

        });

        $("#ModelId").change(function () {

            var modelId = $(this).val();

            $.ajax({
                url: '/Destructive/GetPartNoByModel',
                type: 'POST',
                data: { modelId: modelId },

                success: function (data) {

                    $("#PartId").empty();

                    $("#PartId").append(
                        '<option value="">-- Select Part --</option>'
                    );

                    $.each(data, function (i, item) {

                        $("#PartId").append(
                            '<option value="' +
                            item.partId +
                            '">' +
                            item.part +
                            '</option>'
                        );
                    });
                }
            });

        });

    </script>
    <script>

                function getStartSpec(row) {

            return $.trim(
                row.find(".StartSpec").val()
            );
        }


        function getEndSpec(row) {

            return $.trim(
                row.find(".EndSpec").val()
            );
        }


        function validateValue(value, startSpec, endSpec) {

            value = $.trim(value);

            // Empty value is allowed
            if (value === "") {
                return true;
            }

            // NG is invalid
            if (value.toUpperCase() === "NG") {
                return false;
            }

            // Convert entered value to number
            let numericValue = Number(value);

            // Reject non-numeric values
            if (!Number.isFinite(numericValue)) {
                return false;
            }

            // Convert specifications
            let min = Number(startSpec);
            let max = Number(endSpec);

            let hasMin = Number.isFinite(min);
            let hasMax = Number.isFinite(max);

            // No specification
            if (!hasMin && !hasMax) {
                return true;
            }

            // Both minimum and maximum
            if (hasMin && hasMax) {

                return numericValue >= min &&
                       numericValue <= max;
            }

            // Only minimum
            if (hasMin) {

                return numericValue >= min;
            }

            // Only maximum
            if (hasMax) {

                return numericValue <= max;
            }

            return true;
        }


        function validateRow(row) {

            let startSpec = getStartSpec(row);

            let endSpec = getEndSpec(row);

            let value = $.trim(
                row.find(".value1").val()
            );

            return validateValue(
                value,
                startSpec,
                endSpec
            );
        }


        function highlightInput(input) {

            input.css({
                "background": "rgba(220,53,69,0.65)",
                "border": "2px solid #dc3545",
                "color": "#ffffff"
            });
        }


        function removeInputHighlight(input) {

            input.css({
                "background": "",
                "border": "",
                "color": ""
            });
        }

                $(document).on(
            "input change",
            ".value1",
            function () {

                let input = $(this);

                let row = input.closest("tr");

                let startSpec = getStartSpec(row);

                let endSpec = getEndSpec(row);

                let value = $.trim(input.val());


                // Empty value
                if (value === "") {

                    removeInputHighlight(input);

                    row.css(
                        "background",
                        ""
                    );

                    return;
                }


                // Validate value
                let isValid = validateValue(
                    value,
                    startSpec,
                    endSpec
                );


                if (!isValid) {

                    highlightInput(input);

                    row.css(
                        "background",
                        "rgba(220,53,69,0.20)"
                    );

                }
                else {

                    removeInputHighlight(input);

                    row.css(
                        "background",
                        ""
                    );
                }

            }
        );

                function clearRowError(row) {

            row.css("background", "");

            row.find(".value1").each(function () {

                removeInputHighlight($(this));

            });
        }


        function validateAndCollectRows() {

            let results = [];

            let hasInvalidValue = false;

            let invalidMessage = "";

            $("#body tr.checklist-row").each(function () {

                let row = $(this);

                let input = row.find(".value1");

                let value = $.trim(input.val());

                let startSpec = getStartSpec(row);

                let endSpec = getEndSpec(row);


                // Clear previous highlighting
                clearRowError(row);


                // Skip completely empty rows
                if (value === "") {
                    return true;
                }


                // NG validation
                if (value.toUpperCase() === "NG") {

                    hasInvalidValue = true;

                    invalidMessage =
                        "NG value found. Please correct all invalid values before saving.";

                    row.css(
                        "background",
                        "rgba(220,53,69,0.20)"
                    );

                    highlightInput(input);

                    return false;
                }


                // Validate based on StartSpec and EndSpec
                let isValid = validateValue(
                    value,
                    startSpec,
                    endSpec
                );


                if (!isValid) {

                    hasInvalidValue = true;

                    invalidMessage =
                        "Invalid value found based on the Inspection Specifications.";

                    row.css(
                        "background",
                        "rgba(220,53,69,0.20)"
                    );

                    highlightInput(input);

                    return false;
                }


                let sectionId =
                    row.find(".SectionId").val();


                if (sectionId) {

                    results.push({

                        sectionId:
                            parseInt(sectionId) || 0,

                        value1:
                            value,

                        inspectionResults:
                            ""
                    });
                }

            });


            return {

                isValid: !hasInvalidValue,

                results: results,

                message: invalidMessage

            };
        }

                $(document).on(
            "click",
            ".btnRowSave",
            function (e) {

                e.preventDefault();
                e.stopPropagation();

                let validationResult =
                    validateAndCollectRows();

                if (!validationResult.isValid) {

                    alert(
                        validationResult.message ||
                        "Invalid or NG value found. Nothing was saved. Please correct the highlighted value."
                    );

                    return false;
                }

                if (
                    validationResult.results.length === 0
                ) {

                    alert(
                        "Please enter at least one value before saving."
                    );

                    return false;
                }

                let data = {

                    lineId:
                        parseInt($("#LineId").val()) || 0,

                    projectId:
                        parseInt($("#ProjectId").val()) || 0,

                    modelId:
                        parseInt($("#ModelId").val()) || 0,

                    partId:
                        parseInt($("#PartId").val()) || 0,

                    machineId:
                        parseInt($("#MachineId").val()) || 0,

                    prodLineLeader:
                        $("#ProdLineLeader").val(),

                    checkedBy:
                        $("#CheckedBy").val(),

                    approvedBy:
                        $("#ApprovedBy").val(),

                    a246FMHB2CheckListResults:
                        validationResult.results
                };

                $.ajax({

                    url:
                        '/Destructive/SaveA246FMHB2CheckList',

                    type:
                        'POST',

                    contentType:
                        'application/json; charset=utf-8',

                    data:
                        JSON.stringify(data),


                    success: function (response) {

                        if (
                            response &&
                            response.success === false
                        ) {

                            alert(
                                response.message ||
                                "Error while saving."
                            );

                            return;
                        }


                        alert(
                            response.message ||
                            "All entered data saved successfully."
                        );

                        $("#body tr.checklist-row").each(function () {

                            let row = $(this);

                            let value = $.trim(
                                row.find(".value1").val()
                            );

                            if (value !== "") {

                                row.remove();

                            }

                        });

                        if (
                            $("#body tr.checklist-row").length === 0
                        ) {

                            $("#body").html(`
                                <tr>
                                    <td colspan="7"
                                        class="empty-row">
                                        No records found.
                                    </td>
                                </tr>
                            `);

                        }

                    },


                    error: function () {

                        alert(
                            "Server Error while saving."
                        );

                    }

                });


                return false;

            }
        );


                $(document).on(
            "click",
            "#btnSubmit",
            function (e) {

                e.preventDefault();

                let validationResult =
                    validateAndCollectRows();


                if (!validationResult.isValid) {

                    alert(
                        validationResult.message ||
                        "Invalid or NG value found. Nothing was submitted. Please correct the highlighted value."
                    );

                    return;
                }


                if (
                    validationResult.results.length === 0
                ) {

                    alert(
                        "Please enter at least one value before submitting."
                    );

                    return;
                }

                let data = {

                    lineId:
                        parseInt($("#LineId").val()) || 0,

                    projectId:
                        parseInt($("#ProjectId").val()) || 0,

                    modelId:
                        parseInt($("#ModelId").val()) || 0,

                    partId:
                        parseInt($("#PartId").val()) || 0,

                    machineId:
                        parseInt($("#MachineId").val()) || 0,

                    prodLineLeader:
                        $("#ProdLineLeader").val(),

                    checkedBy:
                        $("#CheckedBy").val(),

                    approvedBy:
                        $("#ApprovedBy").val(),

                    a246FMHB2CheckListResults:
                        validationResult.results
                };

                $.ajax({

                    url:
                        '/Destructive/SaveA246FMHB2CheckList',

                    type:
                        'POST',

                    contentType:
                        'application/json; charset=utf-8',

                    data:
                        JSON.stringify(data),


                    success: function (response) {

                        if (
                            response &&
                            response.success === true
                        ) {

                            alert(
                                response.message ||
                                "All data submitted successfully."
                            );

                            $(".value1").val("");

                            $("#body tr.checklist-row").each(function () {

                                clearRowError($(this));

                            });

                        }
                        else {

                            alert(
                                response.message ||
                                "Save failed."
                            );

                        }

                    },


                    error: function () {

                        alert(
                            "Server Error while saving."
                        );

                    }

                });

            }
        );
    </script>
</body>
</html>
