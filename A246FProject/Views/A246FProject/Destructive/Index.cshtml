@model A246FProject.Models.DestructiveViewModel
@using Microsoft.AspNetCore.Mvc.Rendering

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Hot Bar</title>

    <link rel="stylesheet"
          href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css">

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins',sans-serif;
        }

        body {
            background: linear-gradient(135deg,#0d0d1a,#0a0a2e,#0d1b2a);
            min-height: 100vh;
            color: #e2e8f0;
            padding: 20px;
        }

        /* CARD */

        .form-card {
            background: rgba(255,255,255,.04);
            border: 1px solid rgba(255,255,255,.08);
            border-radius: 16px;
            overflow: hidden;
            margin-bottom: 20px;
        }

        .form-card-header {
            background: rgba(167,139,250,.12);
            border-bottom: 1px solid rgba(167,139,250,.2);
            padding: 14px 22px;
            font-size: 16px;
            font-weight: 600;
            color: #fff;
        }

        .form-body {
            padding: 22px;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .form-row {
            display: grid;
            grid-template-columns: repeat(3,1fr);
            gap: 14px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
        }

        label {
            font-size: 11px;
            color: #8d95c7;
            letter-spacing: .5px;
            font-weight: 500;
            margin-bottom: 8px;
        }

        input,
        select {
            background: rgba(255,255,255,.06);
            border: 1px solid rgba(255,255,255,.12);
            border-radius: 8px;
            padding: 10px 12px;
            font-size: 13px;
            color: #fff;
            outline: none;
        }

            input::placeholder {
                color: rgba(255,255,255,.35);
            }

            select option {
                background: #1a1040;
            }

            input:focus,
            select:focus {
                border-color: #a78bfa;
                background: rgba(167,139,250,.08);
            }

        /* BUTTONS */

        .btn-search {
            width: 100%;
            background: linear-gradient(135deg,#a78bfa,#7c3aed);
            border: none;
            border-radius: 8px;
            padding: 11px;
            color: #fff;
            cursor: pointer;
            font-size: 14px;
            font-weight: 500;
        }

        .btn-submit {
            background: linear-gradient(135deg,#60a5fa,#2563eb);
            border: none;
            border-radius: 8px;
            padding: 10px 24px;
            color: #fff;
            cursor: pointer;
            font-size: 13px;
        }

        .btn-save {
            background: linear-gradient(135deg,#34d399,#059669);
            border: none;
            border-radius: 6px;
            padding: 7px 14px;
            color: #fff;
            cursor: pointer;
        }

        /* TABLE */

        .results-table {
            background: rgba(255,255,255,.04);
            border: 1px solid rgba(255,255,255,.08);
            border-radius: 16px;
            overflow: hidden;
        }

        .table-scroll {
            overflow-x: auto;
            width: 100%;
        }

        .custom-table {
            width: 100%;
            min-width: 900px;
            border-collapse: collapse;
        }

            .custom-table thead {
                background: rgba(167,139,250,.08);
            }

                .custom-table thead th {
                    padding: 8px 6px;
                    text-align: left;
                    font-size: 12px;
                    font-weight: 600;
                    color: rgba(255,255,255,.75);
                    border-bottom: 1px solid rgba(255,255,255,.08);
                    white-space: nowrap;
                }

            .custom-table tbody td {
                padding: 8px 6px;
                text-align: left;
                color: #e2e8f0;
                border-top: 1px solid rgba(255,255,255,.05);
            }

                .custom-table tbody td input {
                    width: 100%;
                }

        .empty-row {
            height: 100px;
            color: rgba(255,255,255,.25);
            font-size: 13px;
        }

        .actions {
            margin-top: 16px;
        }

        @@media(max - width:900px) {
            .form-row {
                grid-template-columns: 1fr;
            }
        }

        .results-table {
            background: rgba(255,255,255,.04);
            border: 1px solid rgba(255,255,255,.08);
            border-radius: 12px;
            overflow-x: auto;
            padding: 0;
        }

        .custom-table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
        }

            .custom-table thead tr {
                background: rgba(167,139,250,.12);
            }

            .custom-table th {
                padding: 12px 10px;
                text-align: left;
                color: #fff;
                font-size: 13px;
                font-weight: 600;
                border-bottom: 1px solid rgba(255,255,255,.08);
            }

            .custom-table td {
                padding: 10px;
                color: #fff;
                font-size: 13px;
                border-bottom: 1px solid rgba(255,255,255,.06);
                vertical-align: top;
                line-height: 1.5;
            }

        .value-box {
            width: 80px;
            height: 34px;
            border: 1px solid rgba(255,255,255,.15);
            border-radius: 4px;
            background: rgba(255,255,255,.06);
            color: #fff;
            text-align: left;
        }

        .custom-table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
        }

            .custom-table td[rowspan] {
                vertical-align: top;
                padding-top: 12px;
            }

            .custom-table th:nth-child(1),
            .custom-table td:nth-child(1) {
                width: 120px;
            }

            .custom-table th:nth-child(2),
            .custom-table td:nth-child(2) {
                width: 420px;
            }

            .custom-table th:nth-child(3),
            .custom-table td:nth-child(3) {
                width: 220px;
            }

            .custom-table th:nth-child(4),
            .custom-table td:nth-child(4) {
                width: 120px;
            }

            .custom-table th:nth-child(5),
            .custom-table td:nth-child(5) {
                width: 80px;
                text-align: left;
            }

            .custom-table th:nth-child(6),
            .custom-table td:nth-child(6) {
                width: 100px;
            }

            .custom-table th:nth-child(7),
            .custom-table td:nth-child(7) {
                width: 100px;
            }
    </style>
</head>

<body>

    <div class="form-card">

        <div class="form-card-header">
            Destructive
        </div>
        <form asp-action="Index" method="post">
            <div class="form-body">

                <!-- Row 1 -->

                <div class="form-row">

                    <div class="form-group">
                        <label>Line</label>
                        <select asp-for="LineId"
                                id="LineId"
                                asp-items="@(new SelectList(Model.Lines,
                                "LineId",
                                "LineName"))">
                            <option value="">-- Select Line --</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Project</label>
                        <select asp-for="ProjectId"
                                id="ProjectId"
                                asp-items="@(new SelectList(Model.Projects,
                                "ProjectId",
                                "ProjectName"))">
                            <option value="">-- Select Project --</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Model</label>
                        <select asp-for="ModelId"
                                id="ModelId"
                                asp-items="@(new SelectList(Model.ModelNos,
                                "ModelId",
                                "Model"))">
                            <option value="">-- Select Model --</option>
                        </select>
                    </div>

                </div>

                <!-- Row 2 -->

                <div class="form-row">

                    <div class="form-group">
                        <label>Part</label>
                        <select asp-for="PartId"
                                id="PartId"
                                asp-items="@(new SelectList(Model.PartNos,
                                "PartId",
                                "Part"))">
                            <option value="">-- Select Part --</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Machine</label>
                        <select asp-for="MachineId"
                                id="MachineId"
                                asp-items="@(new SelectList(Model.Machines,
                                "MachineId",
                                "Machine"))">
                            <option value="">-- Select Machine --</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Production Line Leader</label>
                        <input asp-for="ProdLineLeader"
                               id="ProdLineLeader"
                               type="text"
                               placeholder="Production Line Leader" />
                    </div>

                </div>

                <!-- Row 3 -->

                <div class="form-row">

                    <div class="form-group">
                        <label>Checked By</label>
                        <input asp-for="CheckedBy"
                               id="CheckedBy"
                               type="text" />
                    </div>

                    <div class="form-group">
                        <label>Approved By</label>
                        <input asp-for="ApprovedBy"
                               id="ApprovedBy"
                               type="text" />
                    </div>

                    <div class="form-group">
                        <label>&nbsp;</label>
                        <button type="submit"
                                class="btn-search">
                            Search
                        </button>
                    </div>

                </div>

            </div>
        </form>
    </div>

    <!-- TABLE -->

    <div class="results-table">

        <div class="table-scroll">

            <table class="custom-table">

                <thead>
                    <tr>
                        <th>Work Station</th>
                        <th>Inspection Project</th>
                        <th>Inspection Specifications</th>
                        <th>Frequency</th>
                        <th>section</th>
                        <th>Value1</th>
                        <th>Save</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.dtChecklist != null &&
                    Model.dtChecklist.Rows.Count > 0)
                    {
                        @for (int i = 0; i < Model.dtChecklist.Rows.Count; i++)
                        {
                            <tr>

                                <td>
                                    <input type="hidden"
                                           class="SectionId"
                                           value="@Model.dtChecklist.Rows[i]["SectionId"]" />

                                    @Model.dtChecklist.Rows[i]["WorkStation"]
                                </td>

                                <td>
                                    @Model.dtChecklist.Rows[i]["InspectionProject"]
                                </td>

                                <td>
                                    @Model.dtChecklist.Rows[i]["InspectionSpecifications"]
                                </td>

                                <td>
                                    @Model.dtChecklist.Rows[i]["Frequency"]
                                </td>

                                <td>
                                    @Model.dtChecklist.Rows[i]["Section"]
                                </td>

                                <td>
                                    <input type="text"
                                           class="value-box value1"
                                           data-sectionid="@Model.dtChecklist.Rows[i]["SectionId"]" />
                                </td>

                                <td>
                                    <button type="button"
                                            class="btn-search btnRowSave">
                                        Save
                                    </button>
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="empty-row">
                                No records found.
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

    <div class="actions">

        <button type="button"
                id="btnSubmit"
                class="btn-submit">
            Submit
        </button>

    </div>


    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>

        $("#ProjectId").change(function () {

            var projectId = $(this).val();

            $.ajax({
                url: '/Destructive/GetModelNoByProject',
                type: 'POST',
                data: { projectId: projectId },

                success: function (data) {

                    $("#ModelId").empty();

                    $("#ModelId").append(
                        '<option value="">-- Select Model --</option>'
                    );

                    $.each(data, function (i, item) {

                        $("#ModelId").append(
                            '<option value="' +
                            item.modelId +
                            '">' +
                            item.model +
                            '</option>'
                        );
                    });

                    $("#PartId").empty();

                    $("#PartId").append(
                        '<option value="">-- Select Part --</option>'
                    );
                }
            });

        });

        $("#ModelId").change(function () {

            var modelId = $(this).val();

            $.ajax({
                url: '/Destructive/GetPartNoByModel',
                type: 'POST',
                data: { modelId: modelId },

                success: function (data) {

                    $("#PartId").empty();

                    $("#PartId").append(
                        '<option value="">-- Select Part --</option>'
                    );

                    $.each(data, function (i, item) {

                        $("#PartId").append(
                            '<option value="' +
                            item.partId +
                            '">' +
                            item.part +
                            '</option>'
                        );
                    });
                }
            });

        });

    </script>
    <script>
                $(document).on("click", ".btnRowSave", function () {

            var row = $(this).closest("tr");

            var data = {
                lineId: $("#LineId").val(),
                projectId: $("#ProjectId").val(),
                modelId: $("#ModelId").val(),
                partId: $("#PartId").val(),
                machineId: $("#MachineId").val(),

                prodLineLeader: $("#ProdLineLeader").val(),
                checkedBy: $("#CheckedBy").val(),
                approvedBy: $("#ApprovedBy").val(),

                a246FMHB2CheckListResults: [
                    {
                        sectionId: parseInt(row.find(".SectionId").val()),
                        value1: row.find(".value1").val() || 0,
                        inspectionResults: ""
                    }
                ]
            };

            $.ajax({
                url: '/Destructive/SaveA246FMHB2CheckList',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(data),

                success: function (response) {
                    if (response > 0) {
                        alert("✔ Row inserted successfully!");
                    } else {
                        alert("❌ Row insert failed!");
                    }
                },

                error: function () {
                    alert("⚠ Error while saving row!");
                }
            });
        });

                        $("#btnSubmit").click(function () {

            var results = [];

            $("tbody tr").each(function () {

                results.push({
                    sectionId: $(this).find(".SectionId").val(),
                    value1: $(this).find(".value1").val() || 0,
                    inspectionResults: ""
                });

            });

            var data = {
                lineId: $("#LineId").val(),
                projectId: $("#ProjectId").val(),
                modelId: $("#ModelId").val(),
                partId: $("#PartId").val(),
                machineId: $("#MachineId").val(),

                prodLineLeader: $("#ProdLineLeader").val(),
                checkedBy: $("#CheckedBy").val(),
                approvedBy: $("#ApprovedBy").val(),

                a246FMHB2CheckListResults: results
            };

            $.ajax({
                url: '/Destructive/SaveA246FMHB2CheckList',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(data),

                success: function (response) {

                    if (response > 0) {
                        alert("✔ Rows inserted successfully!");
                        location.reload();
                    } else {
                        alert("❌ Submit failed!");
                    }
                },

                error: function () {
                    alert("⚠ Error while submitting data!");
                }
            });

        });
    </script>
</body>
</html>
