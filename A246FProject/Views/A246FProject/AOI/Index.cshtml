@model A246FProject.Models.AOIViewModel


<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>AOI</title>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins',sans-serif;
        }

        body {
            background: linear-gradient(135deg,#0d0d1a,#0a0a2e,#0d1b2a);
            min-height: 100vh;
            padding: 20px;
            color: #fff;
        }

        .form-card {
            background: rgba(255,255,255,.04);
            border: 1px solid rgba(255,255,255,.08);
            border-radius: 14px;
            overflow: hidden;
            margin-bottom: 20px;
        }

        .form-card-header {
            padding: 14px 20px;
            background: rgba(167,139,250,.15);
            font-size: 16px;
            font-weight: 600;
            color: #fff;
        }

        .form-body {
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .form-row {
            display: grid;
            grid-template-columns: repeat(3,1fr);
            gap: 16px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
        }

        label {
            margin-bottom: 6px;
            font-size: 11px;
            font-weight: 500;
            color: rgba(255,255,255,.60);
            letter-spacing: .5px;
        }

        input,
        select {
            width: 100%;
            height: 42px;
            padding: 0 12px;
            background: rgba(255,255,255,.06);
            border: 1px solid rgba(255,255,255,.12);
            border-radius: 8px;
            color: #fff;
            font-size: 13px;
            outline: none;
        }

            input::placeholder {
                color: rgba(255,255,255,.35);
            }

            select option {
                background: #1a1040;
            }

            input:focus,
            select:focus {
                border-color: #a78bfa;
                background: rgba(167,139,250,.08);
            }

        .btn-search {
            width: 100%;
            height: 42px;
            border: none;
            border-radius: 8px;
            background: linear-gradient(135deg,#a78bfa,#7c3aed);
            color: #fff;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
        }

 
        .btn-submit {
            width: 120px;
            height: 42px;
            border: none;
            border-radius: 8px;
            background: linear-gradient(135deg,#60a5fa,#2563eb);
            color: #fff;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
        }

        .actions {
            margin-top: 18px;
        }

        .results-table {
            background: rgba(255,255,255,.04);
            border: 1px solid rgba(255,255,255,.08);
            border-radius: 14px;
            overflow: hidden;
        }

        .table-scroll {
            overflow-x: auto;
            width: 100%;
        }

        .custom-table {
            width: 100%;
            min-width: 1200px;
            border-collapse: collapse;
            table-layout: fixed;
        }

            .custom-table thead {
                background: rgba(167,139,250,.15);
            }

                .custom-table thead th {
                    padding: 12px 8px;
                    text-align: left;
                    font-size: 13px;
                    font-weight: 600;
                    color: #fff;
                    border-bottom: 1px solid rgba(255,255,255,.08);
                }

            .custom-table tbody td {
                padding: 8px;
                text-align: left;
                vertical-align: middle;
                border-top: 1px solid rgba(255,255,255,.05);
                font-size: 13px;
            }

            .custom-table th:nth-child(1),
            .custom-table td:nth-child(1) {
                width: 120px;
            }

            .custom-table th:nth-child(2),
            .custom-table td:nth-child(2) {
                width: 220px;
            }

            .custom-table th:nth-child(3),
            .custom-table td:nth-child(3) {
                width: 120px;
            }

            .custom-table th:nth-child(4),
            .custom-table td:nth-child(4) {
                width: 90px;
            }

            .custom-table th:nth-child(5),
            .custom-table td:nth-child(5) {
                width: 110px;
            }

            .custom-table th:nth-child(6),
            .custom-table td:nth-child(6),
            .custom-table th:nth-child(7),
            .custom-table td:nth-child(7),
            .custom-table th:nth-child(8),
            .custom-table td:nth-child(8),
            .custom-table th:nth-child(9),
            .custom-table td:nth-child(9),
            .custom-table th:nth-child(10),
            .custom-table td:nth-child(10) {
                width: 90px;
            }

            .custom-table th:nth-child(11),
            .custom-table td:nth-child(11) {
                width: 90px;
            }

            .custom-table td:nth-child(2),
            .custom-table td:nth-child(3) {
                white-space: normal;
                word-break: break-word;
                overflow-wrap: break-word;
                line-height: 18px;
                text-align: left;
            }

            .custom-table tbody td input[type=text] {
                width: 80px;
                height: 34px;
                padding: 4px;
                border-radius: 6px;
                font-size: 13px;
                text-align: left;
            }

        .empty-row {
            height: 90px;
            font-size: 14px;
            color: rgba(255,255,255,.35);
            text-align: left;
        }

        .table-scroll::-webkit-scrollbar {
            height: 8px;
        }

        .table-scroll::-webkit-scrollbar-thumb {
            background: #7c3aed;
            border-radius: 20px;
        }

        .table-scroll::-webkit-scrollbar-track {
            background: #1b1b2d;
        }

        @@media(max - width:900px) {
            .form-row

            {
                grid-template-columns: 1fr;
            }

            .custom-table {
                min-width: 1600px;
            }

        }
        
        .ng-row {
            background: rgba(220, 53, 69, 0.20) !important;
            border-left: 4px solid #dc3545 !important;
        }

            .ng-row td {
                background: rgba(220, 53, 69, 0.08) !important;
                color: #ff8080 !important;
            }

        .ng-input {
            border: 2px solid #dc3545 !important;
            background: rgba(220, 53, 69, 0.18) !important;
            color: #ff8080 !important;
        }
 </style>

</head>

<body>

    <form asp-action="Index" method="post">

        <div class="form-card">

            <div class="form-card-header">
                AOI Checklist
            </div>

            <div class="form-body">

                <div class="form-row">

                    <div class="form-group">
                        <label>Line</label>
                        <select asp-for="LineId"
                                id="LineId"
                                asp-items="@(new SelectList(Model.Lines,
                                    "LineId",
                                    "LineName"))">
                            <option value="">-- Select Line --</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Project</label>
                        <select asp-for="ProjectId"
                                id="ProjectId"
                                asp-items="@(new SelectList(Model.Projects,
                                    "ProjectId",
                                    "ProjectName"))">
                            <option value="">-- Select Project --</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Model</label>
                        <select asp-for="ModelId"
                                id="ModelId"
                                asp-items="@(new SelectList(Model.ModelNos,
                                    "ModelId",
                                    "Model"))">
                            <option value="">-- Select Model --</option>
                        </select>
                    </div>

                </div>

                <div class="form-row">

                    <div class="form-group">
                        <label>Part</label>
                        <select asp-for="PartId"
                                id="PartId"
                                asp-items="@(new SelectList(Model.PartNos,
                                    "PartId",
                                    "Part"))">
                            <option value="">-- Select Part --</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Machine</label>
                        <select asp-for="MachineId"
                                id="MachineId"
                                asp-items="@(new SelectList(Model.Machines,
                                    "MachineId",
                                    "Machine"))">
                            <option value="">-- Select Machine --</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Production Line Leader</label>
                        <input asp-for="ProdLineLeader" id="ProdLineLeader" />
                    </div>

                </div>

                <div class="form-row">

                    <div class="form-group">
                        <label>Checked By</label>
                        <input asp-for="CheckedBy" id="CheckedBy" />
                    </div>

                    <div class="form-group">
                        <label>Approved By</label>
                        <input asp-for="ApprovedBy" id="ApprovedBy" />
                    </div>

                    <div class="form-group"
                         style="justify-content:flex-end;">

                        <label style="visibility:hidden;">
                            Search
                        </label>

                        <button type="submit"
                                class="btn-search">
                            Search
                        </button>

                    </div>

                </div>

            </div>

        </div>

    </form>

    @if (ViewBag.Message != null)
    {
        <div id="validationMessage"
             style="
         background:#dc3545;
         color:white;
         padding:10px 15px;
         border-radius:8px;
         margin:10px 0;
         font-size:13px;
         font-weight:500;">

            @ViewBag.Message

        </div>
    }

    <div class="results-table">

        <div class="table-scroll">

            <table class="custom-table">

                <thead>
                    <tr>
                        <th>Work Station</th>
                        <th>Inspection Project</th>
                        <th>Inspection Specifications</th>
                        <th>Frequency</th>
                        <th>section</th>
                        <th>Value1</th>
                        <th>Value2</th>
                        <th>Value3</th>
                        <th>Value4</th>
                        <th>Value5</th>
                        <th>Save</th>
                    </tr>
                </thead>

                <tbody id="body">

                    @if (Model.dtChecklist != null && Model.dtChecklist.Rows.Count > 0)
                    {
                        foreach (System.Data.DataRow row in Model.dtChecklist.Rows)
                        {
                            <tr class="row">

                                <td>@row["WorkStation"]</td>
                                <td>@row["InspectionProject"]</td>
                                <td>@row["InspectionSpecifications"]</td>
                                <td>@row["Frequency"]</td>
                                <td>
                                    @row["Section"]

                                    <input type="hidden"
                                           class="SectionId"
                                           value="@row["SectionId"]" />

                                    <input type="hidden"
                                           class="StartSpec"
                                           value="@row["StartSpec"]" />

                                    <input type="hidden"
                                           class="EndSpec"
                                           value="@row["EndSpec"]" />
                                </td>

                                <td>
                                    
                                    <input type="text" class="Value1" />
                                </td>

                                <td><input type="text" class="Value2" /></td>
                                <td><input type="text" class="Value3" /></td>
                                <td><input type="text" class="Value4" /></td>
                                <td><input type="text" class="Value5" /></td>

                                <td>
                                    <button type="button"
                                            class="btn-search btnRowSave">
                                        Save
                                    </button>
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="11">
                                No Records Found
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

    <div class="actions">
        <button type="button" class="btn-submit">
            Submit
        </button>
    </div>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>
        $("#ProjectId").change(function () {

            var projectId = $(this).val();

            $.ajax({
                url: '@Url.Action("GetModelNoByProject","AOI")',
                type: 'POST',
                data: { projectId: projectId },

                success: function (data) {

                    $("#ModelId").empty();

                    $("#ModelId").append(
                        '<option value="">-- Select Model --</option>'
                    );

                    $.each(data, function (i, item) {

                        $("#ModelId").append(
                            '<option value="' +
                            item.modelId +
                            '">' +
                            item.model +
                            '</option>'
                        );
                    });
                }
            });
        });

        $("#ModelId").change(function () {

            var modelId = $(this).val();

            $.ajax({
                url: '@Url.Action("GetPartNoByModel","AOI")',
                type: 'POST',
                data: { modelId: modelId },

                success: function (data) {

                    $("#PartId").empty();

                    $("#PartId").append(
                        '<option value="">-- Select Part --</option>'
                    );

                    $.each(data, function (i, item) {

                        $("#PartId").append(
                            '<option value="' +
                            item.partId +
                            '">' +
                            item.part +
                            '</option>'
                        );
                    });
                }
            });
        });
    </script>

    <script>

                function validateAOIValue(value, startSpec, endSpec) {

            value = $.trim(value);

            // Empty value is allowed
            if (value === "") {

                return {
                    valid: true,
                    message: ""
                };

            }

            // NG is not allowed
            if (value.toUpperCase() === "NG") {

                return {
                    valid: false,
                    message: "NG value is not allowed"
                };

            }

            // Convert entered value to number
            var numericValue = Number(value);

            if (isNaN(numericValue)) {

                return {
                    valid: false,
                    message: "Please enter a valid numeric value"
                };

            }

            // Convert StartSpec to number
            var minValue = Number(startSpec);

            if (isNaN(minValue)) {

                return {
                    valid: false,
                    message: "Invalid Start Specification"
                };

            }

            // Convert EndSpec to number
            var maxValue = Number(endSpec);

            if (isNaN(maxValue)) {

                return {
                    valid: false,
                    message: "Invalid End Specification"
                };

            }

            // Check specification range
            if (
                numericValue < minValue ||
                numericValue > maxValue
            ) {

                return {
                    valid: false,
                    message:
                        "Value must be between " +
                        minValue +
                        " and " +
                        maxValue
                };

            }

            return {
                valid: true,
                message: ""
            };

        }


                function validateAOIRow(row) {

            var startSpec = $.trim(
                row.find(".StartSpec").val()
            );

            var endSpec = $.trim(
                row.find(".EndSpec").val()
            );

            var values = [

                {
                    name: "Value1",
                    input: row.find(".Value1")
                },

                {
                    name: "Value2",
                    input: row.find(".Value2")
                },

                {
                    name: "Value3",
                    input: row.find(".Value3")
                },

                {
                    name: "Value4",
                    input: row.find(".Value4")
                },

                {
                    name: "Value5",
                    input: row.find(".Value5")
                }

            ];

            var invalidValues = [];

            // Remove previous NG styles
            row.removeClass("ng-row");

            row.find(
                ".Value1, .Value2, .Value3, .Value4, .Value5"
            ).removeClass("ng-input");


            values.forEach(function (item) {

                var inputValue = $.trim(
                    item.input.val()
                );

                if (inputValue !== "") {

                    var result = validateAOIValue(

                        inputValue,

                        startSpec,

                        endSpec

                    );


                    if (!result.valid) {

                        invalidValues.push(

                            item.name +
                            " = " +
                            inputValue +
                            " (" +
                            result.message +
                            ")"

                        );

                        item.input.addClass("ng-input");

                    }

                }

            });


            // Invalid values found
            if (invalidValues.length > 0) {

                row.addClass("ng-row");

                return {

                    valid: false,

                    message:
                        invalidValues.join("\n")

                };

            }


            return {

                valid: true,

                message: ""

            };

        }


        // Validate immediately when user enters a value
        $(document).on(

            "input change",

            ".Value1, .Value2, .Value3, .Value4, .Value5",

            function () {

                var row = $(this).closest("tr.row");

                validateAOIRow(row);

            }

        );

    </script>
    
    <script>

        $(document).on("click", ".btnRowSave", function () {

            let clickedRow = $(this).closest("tr.row");

            let rowsToSave = [];

            let validationErrors = [];


            // Read from first row up to clicked row
            $("#body tr.row").each(function () {

                let row = $(this);

                let sectionId =
                    row.find(".SectionId").val();


                let value1 =
                    $.trim(row.find(".Value1").val());

                let value2 =
                    $.trim(row.find(".Value2").val());

                let value3 =
                    $.trim(row.find(".Value3").val());

                let value4 =
                    $.trim(row.find(".Value4").val());

                let value5 =
                    $.trim(row.find(".Value5").val());


                let hasValue =

                    value1 !== "" ||
                    value2 !== "" ||
                    value3 !== "" ||
                    value4 !== "" ||
                    value5 !== "";


                // Validate only rows having values
                if (hasValue) {

                    let validationResult =
                        validateAOIRow(row);


                    if (!validationResult.valid) {

                        let sectionName =

                            row.find("td:eq(4)")
                                .text()
                                .trim();


                        validationErrors.push(

                            "Section: " +
                            sectionName +
                            "\n" +
                            validationResult.message

                        );

                    }

                }


                // Add only rows having values
                if (sectionId && hasValue) {

                    rowsToSave.push({

                        SectionId:
                            parseInt(sectionId) || 0,


                        Value1:
                            value1 === ""
                                ? null
                                : value1,


                        Value2:
                            value2 === ""
                                ? null
                                : value2,


                        Value3:
                            value3 === ""
                                ? null
                                : value3,


                        Value4:
                            value4 === ""
                                ? null
                                : value4,


                        Value5:
                            value5 === ""
                                ? null
                                : value5,


                        InspectionResults: "",


                        // Used only in JavaScript
                        _htmlRow: row

                    });

                }


                // Stop at clicked Save row
                if (row[0] === clickedRow[0]) {

                    return false;

                }

            });


            // Stop save if NG / invalid values exist
            if (validationErrors.length > 0) {

                alert(

                    "❌ Cannot save because invalid / NG values were found.\n\n" +

                    validationErrors.join("\n\n")

                );

                return;

            }


            if (rowsToSave.length === 0) {

                alert(
                    "Please enter at least one value before saving."
                );

                return;

            }


            // Remove _htmlRow before sending to Controller
            let resultList = rowsToSave.map(function (x) {

                return {

                    SectionId:
                        x.SectionId,

                    Value1:
                        x.Value1,

                    Value2:
                        x.Value2,

                    Value3:
                        x.Value3,

                    Value4:
                        x.Value4,

                    Value5:
                        x.Value5,

                    InspectionResults:
                        x.InspectionResults

                };

            });


            let model = {

                LineId:
                    parseInt($("#LineId").val()) || 0,

                ProjectId:
                    parseInt($("#ProjectId").val()) || 0,

                ModelId:
                    parseInt($("#ModelId").val()) || 0,

                PartId:
                    parseInt($("#PartId").val()) || 0,

                MachineId:
                    parseInt($("#MachineId").val()) || 0,

                ProdLineLeader:
                    $("#ProdLineLeader").val(),

                CheckedBy:
                    $("#CheckedBy").val(),

                ApprovedBy:
                    $("#ApprovedBy").val(),

                AOIResults:
                    resultList

            };


            $.ajax({

                url: '@Url.Action("Save", "AOI")',

                type: 'POST',

                contentType:
                    'application/json; charset=utf-8',

                data:
                    JSON.stringify(model),


                success: function (response) {

                    if (
                        response &&
                        response.success === false
                    ) {

                        alert(
                            response.message ||
                            "Save Failed"
                        );

                        return;

                    }


                    alert(
                        response.message ||
                        "Data Saved Successfully"
                    );


                    // Remove only saved rows
                    rowsToSave.forEach(function (x) {

                        x._htmlRow.remove();

                    });


                    // If all rows are saved
                    if (
                        $("#body tr.row").length === 0
                    ) {

                        $("#body").html(`

                            <tr>

                                <td colspan="11"
                                    class="empty-row">

                                    No Records Found

                                </td>

                            </tr>

                        `);

                    }

                },


                error: function () {

                    alert(
                        "Server Error while saving."
                    );

                }

            });

        });

    </script>

    <script>

        $(document).on(

            "click",

            ".btn-submit",

            function (e) {

                e.preventDefault();


                var results = [];

                var validationErrors = [];


                $("#body tr.row").each(function () {

                    var row = $(this);


                    var value1 =
                        $.trim(row.find(".Value1").val());

                    var value2 =
                        $.trim(row.find(".Value2").val());

                    var value3 =
                        $.trim(row.find(".Value3").val());

                    var value4 =
                        $.trim(row.find(".Value4").val());

                    var value5 =
                        $.trim(row.find(".Value5").val());


                    var hasValue =

                        value1 !== "" ||
                        value2 !== "" ||
                        value3 !== "" ||
                        value4 !== "" ||
                        value5 !== "";


                    // Skip completely empty rows
                    if (!hasValue) {

                        return;

                    }


                    // Validate row
                    var validationResult =
                        validateAOIRow(row);


                    if (!validationResult.valid) {

                        var sectionName =

                            row.find("td:eq(4)")
                                .text()
                                .trim();


                        validationErrors.push(

                            "Section: " +
                            sectionName +
                            "\n" +
                            validationResult.message

                        );


                        return;

                    }


                    results.push({

                        SectionId:

                            parseInt(
                                row.find(".SectionId").val()
                            ) || 0,


                        Value1:

                            value1 === ""
                                ? null
                                : value1,


                        Value2:

                            value2 === ""
                                ? null
                                : value2,


                        Value3:

                            value3 === ""
                                ? null
                                : value3,


                        Value4:

                            value4 === ""
                                ? null
                                : value4,


                        Value5:

                            value5 === ""
                                ? null
                                : value5,


                        InspectionResults:
                            ""

                    });

                });


                // Stop Submit when invalid / NG values exist
                if (validationErrors.length > 0) {

                    alert(

                        "❌ Cannot submit because invalid / NG values were found.\n\n" +

                        validationErrors.join("\n\n")

                    );

                    return;

                }


                if (results.length === 0) {

                    alert(
                        "Please enter at least one value before submitting."
                    );

                    return;

                }


                var model = {

                    LineId:
                        parseInt($("#LineId").val()) || 0,

                    ProjectId:
                        parseInt($("#ProjectId").val()) || 0,

                    ModelId:
                        parseInt($("#ModelId").val()) || 0,

                    PartId:
                        parseInt($("#PartId").val()) || 0,

                    MachineId:
                        parseInt($("#MachineId").val()) || 0,


                    ProdLineLeader:
                        $("#ProdLineLeader").val(),

                    CheckedBy:
                        $("#CheckedBy").val(),

                    ApprovedBy:
                        $("#ApprovedBy").val(),


                    AOIResults:
                        results

                };


                $.ajax({

                    url:
                        '@Url.Action("Save", "AOI")',

                    type:
                        'POST',

                    contentType:
                        'application/json; charset=utf-8',

                    data:
                        JSON.stringify(model),


                    success: function (response) {

                        if (
                            response &&
                            response.success === false
                        ) {

                            alert(
                                response.message ||
                                "Save Failed"
                            );

                            return;

                        }


                        alert(
                            "All Records Saved Successfully"
                        );


                        // Clear inputs
                        $(".Value1").val("");

                        $(".Value2").val("");

                        $(".Value3").val("");

                        $(".Value4").val("");

                        $(".Value5").val("");


                        // Remove NG styles
                        $(".row")
                            .removeClass("ng-row");


                        $(".Value1, .Value2, .Value3, .Value4, .Value5")
                            .removeClass("ng-input");

                    },


                    error: function () {

                        alert(
                            "Save Failed"
                        );

                    }

                });

            }

        );

    </script>
