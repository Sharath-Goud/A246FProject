@model A246FProject.Models.LaserEngravingViewModel
@using Microsoft.AspNetCore.Mvc.Rendering
@using System.Data
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Laser Engraving</title>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        body {
            background: linear-gradient(135deg,#0d0d1a,#0a0a2e,#0d1b2a);
            min-height: 100vh;
            color: #e2e8f0;
            padding: 20px;
        }

        .form-card {
            background: rgba(255,255,255,.04);
            border: 1px solid rgba(255,255,255,.08);
            border-radius: 16px;
            overflow: hidden;
            margin-bottom: 20px;
        }

        .form-card-header {
            background: rgba(167,139,250,.12);
            border-bottom: 1px solid rgba(167,139,250,.2);
            padding: 14px 22px;
            font-size: 18px;
            font-weight: 600;
            color: #fff;
        }

        .form-body {
            padding: 22px;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .form-row {
            display: grid;
            grid-template-columns: repeat(3,1fr);
            gap: 16px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
        }

        label {
            font-size: 11px;
            color: #8d95c7;
            letter-spacing: .5px;
            font-weight: 500;
            margin-bottom: 8px;
        }

        input,
        select {
            height: 44px;
            background: rgba(255,255,255,.06);
            border: 1px solid rgba(255,255,255,.12);
            border-radius: 8px;
            padding: 0 14px;
            font-size: 13px;
            color: #fff;
            outline: none;
        }

            input::placeholder {
                color: rgba(255,255,255,.35);
            }

            select option {
                background: #1a1040;
            }

            input:focus,
            select:focus {
                border-color: #a78bfa;
                background: rgba(167,139,250,.08);
            }

        /* BUTTONS */

        .btn-search {
            width: 100%;
            height: 44px;
            background: linear-gradient(135deg,#a78bfa,#7c3aed);
            border: none;
            border-radius: 8px;
            color: #fff;
            cursor: pointer;
            font-size: 14px;
            font-weight: 500;
        }

        .btn-submit {
            background: linear-gradient(135deg,#60a5fa,#2563eb);
            border: none;
            border-radius: 8px;
            padding: 10px 24px;
            color: #fff;
            cursor: pointer;
            font-size: 13px;
        }


        .results-table {
            background: rgba(255,255,255,.04);
            border: 1px solid rgba(255,255,255,.08);
            border-radius: 16px;
            overflow: hidden;
        }

        .table-scroll {
            overflow-x: auto;
            width: 100%;
        }

        .custom-table {
            width: 100%;
            min-width: 1600px;
            border-collapse: collapse;
        }

            .custom-table thead {
                background: rgba(167,139,250,.08);
            }

                .custom-table thead th {
                    padding: 14px 12px;
                    text-align: left;
                    font-size: 12px;
                    font-weight: 600;
                    color: rgba(255,255,255,.85);
                    border-bottom: 1px solid rgba(255,255,255,.08);
                    white-space: nowrap;
                }

            .custom-table tbody td {
                padding: 12px;
                text-align: left;
                color: #e2e8f0;
                border-top: 1px solid rgba(255,255,255,.05);
                font-size: 12px;
            }

                .custom-table tbody td input {
                    width: 100%;
                }

        .empty-row {
            height: 100px;
            color: rgba(255,255,255,.25);
            font-size: 13px;
        }

        .actions {
            margin-top: 16px;
        }

        @@media (max-width:900px) {
            .form-row {
                grid-template-columns: 1fr;
            }
        }
    </style>

</head>

<body>

    <div class="form-card">

        <div class="form-card-header">
            Laser Engraving
        </div>

        <form id="mainForm" asp-action="Index" method="post">

            <div class="form-body">

                <!-- Row 1 -->

                <div class="form-row">

                    <div class="form-group">
                        <label>Line</label>

                        <select asp-for="LineId"
                                id="LineId"
                                asp-items="@(new SelectList(Model.Lines, "LineId", "LineName"))">
                            <option value="">-- Select Line --</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Project</label>

                        <select asp-for="ProjectId"
                                id="ProjectId"
                                asp-items="@(new SelectList(Model.Projects, "ProjectId", "ProjectName"))">
                            <option value="">-- Select Project --</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Model</label>
                        <select asp-for="ModelId"
                                id="ModelId"
                                asp-items="@(new SelectList(Model.ModelNos, "ModelId", "Model"))">
                            <option value="">-- Select Model --</option>
                        </select>

                    </div>

                </div>

                <!-- Row 2 -->

                <div class="form-row">

                    <div class="form-group">
                        <label>Part</label>

                        <select asp-for="PartId"
                                id="PartId"
                                asp-items="@(new SelectList(Model.PartNos,
                                    "PartId",
                                    "Part"))">
                            <option value="">-- Select Part --</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Machine</label>

                        <select asp-for="MachineId"
                                id="MachineId"
                                asp-items="@(new SelectList(Model.Machines,
                    "MachineId",
                    "Machine"))">
                            <option value="">-- Select Machine --</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Production Line Leader</label>

                        <input asp-for="ProdLineLeader"
                               type="text"
                               placeholder="Production Line Leader" />
                    </div>

                </div>

                <!-- Row 3 -->

                <div class="form-row">

                    <div class="form-group">
                        <label>Checked By</label>

                        <input asp-for="CheckedBy"
                               type="text" />
                    </div>

                    <div class="form-group">
                        <label>Approved By</label>

                        <input asp-for="ApprovedBy"
                               type="text" />
                    </div>

                    <div class="form-group"
                         style="justify-content:flex-end;">

                        <button type="submit"
                                class="btn-search">
                            Search
                        </button>
                    </div>
                </div>
            </div>
        </form>

    </div>

    <!-- TABLE -->

    <div class="results-table">

        @if (Model.dtChecklist != null && Model.dtChecklist.Rows.Count > 0)
        {
            <div class="table-scroll">

                <table class="custom-table">

                    <thead>
                        <tr>
                            <th>Location</th>
                            <th>Specification</th>
                            <th>Minimum</th>
                            <th>Maximum</th>

                            <th>Value 1</th>
                            <th>Serial Number 1</th>

                            <th>Value 2</th>
                            <th>Serial Number 2</th>

                            <th>Value 3</th>
                            <th>Serial Number 3</th>

                            <th>Value 4</th>
                            <th>Serial Number 4</th>

                            <th>Value 5</th>
                            <th>Serial Number 5</th>

                            <th>Save</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.dtChecklist != null && Model.dtChecklist.Rows.Count > 0)
                        {
                            for (int i = 0; i < Model.dtChecklist.Rows.Count; i++)
                            {
                                <tr>

                                    <td>
                                        @Model.dtChecklist.Rows[i]["Locations"]

                                        <input type="hidden"
                                               name="LaserResults[@i].LocationId"
                                               value="@Model.dtChecklist.Rows[i]["LocationId"]" />
                                    </td>

                                    <td>@Model.dtChecklist.Rows[i]["Specification"]</td>
                                    <td>@Model.dtChecklist.Rows[i]["Min"]</td>
                                    <td>@Model.dtChecklist.Rows[i]["Max"]</td>

                                    <td><input name="LaserResults[@i].Value1" /></td>
                                    <td><input name="LaserResults[@i].SerialNumber1" /></td>

                                    <td><input name="LaserResults[@i].Value2" /></td>
                                    <td><input name="LaserResults[@i].SerialNumber2" /></td>

                                    <td><input name="LaserResults[@i].Value3" /></td>
                                    <td><input name="LaserResults[@i].SerialNumber3" /></td>

                                    <td><input name="LaserResults[@i].Value4" /></td>
                                    <td><input name="LaserResults[@i].SerialNumber4" /></td>

                                    <td><input name="LaserResults[@i].Value5" /></td>
                                    <td><input name="LaserResults[@i].SerialNumber5" /></td>

                                    <td>
                                        <button type="button" class="btn-search" onclick="saveSingleRow(@i)">
                                            Save
                                        </button>
                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="15" class="empty-row">
                                    No records found
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="empty-row" style="padding:40px;text-align:center;">
                No records found. Use search to load data.
            </div>
        }

    </div>

    <div class="actions">
        <button type="button" class="btn-submit" onclick="SubmitAll();">
            Submit
        </button>
    </div>


    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>

        $("#ProjectId").change(function () {
            var projectId = $(this).val();

            $.ajax({
                url: '/LaserEngraving/GetModelNoByProject',
                type: 'POST',
                data: { projectId: projectId },

                success: function (data) {
                    $("#ModelId").empty();

                    $("#ModelId").append('<option value="">-- Select Model --</option>');

                    $.each(data, function (i, item) {

                        $("#ModelId").append(
                            '<option value="' +
                            item.modelId +
                            '">' +
                            item.model +
                            '</option>');
                    });

                    $("#PartId").empty();

                    $("#PartId").append('<option value="">-- Select Part --</option>');
                }
            });
        });

        $("#ModelId").change(function () {

            $.ajax({

                url: '/LaserEngraving/GetPartNoByModel',

                type: 'POST',

                data: { modelId: $("#ModelId").val() },

                success: function (data) {

                    $("#PartId").empty();

                    $("#PartId").append('<option value="">-- Select Part --</option>');

                    $.each(data, function (i, item) {

                        $("#PartId").append(
                            '<option value="' +
                            item.partId +
                            '">' +
                            item.part +
                            '</option>');
                    });
                }
            });
        });

        function saveSingleRow(index) {

            let clickedRow = $(".custom-table tbody tr").eq(index);

            let rowsToSave = [];

            $(".custom-table tbody tr").each(function () {

                let row = $(this);

                let rowIndex = row.index();

                let locationId = row.find("input[name='LaserResults[" + rowIndex + "].LocationId']").val();

                let value1 = $.trim(row.find("input[name='LaserResults[" + rowIndex + "].Value1']").val());
                let serial1 = $.trim(row.find("input[name='LaserResults[" + rowIndex + "].SerialNumber1']").val());

                let value2 = $.trim(row.find("input[name='LaserResults[" + rowIndex + "].Value2']").val());
                let serial2 = $.trim(row.find("input[name='LaserResults[" + rowIndex + "].SerialNumber2']").val());

                let value3 = $.trim(row.find("input[name='LaserResults[" + rowIndex + "].Value3']").val());
                let serial3 = $.trim(row.find("input[name='LaserResults[" + rowIndex + "].SerialNumber3']").val());

                let value4 = $.trim(row.find("input[name='LaserResults[" + rowIndex + "].Value4']").val());
                let serial4 = $.trim(row.find("input[name='LaserResults[" + rowIndex + "].SerialNumber4']").val());

                let value5 = $.trim(row.find("input[name='LaserResults[" + rowIndex + "].Value5']").val());
                let serial5 = $.trim(row.find("input[name='LaserResults[" + rowIndex + "].SerialNumber5']").val());

                // Check whether any value is entered
                let hasValue =
                    value1 !== "" ||
                    serial1 !== "" ||
                    value2 !== "" ||
                    serial2 !== "" ||
                    value3 !== "" ||
                    serial3 !== "" ||
                    value4 !== "" ||
                    serial4 !== "" ||
                    value5 !== "" ||
                    serial5 !== "";

                if (locationId && hasValue) {

                    rowsToSave.push({

                        locationId: parseInt(locationId),

                        value1: value1 === "" ? null : value1,
                        serialNumber1: serial1 === "" ? null : serial1,

                        value2: value2 === "" ? null : value2,
                        serialNumber2: serial2 === "" ? null : serial2,

                        value3: value3 === "" ? null : value3,
                        serialNumber3: serial3 === "" ? null : serial3,

                        value4: value4 === "" ? null : value4,
                        serialNumber4: serial4 === "" ? null : serial4,

                        value5: value5 === "" ? null : value5,
                        serialNumber5: serial5 === "" ? null : serial5,

                        _htmlRow: row

                    });

                }

                // Stop at clicked Save row
                if (row[0] === clickedRow[0]) {
                    return false;
                }

            });

            if (rowsToSave.length == 0) {

                alert("Please enter at least one value before saving.");

                return;

            }

            // Remove _htmlRow before sending
            let resultList = rowsToSave.map(function (x) {

                return {

                    locationId: x.locationId,

                    value1: x.value1,
                    serialNumber1: x.serialNumber1,

                    value2: x.value2,
                    serialNumber2: x.serialNumber2,

                    value3: x.value3,
                    serialNumber3: x.serialNumber3,

                    value4: x.value4,
                    serialNumber4: x.serialNumber4,

                    value5: x.value5,
                    serialNumber5: x.serialNumber5

                };

            });

            let obj = {

                lineId: $("#LineId").val(),

                projectId: $("#ProjectId").val(),

                modelId: $("#ModelId").val(),

                partId: $("#PartId").val(),

                machineId: $("#MachineId").val(),

                prodLineLeader: $("input[name='ProdLineLeader']").val(),

                checkedBy: $("input[name='CheckedBy']").val(),

                approvedBy: $("input[name='ApprovedBy']").val(),

                laserResults: resultList

            };

            $.ajax({

                url: '/LaserEngraving/SaveLaserEngraving',

                type: 'POST',

                contentType: 'application/json',

                data: JSON.stringify(obj),

                success: function (res) {

                    alert(res.message || "Saved Successfully");

                    // Remove only saved rows
                    rowsToSave.forEach(function (x) {

                        x._htmlRow.remove();

                    });

                    // Show No Records when all rows removed
                    if ($(".custom-table tbody tr").length === 0) {

                        $(".custom-table tbody").html(`
                            <tr>
                                <td colspan="15" class="empty-row">
                                    No records found.
                                </td>
                            </tr>
                        `);

                    }

                },

                error: function () {

                    alert("Save Failed");

                }

            });

        }

        function SubmitAll() {
            var results = [];

            $(".custom-table tbody tr").each(function (index) {

                var locationId = $(this).find("input[name='LaserResults[" + index + "].LocationId']").val();

                if (!locationId) return;

                results.push({
                    locationId: parseInt(locationId),
                    value1: $(this).find("input[name='LaserResults[" + index + "].Value1']").val(),
                    serialNumber1: $(this).find("input[name='LaserResults[" + index + "].SerialNumber1']").val(),
                    value2: $(this).find("input[name='LaserResults[" + index + "].Value2']").val(),
                    serialNumber2: $(this).find("input[name='LaserResults[" + index + "].SerialNumber2']").val(),
                    value3: $(this).find("input[name='LaserResults[" + index + "].Value3']").val(),
                    serialNumber3: $(this).find("input[name='LaserResults[" + index + "].SerialNumber3']").val(),
                    value4: $(this).find("input[name='LaserResults[" + index + "].Value4']").val(),
                    serialNumber4: $(this).find("input[name='LaserResults[" + index + "].SerialNumber4']").val(),
                    value5: $(this).find("input[name='LaserResults[" + index + "].Value5']").val(),
                    serialNumber5: $(this).find("input[name='LaserResults[" + index + "].SerialNumber5']").val()
                });
            });

            var obj = {
                lineId: $("#LineId").val(),
                projectId: $("#ProjectId").val(),
                modelId: $("#ModelId").val(),
                partId: $("#PartId").val(),
                machineId: $("#MachineId").val(),
                prodLineLeader: $("input[name='ProdLineLeader']").val(),
                checkedBy: $("input[name='CheckedBy']").val(),
                approvedBy: $("input[name='ApprovedBy']").val(),
                laserResults: results
            };

            $.ajax({
                url: '/LaserEngraving/SaveLaserEngraving',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(obj),

                success: function (res) {
                    alert(res.message);
                    location.reload();
                },
                error: function () {
                    alert("Save failed");
                }
            });
        }

    </script>
</body>
</html>