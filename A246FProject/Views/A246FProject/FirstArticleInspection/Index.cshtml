@model A246FProject.Models.FirstArticleInspectionViewModel
@using Microsoft.AspNetCore.Mvc.Rendering

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>First Article Assurance Inspection Record</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Poppins, sans-serif;
        }

        body {
            background: linear-gradient(135deg, #0d0d1a, #0a0a2e, #0d1b2a);
            min-height: 100vh;
            color: #e2e8f0;
            padding: 20px;
        }

        h1 {
            font-size: 22px;
            font-weight: 600;
            color: #fff;
            margin-bottom: 4px;
        }

        .sub {
            color: rgba(255,255,255,.4);
            font-size: 13px;
            margin-bottom: 18px;
        }

        /* FORM CARD */
        .form-card {
            background: rgba(255,255,255,.04);
            border: 0.5px solid rgba(255,255,255,.08);
            border-radius: 16px;
            overflow: hidden;
            margin-bottom: 16px;
        }

        .form-card-header {
            background: rgba(167,139,250,.12);
            border-bottom: 0.5px solid rgba(167,139,250,.2);
            padding: 14px 22px;
            font-size: 15px;
            font-weight: 600;
            color: #fff;
        }

        .form-body {
            padding: 22px;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .form-row {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 14px;
        }

        .form-row-2 {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 14px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        label {
            font-size: 11px;
            color: rgba(255,255,255,.45);
            letter-spacing: 0.5px;
        }

        input, select {
            background: rgba(255,255,255,.06);
            border: 0.5px solid rgba(255,255,255,.12);
            border-radius: 8px;
            padding: 9px 12px;
            font-size: 13px;
            color: #fff;
            outline: none;
            transition: border-color .2s, background .2s;
        }

            select option {
                background: #1a1040;
            }

            input::placeholder {
                color: rgba(255,255,255,.25);
            }

            input:focus, select:focus {
                border-color: rgba(167,139,250,.5);
                background: rgba(167,139,250,.08);
            }

        .btn-search {
            background: linear-gradient(135deg, #a78bfa, #7c3aed);
            border: none;
            border-radius: 8px;
            padding: 10px 20px;
            color: #fff;
            cursor: pointer;
            font-size: 13px;
        }

            .btn-search:hover {
                opacity: .85;
            }

        .btn-submit {
            background: linear-gradient(135deg, #60a5fa, #2563eb);
            border: none;
            border-radius: 8px;
            padding: 10px 32px;
            color: #fff;
            cursor: pointer;
            font-size: 13px;
            font-family: Poppins, sans-serif;
            font-weight: 500;
            transition: opacity .2s;
        }

            .btn-submit:hover {
                opacity: .85;
            }

        /* NOTE BOX */
        .note-box {
            background: rgba(255,255,255,.03);
            border: 0.5px solid rgba(255,255,255,.08);
            border-radius: 10px;
            padding: 12px 16px;
            margin-bottom: 12px;
        }

            .note-box span {
                font-size: 12px;
                font-weight: 600;
                color: #f87171;
                line-height: 1.8;
            }

        /* TABLE */
        .results-table {
            background: rgba(255,255,255,.04);
            border: 0.5px solid rgba(255,255,255,.08);
            border-radius: 16px;
            overflow: hidden;
            margin-bottom: 16px;
        }

        .header-row {
            display: grid;
            grid-template-columns: 240px 180px 1fr 120px 120px 180px 120px;
            background: rgba(167,139,250,.08);
            padding: 12px 16px;
            font-size: 11px;
            color: rgba(255,255,255,.45);
            letter-spacing: 0.5px;
            gap: 10px;
        }

        .data-row {
            display: grid;
            grid-template-columns: 240px 180px 1fr 120px 120px 180px 120px;
            padding: 10px 16px;
            font-size: 13px;
            border-top: 0.5px solid rgba(255,255,255,.05);
            gap: 10px;
            align-items: start;
            transition: background .15s;
        }

            .data-row:hover {
                background: rgba(255,255,255,.03);
            }

            .data-row input, .data-row select {
                padding: 6px 10px;
                font-size: 12px;
                width: 100%;
            }

        .empty {
            padding: 40px;
            text-align: left;
            color: rgba(255,255,255,.25);
            font-size: 13px;
        }

        .actions {
            margin-top: 4px;
            display: flex;
            gap: 10px;
        }

        /* STATUS BADGES */
        .badge {
            display: inline-block;
            padding: 3px 10px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
        }

        .badge-ok {
            background: rgba(52,211,153,.15);
            color: #34d399;
            border: 0.5px solid rgba(52,211,153,.3);
        }

        .badge-ng {
            background: rgba(248,113,113,.15);
            color: #f87171;
            border: 0.5px solid rgba(248,113,113,.3);
        }

        .badge-na {
            background: rgba(148,163,184,.15);
            color: #94a3b8;
            border: 0.5px solid rgba(148,163,184,.3);
        }

        @@media (max-width: 900px) {
            .form-row, .form-row-2 {
                grid-template-columns: 1fr;
            }

            .header-row, .data-row {
                grid-template-columns: repeat(2, 1fr);
            }
        }
    </style>
</head>
<body>

    <div class="form-card">
        <div class="form-card-header">First Article Assurance Inspection Record</div>
        <div class="form-body">

            <!-- Row 1 -->
            <div class="form-row">
                <div class="form-group">
                    <label>Line</label>
                    <select asp-for="LineId"
                            id="ddlLine"
                            class="form-control"
                            asp-items="@(new SelectList(Model.Lines, "LineId", "LineName"))">
                        <option value="">-- Select Line --</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Project</label>
                    <select asp-for="ProjectId"
                            id="ddlProject"
                            class="form-control"
                            asp-items="@(new SelectList(Model.Projects, "ProjectId", "ProjectName"))">
                        <option value="">-- Select Project --</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Model</label>
                    <select asp-for="ModelId"
                            id="ddlModel"
                            class="form-control"
                            asp-items="@(new SelectList(Model.ModelNos, "ModelId", "Model"))">
                        <option value="">-- Select Model --</option>
                    </select>
                </div>
            </div>

            <!-- Row 2 -->
            <div class="form-row">
                <div class="form-group">
                    <label>Part</label>
                    <select asp-for="PartId"
                            id="ddlPart"
                            class="form-control"
                            asp-items="@(new SelectList(Model.PartNos, "PartId", "Part"))">
                        <option value="">-- Select Part --</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Production Line Leader</label>
                    <input type="text" id="txtLineLeader" placeholder="Production Line Leader" />
                </div>
                <div class="form-group">
                    <label>Checked By</label>
                    <input type="text" id="txtCheckedBy" placeholder="Checked By" />
                </div>
            </div>

            <!-- Row 3 -->
            <div class="form-row">
                <div class="form-group">
                    <label>Approved By</label>
                    <input type="text" id="txtApprovedBy" placeholder="Approved By" />
                </div>
                <div class="form-group">
                    <label>Work Order</label>
                    <input type="text" id="txtWorkOrder" placeholder="Work Order" />
                </div>
                <div class="form-group">
                    <label>Drawing Version</label>
                    <input type="text" id="txtDrawingVersion" placeholder="Drawing Version" />
                </div>
            </div>

            <!-- Row 4 -->
            <div class="form-row">
                <div class="form-group">
                    <label>Pack Version</label>
                    <input type="text" id="txtPackVersion" placeholder="Pack Version" />
                </div>
                <div class="form-group">
                    <label>Sampling Quantity</label>
                    <input type="number" id="txtSamplingQty" placeholder="Sampling Quantity" />
                </div>
                <div class="form-group" style="justify-content: flex-end;">
                    <button class="btn-search" onclick="loadData()">Search</button>
                </div>
            </div>

        </div>
    </div>

    <!-- NOTE BOX -->
    <div class="note-box">
        <span>NOTE:-</span>
        <span>N - NA</span>
        <span>, V - OK</span>
        <span>, X - NG</span>
    </div>

    <!-- RESULTS TABLE -->
    <div class="results-table">
        <div class="header-row">
            <div>Station Name</div>
            <div>Inspection Item</div>
            <div>Inspection Criteria</div>
            <div>Status</div>
            <div>Result</div>
            <div>NG Description</div>
            <div>Action</div>
        </div>
        <div id="tableBody">
            <div class="empty">No records found. Use Search to load data.</div>
        </div>
    </div>

    <div class="actions">
        <button class="btn-submit" onclick="submitData()">Submit</button>
    </div>
    <input type="hidden" id="hdnCreatedBy" value="@ViewBag.CreatedBy" />
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script>
        $(document).ready(function () {

            $("#ddlProject").change(function () {

                $.ajax({
                    url: '/FirstArticleInspection/GetModelNoByProject',
                    type: 'POST',
                    data: {
                        projectId: $(this).val()
                    },
                    success: function (data) {

                        $("#ddlModel").empty();
                        $("#ddlModel").append("<option value=''>--Select Model--</option>");

                        $.each(data, function (i, item) {

                            $("#ddlModel").append(
                                "<option value='" + item.modelId + "'>" +
                                item.model +
                                "</option>");
                        });

                    }
                });

            });

        });

         $("#ddlModel").change(function () {

            $.ajax({
                url: '/FirstArticleInspection/GetPartNoByModel',
                type: 'POST',
                data: { modelId: $(this).val() },
                success: function (data) {

                    $("#ddlPart").empty();
                    $("#ddlPart").append("<option value=''>--Select Part--</option>");

                    $.each(data, function (i, item) {

                        $("#ddlPart").append(
                            "<option value='" + item.partId + "'>" +
                            item.part +
                            "</option>");
                    });
                }
            });

        });

        function loadData() {

            $.ajax({
                url: '/FirstArticleInspection/GetInspectionData',
                type: 'POST',
                data: {
                    lineId: $("#ddlLine").val(),
                    projectId: $("#ddlProject").val()
                },
                        success: function (data) {

                    let html = "";

                    if (data.length === 0) {
                        html = "<div class='empty'>No records found</div>";
                    }
                    else {

                                let previousStation = "";
                                let previousItem = "";

                                $.each(data, function (i, item) {

                                    let stationHtml = "";
                                    let itemHtml = "";

                                    if (item.stationName != previousStation) {

                                        stationHtml = item.stationName;
                                        previousStation = item.stationName;

                                        previousItem = "";
                                    }

                                    if (item.itemName != previousItem) {

                                        itemHtml = item.itemName;
                                        previousItem = item.itemName;
                                    }

                                    html += `
                                      <div class="data-row"
                                            data-contentid="${item.contentId}"
                                            data-group="${item.stationName}_${item.itemName}">

                                        <input type="hidden" class="contentId" value="${item.contentId}" />

                                         <div class="station">
                                            ${stationHtml}
                                        </div>

                                        <div class="item">
                                            ${itemHtml}
                                        </div>

                                        <div class="criteria-area">
                                            <div class="criteria">
                                                ${item.content}
                                            </div>
                                        </div>

                                        <div class="control-area">
                                            <select class="status">
                                                <option value="OK">OK</option>
                                                <option value="NG">NG</option>
                                                <option value="NA">NA</option>
                                            </select>
                                        </div>

                                        <div class="control-area">
                                            <input type="text"
                                                   class="result"
                                                   maxlength="10"
                                                   oninput="this.value=this.value.replace(/[^a-zA-Z]/g,'');" />
                                        </div>

                                        <div class="control-area">
                                            <input type="text" class="ngdesc"/>
                                        </div>

                                        <div class="action-area">
                                            <button class="btn-search" onclick="saveRow(this)">Save</button>
                                        </div>

                                    </div>`;
                                });
                    }

                    $("#tableBody").html(html);
                }
            });
        }

        function saveRow(btn) {

            let rowsToSave = [];

            $(".data-row").each(function () {

                let row = $(this);

                let result = row.find(".result").val();

                let ngDesc = row.find(".ngdesc").val();

                let status = row.find(".status").val();

                if(result != "" || ngDesc != "")
                {
                    rowsToSave.push({

                        ContentId:row.find(".contentId").val(),

                        SRId:

                        status=="OK" ? 5 :

                        status=="NG" ? 6 : 7,

                        Result: result,

                        RejectDescribe: ngDesc

                    });
                }
            });

            if(rowsToSave.length == 0)
            {
                alert("Please enter data before saving");
                return;
            }

            let model = {
                LineId: $("#ddlLine").val(),
                ProjectId: $("#ddlProject").val(),
                ModelId: $("#ddlModel").val(),
                PartId: $("#ddlPart").val(),
                ProductName:
                $("#txtProductName").val(),
                WorkOrder:
                $("#txtWorkOrder").val(),
                DrawingVersion:
                $("#txtDrawingVersion").val(),
                PackVersion:
                $("#txtPackVersion").val(),
                SamplingQty:
                $("#txtSamplingQty").val(),
                ProdLineLeader:
                $("#txtLineLeader").val(),
                CheckedBy:
                $("#txtCheckedBy").val(),
                ApprovedBy:
                $("#txtApprovedBy").val(),
                CreatedBy:
                $("#hdnCreatedBy").val(),
                CheckListFirstArticleInspections:
                rowsToSave
            };

            $.ajax({

                url:"/FirstArticleInspection/SubmitInspection",
                type:"POST",
                contentType:"application/json",
                data:JSON.stringify(model),
                success:function(res){

                    if(res.success)
                    {

                        rowsToSave.forEach(function(x){

                            let row =
                            $(".data-row[data-contentid='"+x.ContentId+"']");
                            row.find(".criteria-area").fadeOut(500);
                            row.find(".control-area").fadeOut(500);
                            row.find(".action-area").fadeOut(500);
                        });
                    }

                },

                error:function(xhr){
                    console.log(xhr.responseText);
                    alert("Error while saving");
                }
            });
        }


        function submitData() {

            let list = [];

            $(".data-row").each(function () {

                list.push({

                    ContentId: $(this).find(".contentId").val(),

                      SRId: $(this).find(".status").val()=="OK" ? 5 :
                    $(this).find(".status").val()=="NG" ? 6 : 7,

                    Result: $(this).find(".result").val(),

                    RejectDescribe: $(this).find(".ngdesc").val()
                });

            });

            let model = {

                LineId: $("#ddlLine").val(),

                ProjectId: $("#ddlProject").val(),

                ModelId: $("#ddlModel").val(),

                PartId: $("#ddlPart").val(),

                ProductName: $("#txtProductName").val(),

                WorkOrder: $("#txtWorkOrder").val(),

                DrawingVersion: $("#txtDrawingVersion").val(),

                PackVersion: $("#txtPackVersion").val(),

                SamplingQty: $("#txtSamplingQty").val(),

                ProdLineLeader: $("#txtLineLeader").val(),

                CheckedBy: $("#txtCheckedBy").val(),

                ApprovedBy: $("#txtApprovedBy").val(),

                CreatedBy: $("#hdnCreatedBy").val(),

                CheckListFirstArticleInspections: list

            };

            $.ajax({

                url: "/FirstArticleInspection/SubmitInspection",

                type: "POST",

                contentType: "application/json",

                data: JSON.stringify(model),

                success: function (res) {

                    if (res.success) {

                        alert("Bulk Data Submitted Successfully");

                        $("#ddlLine").val("");
                        $("#ddlProject").val("");
                        $("#ddlModel").empty().append("<option value=''>-- Select Model --</option>");
                        $("#ddlPart").empty().append("<option value=''>-- Select Part --</option>");

                        $("#txtLineLeader").val("");
                        $("#txtCheckedBy").val("");
                        $("#txtApprovedBy").val("");
                        $("#txtProductName").val("");
                        $("#txtWorkOrder").val("");
                        $("#txtDrawingVersion").val("");
                        $("#txtPackVersion").val("");
                        $("#txtSamplingQty").val("");

                        $("#tableBody").html("<div class='empty'>No records found. Use Search to load data.</div>");

                    }
                    else {

                        alert("Submit Failed");

                    }
                }

            });

        }
    </script>
</body>
</html>