@model A246FProject.Models.FirstArticleDimensionViewModel
@using Microsoft.AspNetCore.Mvc.Rendering

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>First Article Assurance Dimension Record</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Poppins, sans-serif;
        }

        body {
            background: linear-gradient(135deg, #0d0d1a, #0a0a2e, #0d1b2a);
            min-height: 100vh;
            color: #e2e8f0;
            padding: 20px;
        }

        h1 {
            font-size: 22px;
            font-weight: 600;
            color: #fff;
            margin-bottom: 4px;
        }

        .sub {
            color: rgba(255,255,255,.4);
            font-size: 13px;
            margin-bottom: 18px;
        }

        /* FORM CARD */
        .form-card {
            background: rgba(255,255,255,.04);
            border: 0.5px solid rgba(255,255,255,.08);
            border-radius: 16px;
            overflow: hidden;
            margin-bottom: 16px;
        }

        .form-card-header {
            background: rgba(167,139,250,.12);
            border-bottom: 0.5px solid rgba(167,139,250,.2);
            padding: 14px 22px;
            font-size: 15px;
            font-weight: 600;
            color: #fff;
        }

        .form-body {
            padding: 22px;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .form-row {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 14px;
        }

        .form-row-2 {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 14px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        label {
            font-size: 11px;
            color: rgba(255,255,255,.45);
            letter-spacing: 0.5px;
        }

        input, select {
            background: rgba(255,255,255,.06);
            border: 0.5px solid rgba(255,255,255,.12);
            border-radius: 8px;
            padding: 9px 12px;
            font-size: 13px;
            color: #fff;
            outline: none;
            transition: border-color .2s, background .2s;
        }

            select option {
                background: #1a1040;
            }

            input::placeholder {
                color: rgba(255,255,255,.25);
            }

            input:focus, select:focus {
                border-color: rgba(167,139,250,.5);
                background: rgba(167,139,250,.08);
            }

        .btn-search {
            background: linear-gradient(135deg, #a78bfa, #7c3aed);
            border: none;
            border-radius: 8px;
            padding: 10px 20px;
            color: #fff;
            cursor: pointer;
            font-size: 13px;
        }

            .btn-search:hover {
                opacity: .85;
            }

        .btn-submit {
            background: linear-gradient(135deg, #60a5fa, #2563eb);
            border: none;
            border-radius: 8px;
            padding: 10px 32px;
            color: #fff;
            cursor: pointer;
            font-size: 13px;
            font-family: Poppins, sans-serif;
            font-weight: 500;
            transition: opacity .2s;
        }

            .btn-submit:hover {
                opacity: .85;
            }

        /* NOTE BOX */
        .note-box {
            background: rgba(255,255,255,.03);
            border: 0.5px solid rgba(255,255,255,.08);
            border-radius: 10px;
            padding: 12px 16px;
            margin-bottom: 12px;
        }

            .note-box span {
                font-size: 12px;
                font-weight: 600;
                color: #f87171;
                line-height: 1.8;
            }

        /* TABLE */
        .results-table {
            background: rgba(255,255,255,.04);
            border: 0.5px solid rgba(255,255,255,.08);
            border-radius: 16px;
            overflow-x: auto;
            margin-bottom: 16px;
        }

        #tblDimension {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
        }

            #tblDimension th,
            #tblDimension td {
                border: 1px solid rgba(255,255,255,.08);
                padding: 8px;
                text-align: center;
                vertical-align: middle;
            }

            #tblDimension th {
                background: #2b264d;
                color: #fff;
                font-weight: 600;
            }

                #tblDimension th:nth-child(1),
                #tblDimension td:nth-child(1) {
                    width: 220px;
                    white-space: normal;
                    word-break: break-word;
                    overflow-wrap: break-word;
                    text-align: left;
                    vertical-align: top;
                }

                #tblDimension th:nth-child(2),
                #tblDimension td:nth-child(2) {
                    width: 120px;
                    white-space: normal;
                    word-break: break-word;
                    overflow-wrap: break-word;
                    text-align: center;
                }

                #tblDimension th:nth-child(3),
                #tblDimension td:nth-child(3),
                #tblDimension th:nth-child(5),
                #tblDimension td:nth-child(5),
                #tblDimension th:nth-child(7),
                #tblDimension td:nth-child(7),
                #tblDimension th:nth-child(9),
                #tblDimension td:nth-child(9),
                #tblDimension th:nth-child(11),
                #tblDimension td:nth-child(11) {
                    width: 90px;
                }

                #tblDimension th:nth-child(4),
                #tblDimension td:nth-child(4),
                #tblDimension th:nth-child(6),
                #tblDimension td:nth-child(6),
                #tblDimension th:nth-child(8),
                #tblDimension td:nth-child(8),
                #tblDimension th:nth-child(10),
                #tblDimension td:nth-child(10),
                #tblDimension th:nth-child(12),
                #tblDimension td:nth-child(12) {
                    width: 140px;
                }

                #tblDimension th:nth-child(13),
                #tblDimension td:nth-child(13) {
                    width: 90px;
                }

            #tblDimension input {
                width: 100%;
                height: 36px;
                border-radius: 8px;
                background: #2b2948;
                border: 1px solid #4c4a6c;
                color: #fff;
            }

            thead tr th{
                font-size: 13px;
            }

            tbody td{
                font-size: 12px;
            }

        .header-row {
            display: grid;
            grid-template-columns: 240px 180px 1fr 120px 120px 180px 120px;
            background: rgba(167,139,250,.08);
            padding: 12px 16px;
            font-size: 11px;
            color: rgba(255,255,255,.45);
            letter-spacing: 0.5px;
            gap: 10px;
        }

        .data-row {
            display: grid;
            grid-template-columns: 240px 180px 1fr 120px 120px 180px 120px;
            padding: 10px 16px;
            font-size: 13px;
            border-top: 0.5px solid rgba(255,255,255,.05);
            gap: 10px;
            align-items: start;
            transition: background .15s;
        }

            .data-row:hover {
                background: rgba(255,255,255,.03);
            }

            .data-row input, .data-row select {
                padding: 6px 10px;
                font-size: 12px;
                width: 100%;
            }

        .empty {
            padding: 40px;
            text-align: left;
            color: rgba(255,255,255,.25);
            font-size: 13px;
        }

        .actions {
            margin-top: 4px;
            display: flex;
            gap: 10px;
        }

        /* STATUS BADGES */
        .badge {
            display: inline-block;
            padding: 3px 10px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
        }

        .badge-ok {
            background: rgba(52,211,153,.15);
            color: #34d399;
            border: 0.5px solid rgba(52,211,153,.3);
        }

        .badge-ng {
            background: rgba(248,113,113,.15);
            color: #f87171;
            border: 0.5px solid rgba(248,113,113,.3);
        }

        .badge-na {
            background: rgba(148,163,184,.15);
            color: #94a3b8;
            border: 0.5px solid rgba(148,163,184,.3);
        }

        @@media (max-width: 900px) {
            .form-row, .form-row-2 {
                grid-template-columns: 1fr;
            }

            .header-row, .data-row {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        .ng-row {
            background: rgba(220, 53, 69, 0.18) !important;
            border-left: 4px solid #dc3545 !important;
        }

            .ng-row td {
                background: rgba(220, 53, 69, 0.12) !important;
            }

            .ng-row input {
                border: 1px solid #dc3545 !important;
                background: rgba(220, 53, 69, 0.12) !important;
                color: #ff6b6b !important;
            }
    </style>
</head>
<body>

    <div class="form-card">
        <div class="form-card-header">First Article Assurance Dimension Record</div>
        <div class="form-body">

            <!-- Row 1 -->
            <div class="form-row">
                <div class="form-group">
                    <label>Line</label>
                    <select asp-for="LineId"
                            id="ddlLine"
                            class="form-control"
                            asp-items="@(new SelectList(Model.Lines, "LineId", "LineName"))">
                        <option value="">-- Select Line --</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Project</label>
                    <select asp-for="ProjectId"
                            id="ddlProject"
                            class="form-control"
                            asp-items="@(new SelectList(Model.Projects, "ProjectId", "ProjectName"))">
                        <option value="">-- Select Project --</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Model</label>
                    <select asp-for="ModelId"
                            id="ddlModel"
                            class="form-control"
                            asp-items="@(new SelectList(Model.ModelNos, "ModelId", "Model"))">
                        <option value="">-- Select Model --</option>
                    </select>
                </div>
            </div>

            <!-- Row 2 -->
            <div class="form-row">
                <div class="form-group">
                    <label>Part</label>
                    <select asp-for="PartId"
                            id="ddlPart"
                            class="form-control"
                            asp-items="@(new SelectList(Model.PartNos, "PartId", "Part"))">
                        <option value="">-- Select Part --</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Production Line Leader</label>
                    <input type="text" id="txtLineLeader" placeholder="Production Line Leader" />
                </div>
                <div class="form-group">
                    <label>Checked By</label>
                    <input type="text" id="txtCheckedBy" placeholder="Checked By" />
                </div>
            </div>

            <!-- Row 3 -->
            <div class="form-row">
                <div class="form-group">
                    <label>Approved By</label>
                    <input type="text" id="txtApprovedBy" placeholder="Approved By" />
                </div>
                <div class="form-group">
                    <label>Work Order</label>
                    <input type="text" id="txtWorkOrder" placeholder="Work Order" />
                </div>
                <div class="form-group">
                    <label>Drawing Version</label>
                    <input type="text" id="txtDrawingVersion" placeholder="Drawing Version" />
                </div>
            </div>

            <!-- Row 4 -->
            <div class="form-row">
                <div class="form-group">
                    <label>Pack Version</label>
                    <input type="text" id="txtPackVersion" placeholder="Pack Version" />
                </div>
                <div class="form-group">
                    <label>Sampling Quantity</label>
                    <input type="number" id="txtSamplingQty" placeholder="Sampling Quantity" />
                </div>
                <div class="form-group" style="justify-content: flex-end;">
                    <button class="btn-search" onclick="loadData()">Search</button>
                </div>
            </div>

        </div>
    </div>

    <!-- NOTE BOX -->
    <div class="note-box">
        <span>NOTE:-</span>
        <span>N - NA</span>
        <span>, V - OK</span>
        <span>, X - NG</span>
    </div>

    <div id="validationMessage"
         style="
     display:none;
     background:#dc3545;
     color:white;
     padding:10px;
     border-radius:8px;
     margin:10px 0;">
    </div>

    <div class="results-table" style="overflow:auto">

        <table class="table table-bordered table-sm" id="tblDimension" style="width:100%;white-space:nowrap;">

            <thead>

                <tr>

                    <th>Inspection Location</th>
                    <th>Spec</th>

                    <th>Check1</th>
                    <th>SerialNo1</th>

                    <th>Check2</th>
                    <th>SerialNo2</th>

                    <th>Check3</th>
                    <th>SerialNo3</th>

                    <th>Check4</th>
                    <th>SerialNo4</th>

                    <th>Check5</th>
                    <th>SerialNo5</th>

                    <th>Action</th>

                </tr>

            </thead>

            <tbody id="tableBody">
            </tbody>

        </table>

    </div>

    <div class="actions">
        <button class="btn-submit" onclick="submitData()">Submit</button>
    </div>
    <input type="hidden" id="hdnCreatedBy" value="@ViewBag.CreatedBy" />
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script>
        $(document).ready(function () {

            $("#ddlProject").change(function () {

                var projectId = $(this).val();

                $.ajax({

                    url: '/FirstArticleDimension/GetModelNoByProject',

                    type: 'POST',

                    data: {
                        projectId: projectId
                    },

                            success: function (data) {


                            $("#ddlModel").empty();
                            $("#ddlModel").append("<option value=''>-- Select Model --</option>");

                            $.each(data, function (i, item) {

                                $("#ddlModel").append(
                                    "<option value='" + item.modelId + "'>" +
                                    item.model +
                                    "</option>");
                            });
                        }

                });

            });

            $("#ddlModel").change(function () {

                $.ajax({
                    url: '/FirstArticleDimension/GetPartNoByModel',
                    type: 'POST',
                    data: { modelId: $(this).val() },
                    success: function (data) {

                        $("#ddlPart").empty();
                        $("#ddlPart").append("<option value=''>--Select Part--</option>");

                        $.each(data, function (i, item) {

                            $("#ddlPart").append(
                                "<option value='" + item.partId + "'>" +
                                item.part +
                                "</option>");
                        });
                    }
                });

            });
        });



        function loadData() {

            var errors = "";

            if ($("#ddlLine").val() == "")
            {
                errors += "Line<br>";
            }


            if ($("#ddlProject").val() == "")
            {
                errors += "Project<br>";
            }


            if ($("#ddlModel").val() == "")
            {
                errors += "Model<br>";
            }


            if ($("#ddlPart").val() == "")
            {
                errors += "Part<br>";
            }


            if ($("#txtLineLeader").val().trim() == "")
            {
                errors += "Production Line Leader<br>";
            }


            if ($("#txtCheckedBy").val().trim() == "")
            {
                errors += "Checked By<br>";
            }


            if ($("#txtApprovedBy").val().trim() == "")
            {
                errors += "Approved By<br>";
            }


            if ($("#txtWorkOrder").val().trim() == "")
            {
                errors += "Work Order<br>";
            }


            if ($("#txtDrawingVersion").val().trim() == "")
            {
                errors += "Drawing Version<br>";
            }


            if ($("#txtPackVersion").val().trim() == "")
            {
                errors += "Pack Version<br>";
            }


            if ($("#txtSamplingQty").val().trim() == "")
            {
                errors += "Sampling Quantity<br>";
            }


            if(errors != "")
            {

                $("#validationMessage")
                .html(
                "<b>Please enter all details before Search.</b><br><br>"
                + errors
                )
                .show();


                $("#tableBody").html("");

                return;
            }

            $("#validationMessage")
            .hide();

            $.ajax({

                url: '/FirstArticleDimension/GetDimensionData',

                type:'POST',

                data:
                {
                    lineId: $("#ddlLine").val(),

                    projectId: $("#ddlProject").val()
                },


                success:function(data)
                {

                    let html="";

                    if(data.length==0)
                    {

                        html =
                        `
                        <tr>
                        <td colspan="13"
                        style="text-align:center;">
                        No records found
                        </td>
                        </tr>
                        `;

                    }

                    else
                    {

                        let previousStation="";


                        $.each(data,function(i,item)
                        {

                            let station="";


                            if(previousStation != item.stationName)
                            {
                                station=item.stationName;
                                previousStation=item.stationName;
                            }


                            html +=
                            `
                            <tr data-station="${item.stationName}"
                                data-specification="${item.specification}">

                            <td class="station-cell">

                            <input type="hidden"
                            class="specId"
                            value="${item.specId}" />

                            ${station}

                            </td>


                            <td>${item.specification}</td>


                            <td><input class="check1"/></td>
                            <td><input class="serial1"/></td>


                            <td><input class="check2"/></td>
                            <td><input class="serial2"/></td>


                            <td><input class="check3"/></td>
                            <td><input class="serial3"/></td>


                            <td><input class="check4"/></td>
                            <td><input class="serial4"/></td>


                            <td><input class="check5"/></td>
                            <td><input class="serial5"/></td>


                            <td>

                            <button type="button"
                            class="btn-search"
                            onclick="saveRow(this)">
                            Save
                            </button>

                            </td>


                            </tr>
                            `;

                        });

                    }

                    $("#tableBody").html(html);

                }

            });

        }

        function getSpecRange(specification) {

            if (!specification) {
                return null;
            }

            let spec = specification
                .toString()
                .trim()
                .replace(/\s+/g, "");

            if (spec.includes("±")) {

                let parts = spec.split("±");

                if (parts.length === 2) {

                    let center = parseFloat(parts[0]);
                    let tolerance = parseFloat(parts[1]);

                    if (!isNaN(center) && !isNaN(tolerance)) {

                        return {
                            min: center - tolerance,
                            max: center + tolerance
                        };
                    }
                }
            }

            if (spec.includes("~")) {

                let parts = spec.split("~");

                if (parts.length === 2) {

                    let min = parseFloat(parts[0]);
                    let max = parseFloat(parts[1]);

                    if (!isNaN(min) && !isNaN(max)) {

                        return {
                            min: Math.min(min, max),
                            max: Math.max(min, max)
                        };
                    }
                }
            }


            let toleranceMatch =
                spec.match(
                    /^(-?\d+(?:\.\d+)?)\+(\d+(?:\.\d+)?)-(\d+(?:\.\d+)?)$/
                );

            if (toleranceMatch) {

                let base = parseFloat(toleranceMatch[1]);
                let plusTolerance = parseFloat(toleranceMatch[2]);
                let minusTolerance = parseFloat(toleranceMatch[3]);

                return {
                    min: base - minusTolerance,
                    max: base + plusTolerance
                };
            }


            return null;
        }

        function isNGValue(value, specification) {

            if (value == null || value.toString().trim() === "") {
                return false;
            }

            let numericValue = parseFloat(value);

            if (isNaN(numericValue)) {
                return false;
            }

            let range = getSpecRange(specification);

            if (!range) {
                return false;
            }

            return (
                numericValue < range.min ||
                numericValue > range.max
            );
        }

        function updateDimensionNGRow(row) {

            let specification =
                row.attr("data-specification");

            let hasNG = false;


            if (
                isNGValue(
                    row.find(".check1").val(),
                    specification
                )
            ) {
                hasNG = true;
            }


            if (
                isNGValue(
                    row.find(".check2").val(),
                    specification
                )
            ) {
                hasNG = true;
            }


            if (
                isNGValue(
                    row.find(".check3").val(),
                    specification
                )
            ) {
                hasNG = true;
            }


            if (
                isNGValue(
                    row.find(".check4").val(),
                    specification
                )
            ) {
                hasNG = true;
            }


            if (
                isNGValue(
                    row.find(".check5").val(),
                    specification
                )
            ) {
                hasNG = true;
            }


            if (hasNG) {

                row.addClass("ng-row");

            }
            else {

                row.removeClass("ng-row");

            }
        }

        $(document).on(
            "input",
            ".check1, .check2, .check3, .check4, .check5",
            function () {

                let row = $(this).closest("tr");

                updateDimensionNGRow(row);
            }
        );

        function ValidateDimensionNGRecords(rows) {

            let ngRecords = [];

            rows.forEach(function (x, index) {

                let ngChecks = [];

                let specification =
                    x._htmlRow.attr("data-specification");

                if (
                    isNGValue(
                        x.Check1,
                        specification
                    )
                ) {
                    ngChecks.push("Check1");
                }


                if (
                    isNGValue(
                        x.Check2,
                        specification
                    )
                ) {
                    ngChecks.push("Check2");
                }


                if (
                    isNGValue(
                        x.Check3,
                        specification
                    )
                ) {
                    ngChecks.push("Check3");
                }


                if (
                    isNGValue(
                        x.Check4,
                        specification
                    )
                ) {
                    ngChecks.push("Check4");
                }


                if (
                    isNGValue(
                        x.Check5,
                        specification
                    )
                ) {
                    ngChecks.push("Check5");
                }

                if (ngChecks.length > 0) {

                    x._htmlRow.addClass("ng-row");


                    let stationName =
                        x._htmlRow.attr("data-station") || "-";


                    let range =
                        getSpecRange(specification);


                    ngRecords.push({

                        index: index,

                        stationName: stationName,

                        specification: specification,

                        allowedRange:
                            range
                                ? range.min + " to " + range.max
                                : "-",

                        checks: ngChecks,

                        row: x._htmlRow

                    });

                }
                else {

                    x._htmlRow.removeClass("ng-row");

                }

            });


            if (ngRecords.length === 0) {

                return true;

            }

            let message =
                ngRecords.length +
                " NG record(s) found.\n\n";


            ngRecords.forEach(function (item) {

                message +=
                    "Record " +
                    (item.index + 1) +
                    "\n";


                message +=
                    "Station: " +
                    item.stationName +
                    "\n";


                message +=
                    "Specification: " +
                    item.specification +
                    "\n";


                message +=
                    "Allowed Range: " +
                    item.allowedRange +
                    "\n";


                message +=
                    "NG Found In: " +
                    item.checks.join(", ") +
                    "\n\n";

            });


            message +=
                "The above values are outside the specification.\n\n" +
                "Do you want to save these NG records?";


            let result =
                confirm(message);


            if (!result) {

                ngRecords.forEach(function (item) {

                    item.row.addClass("ng-row");

                });

                return false;

            }


            return true;
        }

        function refreshStationDisplay() {

            let previousStation = "";

            $("#tableBody tr").each(function () {

                let row = $(this);

                let stationName = row.attr("data-station");

                // First clear the displayed station
                row.find(".station-cell")
                   .contents()
                   .filter(function () {
                       return this.nodeType === 3;
                   })
                   .remove();

                // Show Station Name only for
                // first remaining row of that station
                if (stationName != previousStation) {

                    row.find(".station-cell").append(
                        document.createTextNode(stationName)
                    );

                    previousStation = stationName;
                }
            });
        }

        function saveRow(btn) {

            let clickedRow = $(btn).closest("tr");

            let rowsToSave = [];

            $("#tableBody tr").each(function () {

                let row = $(this);

                rowsToSave.push({

                    SpecId: row.find(".specId").val(),

                    Check1: row.find(".check1").val(),
                    Check2: row.find(".check2").val(),
                    Check3: row.find(".check3").val(),
                    Check4: row.find(".check4").val(),
                    Check5: row.find(".check5").val(),

                    SerialNo1: row.find(".serial1").val(),
                    SerialNo2: row.find(".serial2").val(),
                    SerialNo3: row.find(".serial3").val(),
                    SerialNo4: row.find(".serial4").val(),
                    SerialNo5: row.find(".serial5").val(),

                    _htmlRow: row
                });

                if (row[0] === clickedRow[0]) {
                    return false;
                }

            });

            rowsToSave = rowsToSave.filter(function (x) {

                return (
                    (x.Check1 || "").trim() !== "" ||
                    (x.Check2 || "").trim() !== "" ||
                    (x.Check3 || "").trim() !== "" ||
                    (x.Check4 || "").trim() !== "" ||
                    (x.Check5 || "").trim() !== "" ||

                    (x.SerialNo1 || "").trim() !== "" ||
                    (x.SerialNo2 || "").trim() !== "" ||
                    (x.SerialNo3 || "").trim() !== "" ||
                    (x.SerialNo4 || "").trim() !== "" ||
                    (x.SerialNo5 || "").trim() !== ""
                );

            });


            if (rowsToSave.length === 0) {

                alert("Please enter data before saving.");

                return;
            }

            let validationResult =
                ValidateDimensionNGRecords(rowsToSave);


            if (!validationResult) {

                return;

            }

            let dimensionList =
                rowsToSave.map(function (x) {

                    return {

                        SpecId: x.SpecId,

                        Check1: x.Check1,
                        Check2: x.Check2,
                        Check3: x.Check3,
                        Check4: x.Check4,
                        Check5: x.Check5,

                        SerialNo1: x.SerialNo1,
                        SerialNo2: x.SerialNo2,
                        SerialNo3: x.SerialNo3,
                        SerialNo4: x.SerialNo4,
                        SerialNo5: x.SerialNo5
                    };

                });


            let model = {

                LineId: $("#ddlLine").val(),

                ProjectId: $("#ddlProject").val(),

                ModelId: $("#ddlModel").val(),

                PartId: $("#ddlPart").val(),

                ProductName: $("#txtProductName").val(),

                WorkOrder: $("#txtWorkOrder").val(),

                DrawingVersion: $("#txtDrawingVersion").val(),

                PackVersion: $("#txtPackVersion").val(),

                SamplingQty: $("#txtSamplingQty").val(),

                ProdLineLeader: $("#txtLineLeader").val(),

                CheckedBy: $("#txtCheckedBy").val(),

                ApprovedBy: $("#txtApprovedBy").val(),

                CreatedBy: $("#hdnCreatedBy").val(),

                CheckListFirstArticleDimensions:
                    dimensionList
            };


            $.ajax({

                url:
                    "/FirstArticleDimension/SubmitDimension",

                type:
                    "POST",

                contentType:
                    "application/json",

                data:
                    JSON.stringify(model),


                success:
                    function (res) {

                        if (res.success) {

                            alert(
                                "Data Saved Successfully"
                            );

                            rowsToSave.forEach(function (x) {

                                x._htmlRow.fadeOut(
                                    300,
                                    function () {

                                        $(this).remove();

                                        refreshStationDisplay();

                                    }
                                );

                            });

                        }
                        else {

                            alert(
                                res.message ||
                                "Save Failed"
                            );

                        }

                    },


                error:
                    function () {

                        alert(
                            "Error while saving."
                        );

                    }

            });

        }

