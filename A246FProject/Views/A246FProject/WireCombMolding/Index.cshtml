@model A246FProject.Models.WireCombMoldingViewModel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CWCMMC CheckList</title>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins',sans-serif;
        }

        body {
            background: linear-gradient(135deg,#0d0d1a,#0a0a2e,#0d1b2a);
            min-height: 100vh;
            color: #e2e8f0;
            padding: 20px;
        }

        /* CARD */

        .form-card {
            background: rgba(255,255,255,.04);
            border: 1px solid rgba(255,255,255,.08);
            border-radius: 16px;
            overflow: hidden;
            margin-bottom: 20px;
        }

        .form-card-header {
            background: rgba(167,139,250,.12);
            border-bottom: 1px solid rgba(167,139,250,.2);
            padding: 14px 22px;
            font-size: 16px;
            font-weight: 600;
            color: #fff;
        }

        .form-body {
            padding: 22px;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .form-row {
            display: grid;
            grid-template-columns: repeat(3,1fr);
            gap: 14px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
        }

        label {
            font-size: 11px;
            color: rgba(255,255,255,.45);
            margin-bottom: 6px;
        }

        input,
        select {
            background: rgba(255,255,255,.06);
            border: 1px solid rgba(255,255,255,.12);
            border-radius: 8px;
            padding: 10px 12px;
            font-size: 13px;
            color: #fff;
            outline: none;
        }

            input::placeholder {
                color: rgba(255,255,255,.35);
            }

            select option {
                background: #1a1040;
            }

            input:focus,
            select:focus {
                border-color: #a78bfa;
                background: rgba(167,139,250,.08);
            }

        /* BUTTONS */

        .btn-search {
            width: 100%;
            background: linear-gradient(135deg,#a78bfa,#7c3aed);
            border: none;
            border-radius: 8px;
            padding: 11px;
            color: #fff;
            cursor: pointer;
            font-size: 14px;
            font-weight: 500;
        }

        .btn-submit {
            background: linear-gradient(135deg,#60a5fa,#2563eb);
            border: none;
            border-radius: 8px;
            padding: 10px 24px;
            color: #fff;
            cursor: pointer;
            font-size: 13px;
        }

        .results-table {
            background: rgba(255,255,255,.04);
            border: 1px solid rgba(255,255,255,.08);
            border-radius: 16px;
            overflow: hidden;
        }

            .custom-table tbody td {
                font-size: 14px;
                font-weight: 500;
            }

            .custom-table thead th {
                font-size: 14px;
                font-weight: 600;
            }

            .custom-table tbody td input {
                height: 34px;
                font-size: 14px;
            }
        .table-scroll {
            overflow-x: auto;
            width: 100%;
        }

        .custom-table {
            font-size: 14px;
            width: 100%;
            min-width: 1500px;
            border-collapse: collapse;
        }

            .custom-table td:nth-child(2) {
                white-space: normal;
                word-break: break-word;
                overflow-wrap: break-word;
                line-height: 16px;
                text-align: left;
            }

            .custom-table td:nth-child(3) {
                white-space: normal;
                word-break: break-word;
                overflow-wrap: break-word;
            }

            .custom-table th:nth-child(1),
            .custom-table td:nth-child(1) {
                width: 80px;
            }

            .custom-table th:nth-child(2),
            .custom-table td:nth-child(2) {
                width: 220px;
            }

            .custom-table th:nth-child(3),
            .custom-table td:nth-child(3) {
                width: 180px;
            }

            .custom-table th:nth-child(4),
            .custom-table td:nth-child(4) {
                width: 120px;
            }

            .custom-table th:nth-child(5),
            .custom-table td:nth-child(5) {
                width: 80px;
            }

            .custom-table th:nth-child(6),
            .custom-table td:nth-child(6),
            .custom-table th:nth-child(7),
            .custom-table td:nth-child(7),
            .custom-table th:nth-child(8),
            .custom-table td:nth-child(8),
            .custom-table th:nth-child(9),
            .custom-table td:nth-child(9),
            .custom-table th:nth-child(10),
            .custom-table td:nth-child(10) {
                width: 100px;
            }

            .custom-table th:nth-child(11),
            .custom-table td:nth-child(11) {
                width: 200px;
            }

        .CableSerialNo {
            width: 180px !important;
            min-width: 180px;
        }

            .custom-table th:nth-child(12),
            .custom-table td:nth-child(12) {
                width: 100px;
            }

            .custom-table thead {
                background: rgba(167,139,250,.08);
            }

                .custom-table thead th {
                    padding: 14px 12px;
                    text-align: left;
                    font-size: 12px;
                    font-weight: 600;
                    color: rgba(255,255,255,.75);
                    border-bottom: 1px solid rgba(255,255,255,.08);
                    white-space: nowrap;
                }

            .custom-table tbody td {
                padding: 8px 12px;
                text-align: left;
                color: #e2e8f0;
                border-top: 1px solid rgba(255,255,255,.05);
                font-size: 13px;
                font-weight: 400;
                line-height: 16px;
                vertical-align: middle;
            }

                .custom-table tbody td input {
                    width: 85px;
                    height: 34px;
                    font-size: 13px;
                }

        .empty-row {
            height: 100px;
            color: rgba(255,255,255,.25);
            font-size: 13px;
        }

        .actions {
            margin-top: 16px;
        }

        @@media(max - width:900px) {
            .form-row

        {
            grid-template-columns: 1fr;
        }

        }


        .ng-row {
            background: rgba(220, 53, 69, 0.20) !important;
            border-left: 4px solid #dc3545 !important;
        }

            .ng-row td {
                background: rgba(220, 53, 69, 0.08) !important;
                color: #ff8080 !important;
            }

        .ng-input {
            border: 2px solid #dc3545 !important;
            background: rgba(220, 53, 69, 0.18) !important;
            color: #ff8080 !important;
        }
    </style>
</head>

<body>

<form asp-action="Index" method="post">

    <div class="form-card">

        <div class="form-card-header">
            Wire Comb Molding CheckList
        </div>

        <div class="form-body">

            <div class="form-row">

                <div class="form-group">
                    <label>Line</label>
                    <select asp-for="LineId"
                            id="LineId"
                            asp-items="@(new SelectList(Model.Lines,
                                    "LineId",
                                    "LineName"))">
                        <option value="">-- Select Line --</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Project</label>
                    <select asp-for="ProjectId"
                            id="ProjectId"
                            asp-items="@(new SelectList(Model.Projects,
                                    "ProjectId",
                                    "ProjectName"))">
                        <option value="">-- Select Project --</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Model</label>
                    <select asp-for="ModelId"
                            id="ModelId"
                            asp-items="@(new SelectList(Model.ModelNos,
                                    "ModelId",
                                    "Model"))">
                        <option value="">-- Select Model --</option>
                    </select>
                </div>

            </div>

            <div class="form-row">

                <div class="form-group">
                    <label>Part</label>
                    <select asp-for="PartId"
                            id="PartId"
                            asp-items="@(new SelectList(Model.PartNos,
                                    "PartId",
                                    "Part"))">
                        <option value="">-- Select Part --</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Machine</label>
                    <select asp-for="MachineId"
                            id="MachineId"
                            asp-items="@(new SelectList(Model.Machines,
                                    "MachineId",
                                    "Machine"))">
                        <option value="">-- Select Machine --</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Production Line Leader</label>
                        <input asp-for="ProdLineLeader" id="ProdLineLeader" />
                </div>

            </div>

            <div class="form-row">

                <div class="form-group">
                    <label>Checked By</label>
                        <input asp-for="CheckedBy" id="CheckedBy" />
                </div>

                <div class="form-group">
                    <label>Approved By</label>
                        <input asp-for="ApprovedBy" id="ApprovedBy" />
                </div>

                <div class="form-group"
                     style="justify-content:flex-end;">

                    <label style="visibility:hidden;">
                        Search
                    </label>

                    <button type="submit"
                            class="btn-search" >
                        Search
                    </button>

                </div>

            </div>

        </div>

    </div>

</form>

    @if (ViewBag.Message != null)
    {
        <div style="
    background:#dc3545;
    color:white;
    padding:10px;
    border-radius:8px;
    margin:10px 0;">

            @ViewBag.Message

        </div>
    }

    <!-- TABLE -->

    <div class="results-table">

        <div class="table-scroll">

            <table class="custom-table">

                <thead>

                    <tr>
                        <th>Work Station</th>
                        <th>Inspection Project</th>
                        <th>Inspection Specifications</th>
                        <th>Frequency</th>
                        <th>section</th>
                        <th>Value1</th>
                        <th>Value2</th>
                        <th>Value3</th>
                        <th>Value4</th>
                        <th>Value5</th>
                        <th>Cables Serial Number</th>
                        <th>Save</th>
                    </tr>

                </thead>

                <tbody id="body">

                    @if (Model.dtChecklist != null &&
                    Model.dtChecklist.Rows.Count > 0)
                    {
                        foreach (System.Data.DataRow row in Model.dtChecklist.Rows)
                        {
                            <tr class="row">

                                <td>@row["WorkStation"]</td>

                                <td>@row["InspectionProject"]</td>

                                <td>
                                    @row["InspectionSpecifications"]

                                    <input type="hidden"
                                           class="InspectionSpecifications"
                                           value="@row["InspectionSpecifications"]" />
                                </td>

                                <td>@row["Frequency"]</td>

                                <td>
                                    @row["Section"]

                                    <input type="hidden"
                                           class="SectionId"
                                           value="@row["SectionId"]" />
                                </td>

                                <td><input type="text" class="Value1" /></td>
                                <td><input type="text" class="Value2" /></td>
                                <td><input type="text" class="Value3" /></td>
                                <td><input type="text" class="Value4" /></td>
                                <td><input type="text" class="Value5" /></td>

                                <td>
                                    <input type="text"
                                           class="CableSerialNo" />
                                </td>

                                <td>
                                    <button type="button"
                                            class="btn-search btnRowSave">
                                        Save
                                    </button>
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="12" class="empty-row">
                                No records found. Click Search.
                            </td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>

    </div>

    <div class="actions">
        <button type="button" class="btn-submit">
            Submit
        </button>
    </div>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>
                $("#ProjectId").change(function () {

            var projectId = $(this).val();

            $.ajax({
                url: '/WireCombMolding/GetModelNoByProject',
                type: 'POST',
                data: { projectId: projectId },

                success: function (data) {

                    $("#ModelId").empty();

                    $("#ModelId").append(
                        '<option value="">-- Select Model --</option>'
                    );

                    $.each(data, function (i, item) {

                        $("#ModelId").append(
                            '<option value="' +
                            item.modelId +
                            '">' +
                            item.model +
                            '</option>'
                        );
                    });
                }
            });
        });

        $("#ModelId").change(function () {

            var modelId = $(this).val();

            $.ajax({
                url: '/WireCombMolding/GetPartNoByModel',
                type: 'POST',
                data: { modelId: modelId },

                success: function (data) {

                    $("#PartId").empty();

                    $("#PartId").append(
                        '<option value="">-- Select Part --</option>'
                    );

                    $.each(data, function (i, item) {

                        $("#PartId").append(
                            '<option value="' +
                            item.partId +
                            '">' +
                            item.part +
                            '</option>'
                        );
                    });
                }
            });
        });
    </script>
    
    <script>

                function getSpecificationRange(specification) {

            if (!specification) {
                return null;
            }

            specification = $.trim(specification)
                .replace(/,/g, "")
                .replace(/\s+/g, " ");

            // ==========================
            // 1. PLUS / MINUS
            // Example:
            // 10 ± 2
            // 10+/-2
            // ==========================

            var plusMinusMatch = specification.match(
                /(-?\d+(?:\.\d+)?)\s*(?:±|\+\/-)\s*(\d+(?:\.\d+)?)/
            );

            if (plusMinusMatch) {

                var target = parseFloat(plusMinusMatch[1]);
                var tolerance = parseFloat(plusMinusMatch[2]);

                return {
                    min: target - tolerance,
                    max: target + tolerance
                };
            }


            // ==========================
            // 2. BETWEEN RANGE
            // Examples:
            // 10 - 20
            // 10~20
            // 10 to 20
            // ==========================

            var rangeMatch = specification.match(
                /(-?\d+(?:\.\d+)?)\s*(?:-|~|to)\s*(-?\d+(?:\.\d+)?)/
            );

            if (rangeMatch) {

                var minValue = parseFloat(rangeMatch[1]);
                var maxValue = parseFloat(rangeMatch[2]);

                return {
                    min: Math.min(minValue, maxValue),
                    max: Math.max(minValue, maxValue)
                };
            }


            // ==========================
            // 3. GREATER THAN OR EQUAL
            // Examples:
            // ≥ 10
            // >= 10
            // ==========================

            var greaterEqualMatch = specification.match(
                /(?:≥|>=)\s*(-?\d+(?:\.\d+)?)/
            );

            if (greaterEqualMatch) {

                return {
                    min: parseFloat(greaterEqualMatch[1]),
                    max: Infinity
                };
            }


            // ==========================
            // 4. GREATER THAN
            // Example:
            // > 10
            // ==========================

            var greaterMatch = specification.match(
                />\s*(-?\d+(?:\.\d+)?)/
            );

            if (greaterMatch) {

                return {
                    min: parseFloat(greaterMatch[1]),
                    max: Infinity,
                    exclusiveMin: true
                };
            }


            // ==========================
            // 5. LESS THAN OR EQUAL
            // Examples:
            // ≤ 10
            // <= 10
            // ==========================

            var lessEqualMatch = specification.match(
                /(?:≤|<=)\s*(-?\d+(?:\.\d+)?)/
            );

            if (lessEqualMatch) {

                return {
                    min: -Infinity,
                    max: parseFloat(lessEqualMatch[1])
                };
            }


            // ==========================
            // 6. LESS THAN
            // Example:
            // < 10
            // ==========================

            var lessMatch = specification.match(
                /<\s*(-?\d+(?:\.\d+)?)/
            );

            if (lessMatch) {

                return {
                    min: -Infinity,
                    max: parseFloat(lessMatch[1]),
                    exclusiveMax: true
                };
            }


            // ==========================
            // 7. EXACT NUMERIC VALUE
            // Example:
            // 10
            // ==========================

            var exactMatch = specification.match(
                /^(-?\d+(?:\.\d+)?)$/
            );

            if (exactMatch) {

                var exactValue = parseFloat(exactMatch[1]);

                return {
                    min: exactValue,
                    max: exactValue,
                    exact: true
                };
            }


            return null;
        }

        function validateSingleValue(value, specification) {

            value = $.trim(value);

            // Empty values are allowed
            if (value === "") {

                return {
                    valid: true,
                    message: ""
                };
            }


            // NG is always invalid
            if (value.toUpperCase() === "NG") {

                return {
                    valid: false,
                    message: "NG value is not allowed"
                };
            }


            // Convert input to number
            var numericValue = Number(value);


            if (isNaN(numericValue)) {

                return {
                    valid: false,
                    message: "Please enter a valid numeric value"
                };
            }


            // Get range from Inspection Specifications
            var range = getSpecificationRange(specification);


            // IMPORTANT:
            // If specification cannot be understood,
            // do not automatically allow the value.
            if (!range) {

                return {
                    valid: false,
                    message:
                        "Unable to validate this Inspection Specification: " +
                        specification
                };
            }


            // ==========================
            // EXACT VALUE
            // ==========================

            if (range.exact === true) {

                if (numericValue !== range.min) {

                    return {
                        valid: false,
                        message:
                            "Value must be exactly " +
                            range.min
                    };
                }

                return {
                    valid: true,
                    message: ""
                };
            }


            // ==========================
            // GREATER THAN (>)
            // ==========================

            if (range.exclusiveMin === true) {

                if (numericValue <= range.min) {

                    return {
                        valid: false,
                        message:
                            "Value must be greater than " +
                            range.min
                    };
                }
            }


            // ==========================
            // LESS THAN (<)
            // ==========================

            if (range.exclusiveMax === true) {

                if (numericValue >= range.max) {

                    return {
                        valid: false,
                        message:
                            "Value must be less than " +
                            range.max
                    };
                }
            }


            // ==========================
            // NORMAL RANGE VALIDATION
            // ==========================

            if (
                numericValue < range.min ||
                numericValue > range.max
            ) {

                var message = "";


                if (
                    range.min !== -Infinity &&
                    range.max !== Infinity
                ) {

                    message =
                        "Value must be between " +
                        range.min +
                        " and " +
                        range.max;
                }
                else if (range.min !== -Infinity) {

                    message =
                        "Value must be greater than or equal to " +
                        range.min;
                }
                else if (range.max !== Infinity) {

                    message =
                        "Value must be less than or equal to " +
                        range.max;
                }


                return {
                    valid: false,
                    message: message
                };
            }


            return {
                valid: true,
                message: ""
            };
        }

        function validateRow(row) {

            var specification = $.trim(
                row.find(".InspectionSpecifications").val()
            );


            var values = [

                {
                    name: "Value1",
                    input: row.find(".Value1")
                },

                {
                    name: "Value2",
                    input: row.find(".Value2")
                },

                {
                    name: "Value3",
                    input: row.find(".Value3")
                },

                {
                    name: "Value4",
                    input: row.find(".Value4")
                },

                {
                    name: "Value5",
                    input: row.find(".Value5")
                }

            ];


            var invalidValues = [];

            row.removeClass("ng-row");

            row.find(
                ".Value1, .Value2, .Value3, .Value4, .Value5"
            ).removeClass("ng-input");


            values.forEach(function (item) {

                var inputValue = $.trim(item.input.val());

                if (inputValue !== "") {

                    var result = validateSingleValue(
                        inputValue,
                        specification
                    );


                    if (!result.valid) {

                        invalidValues.push(
                            item.name +
                            " = " +
                            inputValue +
                            " (" +
                            result.message +
                            ")"
                        );

                        item.input.addClass("ng-input");
                    }
                }

            });


            if (invalidValues.length > 0) {

                row.addClass("ng-row");

                return {
                    valid: false,
                    message: invalidValues.join("\n")
                };
            }


            return {
                valid: true,
                message: ""
            };
        }


        $(document).on(
            "input change",
            ".Value1, .Value2, .Value3, .Value4, .Value5",
            function () {

                var row = $(this).closest("tr.row");

                validateRow(row);
            }
        );


        $(document).on("click", ".btnRowSave", function () {

            let clickedRow = $(this).closest("tr.row");

            let rowsToSave = [];

            let validationErrors = [];


            $("#body tr.row").each(function () {

                let row = $(this);

                let sectionId = row.find(".SectionId").val();

                let value1 = $.trim(row.find(".Value1").val());
                let value2 = $.trim(row.find(".Value2").val());
                let value3 = $.trim(row.find(".Value3").val());
                let value4 = $.trim(row.find(".Value4").val());
                let value5 = $.trim(row.find(".Value5").val());

                let cableSerialNo =
                    $.trim(row.find(".CableSerialNo").val());


                let hasValue =
                    value1 !== "" ||
                    value2 !== "" ||
                    value3 !== "" ||
                    value4 !== "" ||
                    value5 !== "" ||
                    cableSerialNo !== "";

                if (hasValue) {

                    let validationResult = validateRow(row);

                    if (!validationResult.valid) {

                        let sectionName = row.find("td:eq(4)")
                            .clone()
                            .children()
                            .remove()
                            .end()
                            .text()
                            .trim();


                        validationErrors.push(
                            "Section: " +
                            sectionName +
                            "\n" +
                            validationResult.message
                        );
                    }
                }


                if (sectionId && hasValue) {

                    rowsToSave.push({

                        SectionId: parseInt(sectionId) || 0,

                        Value1:
                            value1 === ""
                                ? null
                                : value1,

                        Value2:
                            value2 === ""
                                ? null
                                : value2,

                        Value3:
                            value3 === ""
                                ? null
                                : value3,

                        Value4:
                            value4 === ""
                                ? null
                                : value4,

                        Value5:
                            value5 === ""
                                ? null
                                : value5,

                        CablesSerialNumber:
                            cableSerialNo === ""
                                ? null
                                : cableSerialNo,

                        _htmlRow: row
                    });
                }

                if (row[0] === clickedRow[0]) {

                    return false;
                }

            });


            if (validationErrors.length > 0) {

                alert(
                    "❌ NG / Invalid values found.\n\n" +
                    validationErrors.join("\n\n")
                );

                return;
            }



            if (rowsToSave.length === 0) {

                alert(
                    "Please enter at least one value before saving."
                );

                return;
            }



            let resultList = rowsToSave.map(function (x) {

                return {

                    SectionId: x.SectionId,

                    Value1: x.Value1,

                    Value2: x.Value2,

                    Value3: x.Value3,

                    Value4: x.Value4,

                    Value5: x.Value5,

                    CablesSerialNumber:
                        x.CablesSerialNumber
                };

            });



            let data = {

                LineId:
                    parseInt($("#LineId").val()) || 0,

                ProjectId:
                    parseInt($("#ProjectId").val()) || 0,

                ModelId:
                    parseInt($("#ModelId").val()) || 0,

                PartId:
                    parseInt($("#PartId").val()) || 0,

                MachineId:
                    parseInt($("#MachineId").val()) || 0,

                ProdLineLeader:
                    $("#ProdLineLeader").val(),

                CheckedBy:
                    $("#CheckedBy").val(),

                ApprovedBy:
                    $("#ApprovedBy").val(),

                WireCombMoldingResults:
                    resultList
            };



            $.ajax({

                url: '/WireCombMolding/SaveA246FWCMMCCheckList',

                type: 'POST',

                contentType:
                    'application/json; charset=utf-8',

                data:
                    JSON.stringify(data),


                success: function (response) {

                    if (
                        response &&
                        response.success === false
                    ) {

                        alert(
                            response.message ||
                            "Error while saving."
                        );

                        return;
                    }


                    alert("Data Saved Successfully");


                    rowsToSave.forEach(function (x) {

                        x._htmlRow.remove();

                    });


                    if (
                        $("#body tr.row").length === 0
                    ) {

                        $("#body").html(`
                            <tr>
                                <td colspan="12"
                                    class="empty-row">
                                    No records found.
                                </td>
                            </tr>
                        `);
                    }

                },


                error: function () {

                    alert(
                        "Server Error while saving."
                    );

                }

            });

        });


        $(document).on(
            "click",
            ".btn-submit",
            function (e) {

                e.preventDefault();


                var results = [];

                var validationErrors = [];


                $("#body tr.row").each(function () {

                    var row = $(this);


                    var value1 =
                        $.trim(row.find(".Value1").val());

                    var value2 =
                        $.trim(row.find(".Value2").val());

                    var value3 =
                        $.trim(row.find(".Value3").val());

                    var value4 =
                        $.trim(row.find(".Value4").val());

                    var value5 =
                        $.trim(row.find(".Value5").val());


                    var cableSerialNo =
                        $.trim(
                            row.find(".CableSerialNo").val()
                        );


                    var hasValue =
                        value1 !== "" ||
                        value2 !== "" ||
                        value3 !== "" ||
                        value4 !== "" ||
                        value5 !== "" ||
                        cableSerialNo !== "";


                    if (!hasValue) {

                        return;
                    }

                    var validationResult =
                        validateRow(row);


                    if (!validationResult.valid) {

                        var sectionName =
                            row.find("td:eq(4)")
                                .clone()
                                .children()
                                .remove()
                                .end()
                                .text()
                                .trim();


                        validationErrors.push(
                            "Section: " +
                            sectionName +
                            "\n" +
                            validationResult.message
                        );

                        return;
                    }


                    results.push({

                        SectionId:
                            parseInt(
                                row.find(".SectionId").val()
                            ) || 0,

                        Value1:
                            value1 === ""
                                ? null
                                : value1,

                        Value2:
                            value2 === ""
                                ? null
                                : value2,

                        Value3:
                            value3 === ""
                                ? null
                                : value3,

                        Value4:
                            value4 === ""
                                ? null
                                : value4,

                        Value5:
                            value5 === ""
                                ? null
                                : value5,

                        CablesSerialNumber:
                            cableSerialNo === ""
                                ? null
                                : cableSerialNo
                    });

                });


                if (validationErrors.length > 0) {

                    alert(
                        "❌ Cannot submit because NG / Invalid values were found.\n\n" +
                        validationErrors.join("\n\n")
                    );

                    return;
                }



                if (results.length === 0) {

                    alert(
                        "Please enter at least one value before submitting."
                    );

                    return;
                }



                var model = {

                    LineId:
                        parseInt($("#LineId").val()) || 0,

                    ProjectId:
                        parseInt($("#ProjectId").val()) || 0,

                    ModelId:
                        parseInt($("#ModelId").val()) || 0,

                    PartId:
                        parseInt($("#PartId").val()) || 0,

                    MachineId:
                        parseInt($("#MachineId").val()) || 0,

                    ProdLineLeader:
                        $("#ProdLineLeader").val(),

                    CheckedBy:
                        $("#CheckedBy").val(),

                    ApprovedBy:
                        $("#ApprovedBy").val(),

                    WireCombMoldingResults:
                        results
                };



                $.ajax({

                    url:
                        '/WireCombMolding/SaveA246FWCMMCCheckList',

                    type:
                        'POST',

                    contentType:
                        'application/json; charset=utf-8',

                    data:
                        JSON.stringify(model),


                    success: function (response) {

                        if (
                            response &&
                            response.success === false
                        ) {

                            alert(
                                response.message ||
                                "Save Failed"
                            );

                            return;
                        }


                        alert(
                            "All Records Saved Successfully"
                        );


                        $(".Value1").val("");
                        $(".Value2").val("");
                        $(".Value3").val("");
                        $(".Value4").val("");
                        $(".Value5").val("");
                        $(".CableSerialNo").val("");

                    },


                    error: function () {

                        alert("Save Failed");

                    }

                });

            }
        );
    </script>
</body>
</html>