@model A246FProject.Models.SOPPORViewModel
@using System.Data
@using Microsoft.AspNetCore.Mvc.Rendering
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SOP/POR</title>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Poppins, sans-serif;
        }

        body {
            background: linear-gradient(135deg, #0d0d1a, #0a0a2e, #0d1b2a);
            min-height: 100vh;
            color: #e2e8f0;
            padding: 20px;
        }

        h1 {
            font-size: 22px;
            font-weight: 600;
            color: #fff;
            margin-bottom: 4px;
        }

        .sub {
            color: rgba(255,255,255,.4);
            font-size: 13px;
            margin-bottom: 18px;
        }

        /* FORM CARD */
        .form-card {
            background: rgba(255,255,255,.04);
            border: 0.5px solid rgba(255,255,255,.08);
            border-radius: 16px;
            overflow: hidden;
            margin-bottom: 16px;
        }

        .form-card-header {
            background: rgba(167,139,250,.12);
            border-bottom: 0.5px solid rgba(167,139,250,.2);
            padding: 14px 22px;
            font-size: 15px;
            font-weight: 600;
            color: #fff;
        }

        .form-body {
            padding: 22px;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .form-row {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 14px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        label {
            font-size: 11px;
            color: rgba(255,255,255,.45);
        }

        input, select {
            background: rgba(255,255,255,.06);
            border: 0.5px solid rgba(255,255,255,.12);
            border-radius: 8px;
            padding: 9px 12px;
            font-size: 13px;
            color: #fff;
            outline: none;
        }

            select option {
                background: #1a1040;
            }

            input:focus, select:focus {
                border-color: rgba(167,139,250,.5);
                background: rgba(167,139,250,.08);
            }

        .custom-table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
        }

            .custom-table th {
                background: rgba(167,139,250,.12);
                color: #fff;
                padding: 12px;
                font-size: 12px;
                text-align: left;
                border-bottom: 1px solid rgba(255,255,255,.1);
            }

            .custom-table td {
                padding: 10px;
                font-size: 12px;
                color: #fff;
                border-bottom: 1px solid rgba(255,255,255,.06);
                vertical-align: top;
                word-wrap: break-word;
            }

            .custom-table select,
            .custom-table input {
                width: 100%;
                font-size: 12px;
                border-radius: 4px;
            }

                .custom-table input[type="file"] {
                    font-size: 11px;
                }

            .custom-table td {
                white-space: normal;
            }

                .custom-table td[rowspan] {
                    vertical-align: top;
                    font-weight: 500;
                }

                .custom-table th:nth-child(1),
                .custom-table td:nth-child(1) {
                    width: 80px;
                }

                .custom-table th:nth-child(2),
                .custom-table td:nth-child(2) {
                    width: 200px;
                }

                .custom-table th:nth-child(3),
                .custom-table td:nth-child(3) {
                    width: 250px;
                }

                .custom-table th:nth-child(4),
                .custom-table td:nth-child(4) {
                    width: 100px;
                }

                .custom-table th:nth-child(5),
                .custom-table td:nth-child(5) {
                    width: 100px;
                }

                .custom-table th:nth-child(6),
                .custom-table td:nth-child(6) {
                    width: 120px;
                }

                .custom-table th:nth-child(7),
                .custom-table td:nth-child(7) {
                    width: 120px;
                }

                .custom-table th:nth-child(8),
                .custom-table td:nth-child(8) {
                    width: 140px;
                }

                .custom-table th:nth-child(9),
                .custom-table td:nth-child(9) {
                    width: 120px;
                }

        /* BUTTON */
        .btn-search {
            background: linear-gradient(135deg, #a78bfa, #7c3aed);
            border: none;
            border-radius: 8px;
            padding: 10px 20px;
            color: #fff;
            cursor: pointer;
            font-size: 13px;
        }

        .btn-submit {
            background: linear-gradient(135deg, #60a5fa, #2563eb);
            border: none;
            border-radius: 8px;
            padding: 10px 24px;
            color: #fff;
            cursor: pointer;
            font-size: 13px;
        }

        /* TABLE */
        .results-table {
            background: rgba(255,255,255,.04);
            border: 0.5px solid rgba(255,255,255,.08);
            border-radius: 16px;
            overflow: hidden;
        }

        .header-row {
            display: grid;
            grid-template-columns: repeat(9, 1fr);
            background: rgba(167,139,250,.08);
            padding: 12px;
            font-size: 11px;
            color: rgba(255,255,255,.45);
        }

        .empty {
            padding: 40px;
            text-align: center;
            color: rgba(255,255,255,.25);
            font-size: 13px;
        }

        .actions {
            margin-top: 16px;
        }

        @@media (max-width: 900px) {
            .form-row {
                grid-template-columns: 1fr;
            }

            .header-row {
                grid-template-columns: repeat(3, 1fr);
                gap: 10px;
            }
        }

        /* NG ROW */
        .ng-row {
            background: rgba(220, 53, 69, 0.18) !important;
            border-left: 4px solid #dc3545 !important;
        }

            .ng-row td {
                background: rgba(220, 53, 69, 0.18) !important;
                color: #ff6b6b !important;
            }

            .ng-row select,
            .ng-row input {
                border: 1px solid #dc3545 !important;
                background: rgba(220, 53, 69, 0.12) !important;
                color: #ff6b6b !important;
            }
    </style>
</head>

<body>

    <form asp-action="Index" asp-controller="SOPPOR" method="post" enctype="multipart/form-data">

        <div class="form-card">

            <div class="form-card-header">
                SOP/POR checklist
            </div>

            <div class="form-body">

                <div class="form-row">

                    <div class="form-group">

                        <label>Line</label>

                        <select asp-for="LineId"
                                asp-items="@(new SelectList(Model.Lines, "LineId", "LineName"))">

                            <option value="">-- Select Line --</option>

                        </select>

                    </div>

                    <div class="form-group">

                        <label>Project</label>

                        <select asp-for="ProjectId"
                                id="ProjectId">

                            <option value="">-- Select Project --</option>

                            @foreach (var item in Model.Projects)

                            {
                                <option value="@item.ProjectId">
                                    @item.ProjectName
                                </option>
                            }

                        </select>

                    </div>

                    <div class="form-group">

                        <label>Model</label>

                        <select asp-for="ModelId"
                                id="ModelId">

                            <option value="">-- Select Model --</option>

                        </select>

                    </div>

                </div>

                <div class="form-row">

                    <div class="form-group">

                        <label>Part</label>

                        <select asp-for="PartId"
                                id="PartId">

                            <option value="">-- Select Part --</option>

                        </select>

                    </div>

                    <div class="form-group">

                        <label>Line Leader</label>

                        <input asp-for="ProdLineLeader" id="ProdLineLeader" />

                    </div>

                    <div class="form-group">

                        <label>Checked By</label>

                        <input asp-for="CheckedBy" id="CheckedBy" />

                    </div>

                </div>

                <div class="form-row">

                    <div class="form-group">

                        <label>Approved By</label>

                        <input asp-for="ApprovedBy" id="ApprovedBy" />

                    </div>

                    <div class="form-group">
                    </div>

                    <div class="form-group"
                         style="justify-content:flex-end;">

                        <button type="submit"
                                class="btn-search">

                            Search

                        </button>

                    </div>

                </div>

            </div>

        </div>

        @if (ViewBag.Message != null)
        {
            <div style="
                background:#dc3545;
                color:white;
                padding:10px;
                border-radius:8px;
                margin:10px 0;">

                @ViewBag.Message

            </div>
        }

        <div class="results-table">

            <table class="custom-table">

                <thead>

                    <tr>

                        <th>Process No</th>

                        <th>Station Name</th>

                        <th>Critical Check Points</th>

                        <th>Sampling Frequency</th>

                        <th>Responsible Department</th>

                        <th>Status</th>

                        <th>ID Number</th>

                        <th>Upload</th>

                        <th>Action</th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model.dtChecklist != null && Model.dtChecklist.Rows.Count > 0)
                    {
                        string currentModule = "";

                        @for (int i = 0; i < Model.dtChecklist.Rows.Count; i++)
                        {
                            var item = Model.dtChecklist.Rows[i];

                            string moduleId = item["ModuleId"].ToString();
                            bool isFirstRow = moduleId != currentModule;

                            int rowSpan = 0;

                            if (isFirstRow)
                            {
                                currentModule = moduleId;

                                for (int j = i; j < Model.dtChecklist.Rows.Count; j++)
                                {
                                    if (Model.dtChecklist.Rows[j]["ModuleId"].ToString() == moduleId)
                                    {
                                        rowSpan++;
                                    }
                                    else
                                    {
                                        break;
                                    }
                                }
                            }

                            <tr>
                                <input type="hidden"
                                       name="SOPPORResults[@i].RiskId"
                                       value="@item["RiskId"]" />
                                @if (isFirstRow)
                                {
                                    <td rowspan="@rowSpan">
                                        @item["ProcessNo"]
                                    </td>

                                    <td rowspan="@rowSpan">
                                        @item["Module"]
                                    </td>
                                }

                                @* NORMAL COLUMNS *@
                                <td>
                                    @item["Points"]
                                </td>

                                <td>
                                    @item["SamplingUnits"]
                                </td>

                                <td>
                                    @item["Dept"]
                                </td>

                                <td>
                                    <select class="form-control"
                                            name="SOPPORResults[@i].StatusId">

                                        <option value="">--Select--</option>

                                        @foreach (var status in Model.Statuses)
                                        {
                                            <option value="@status.StatusId">
                                                @status.Status
                                            </option>
                                        }
                                    </select>
                                </td>

                                <td>
                                    <input type="text"
                                           class="form-control"
                                           name="SOPPORResults[@i].IdNumber"
                                           placeholder="Enter ID" />
                                </td>

                                <td>
                                    <input class="form-control" type="file" id="FileUpload1-@i" />
                                </td>

                                <td>
                                    <button type="button"
                                            class="btn-search"
                                            onclick="SaveSingleRow(this,@i)">
                                        Save
                                    </button>
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9"
                                style="text-align:center;padding:30px;">
                                No records found. 
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

        <div class="actions">

            <button type="button"
                    class="btn-submit"
                    onclick="Save()">
                Submit
            </button>

        </div>

    </form>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <script>

        $("#ProjectId").change(function () {

            var projectId = $(this).val();

            $.get('/SOPPOR/GetModels',
                { projectId: projectId },

                function (data) {

                    $("#ModelId").empty();

                    $("#ModelId").append(
                        '<option value="">-- Select Model --</option>');

                    $.each(data, function (i, item) {

                        $("#ModelId").append(
                            '<option value="' +
                            item.modelId +
                            '">' +
                            item.model +
                            '</option>');
                    });
                });
        });

        $("#ModelId").change(function () {

            var modelId = $(this).val();

            $.get('/SOPPOR/GetParts',
                { modelId: modelId },

                function (data) {

                    $("#PartId").empty();

                    $("#PartId").append(
                        '<option value="">-- Select Part --</option>');

                    $.each(data, function (i, item) {

                        $("#PartId").append(
                            '<option value="' +
                            item.partId +
                            '">' +
                            item.part +
                            '</option>');
                    });
                });
        });

        $(document).ready(function () {
            var postedProjectId = "@Model.ProjectId";
            var postedModelId = "@Model.ModelId";
            var postedPartId = "@Model.PartId";

            if (postedProjectId && postedProjectId !== "0") {
                $.get('/SOPPOR/GetModels', { projectId: postedProjectId }, function (data) {
                    $("#ModelId").empty();
                    $("#ModelId").append('<option value="">-- Select Model --</option>');

                    $.each(data, function (i, item) {
                        var selected = (item.modelId == postedModelId) ? 'selected="selected"' : '';
                        $("#ModelId").append(
                            '<option value="' + item.modelId + '" ' + selected + '>' + item.model + '</option>'
                        );
                    });

                    if (postedModelId && postedModelId !== "0") {
                        $.get('/SOPPOR/GetParts', { modelId: postedModelId }, function (partData) {
                            $("#PartId").empty();
                            $("#PartId").append('<option value="">-- Select Part --</option>');

                            $.each(partData, function (i, item) {
                                var selected = (item.partId == postedPartId) ? 'selected="selected"' : '';
                                $("#PartId").append(
                                    '<option value="' + item.partId + '" ' + selected + '>' + item.part + '</option>'
                                );
                            });
                        });
                    }
                });
            }
        });

        function validateHeader() {
            var LineId = $("#LineId").val();
            var ProjectId = $("#ProjectId").val();
            var ModelId = $("#ModelId").val();
            var PartId = $("#PartId").val();
            var ProdLineLeader = $("#ProdLineLeader").val();
            var CheckedBy = $("#CheckedBy").val();
            var ApprovedBy = $("#ApprovedBy").val();

            if (!LineId || LineId == "0" ||
                !ProjectId || ProjectId == "0" ||
                !ModelId || ModelId == "0" ||
                !PartId || PartId == "0" ||
                !ProdLineLeader || !CheckedBy || !ApprovedBy) {
                alert("Please fill Line, Project, Model, Part, Line Leader, Checked By and Approved By before saving.");
                return false;
            }
            return true;
        }

                function ValidateAllSOPPORRows()
        {
            var ngRecords = [];
            var hasEnteredRows = false;


            $("input[name$='.RiskId']").each(function(index)
            {
                var row = $(this).closest("tr");


                var statusId =
                    row.find(
                        "select[name='SOPPORResults[" +
                        index +
                        "].StatusId']"
                    ).val();


                var statusText =
                    row.find(
                        "select[name='SOPPORResults[" +
                        index +
                        "].StatusId'] option:selected"
                    ).text().trim();


                var idNumber =
                    row.find(
                        "input[name='SOPPORResults[" +
                        index +
                        "].IdNumber']"
                    ).val();

                if ((!statusId || statusId === "") &&
                    (!idNumber || idNumber.trim() === ""))
                {
                    return;
                }


                hasEnteredRows = true;


                if (statusText.toUpperCase() === "NG")
                {
                    row.addClass("ng-row");


                    ngRecords.push({
                        index: index + 1,
                        status: statusText,
                        idNumber: idNumber,
                        row: row
                    });
                }
                else
                {
                    row.removeClass("ng-row");
                }
            });


            if (!hasEnteredRows)
            {
                alert("No rows to save.");
                return false;
            }


            if (ngRecords.length === 0)
            {
                return true;
            }


            var message =
                ngRecords.length +
                " record(s) are marked as NG.\n\n";


            $.each(
                ngRecords,
                function(i, item)
                {
                    message +=
                        "Record " +
                        item.index +
                        " → " +
                        item.status;


                    if (item.idNumber &&
                        item.idNumber.trim() !== "")
                    {
                        message +=
                            " → ID: " +
                            item.idNumber;
                    }


                    message += "\n";
                }
            );


            message +=
                "\nDo you want to save these NG records?";


            var result =
                confirm(message);


            if (!result)
            {
                $.each(
                    ngRecords,
                    function(i, item)
                    {
                        item.row.addClass("ng-row");
                    }
                );


                return false;
            }

            $.each(
                ngRecords,
                function(i, item)
                {
                    item.row.removeClass("ng-row");
                }
            );


            return true;
        }

        function Save()
        {

            if (!validateHeader())
            {
                return;
            }

            if (!ValidateAllSOPPORRows())
            {
                return;
            }


            var formData =
                new FormData();


            formData.append(
                "LineId",
                $("#LineId").val()
            );

            formData.append(
                "ProjectId",
                $("#ProjectId").val()
            );

            formData.append(
                "ModelId",
                $("#ModelId").val()
            );

            formData.append(
                "PartId",
                $("#PartId").val()
            );

            formData.append(
                "ProdLineLeader",
                $("#ProdLineLeader").val()
            );

            formData.append(
                "CheckedBy",
                $("#CheckedBy").val()
            );

            formData.append(
                "ApprovedBy",
                $("#ApprovedBy").val()
            );

            var count = 0;

            $("input[name$='.RiskId']").each(function(index)
            {
                var riskId =
                    $("input[name='SOPPORResults[" +
                        index +
                        "].RiskId']").val();


                var statusId =
                    $("select[name='SOPPORResults[" +
                        index +
                        "].StatusId']").val();


                var idNumber =
                    $("input[name='SOPPORResults[" +
                        index +
                        "].IdNumber']").val();


                if ((statusId && statusId !== "") ||
                    (idNumber && idNumber.trim() !== ""))
                {
                    formData.append(
                        "SOPPORResults[" +
                        count +
                        "].RiskId",
                        riskId
                    );


                    formData.append(
                        "SOPPORResults[" +
                        count +
                        "].StatusId",
                        statusId
                    );


                    formData.append(
                        "SOPPORResults[" +
                        count +
                        "].IdNumber",
                        idNumber
                    );


                    var fileInput =
                        document.getElementById(
                            "FileUpload1-" + index
                        );


                    if (fileInput &&
                        fileInput.files.length > 0)
                    {
                        formData.append(
                            "SOPPORResults[" +
                            count +
                            "].ImageFile",
                            fileInput.files[0]
                        );
                    }


                    count++;
                }
            });


            if (count === 0)
            {
                alert("No rows to save.");

                return;
            }

            $.ajax({

                url:
                    '/SOPPOR/SaveBulkSOPPOR',

                type:
                    'POST',

                contentType:
                    false,

                processData:
                    false,

                data:
                    formData,

                success:
                    function(res)
                    {
                        alert(res);

                        location.reload();
                    },

                error:
                    function(xhr)
                    {
                        alert("Save Failed");
                    }
            });
        }


        function SaveSingleRow(btn, index)
        {

            if (!validateHeader())
            {
                return;
            }

            var clickedRow = $(btn).closest("tr");

            if (clickedRow.length === 0)
            {
                alert("Record not found.");
                return;
            }

            var ngRecords = [];
            var enteredRows = [];

            $("input[name$='.RiskId']").each(function(i)
            {
                var currentRow = $(this).closest("tr");

                var riskId = $(this).val();

                var statusId = currentRow.find(
                    "select[name='SOPPORResults[" + i + "].StatusId']"
                ).val();

                var idNumber = currentRow.find(
                    "input[name='SOPPORResults[" + i + "].IdNumber']"
                ).val();

                if (i > index)
                {
                    return;
                }

                if ((!statusId || statusId === "") &&
                    (!idNumber || idNumber.trim() === ""))
                {
                    return;
                }

                var statusText = currentRow.find(
                    "select[name='SOPPORResults[" + i + "].StatusId'] option:selected"
                ).text().trim();

                if (statusText.toUpperCase() === "NG")
                {
                    currentRow.addClass("ng-row");

                    ngRecords.push({
                        index: i + 1,
                        status: statusText,
                        idNumber: idNumber,
                        row: currentRow
                    });
                }
                else
                {
                    currentRow.removeClass("ng-row");
                }

                enteredRows.push({
                    originalIndex: i,
                    riskId: riskId,
                    statusId: statusId,
                    idNumber: idNumber,
                    row: currentRow
                });
            });

            if (enteredRows.length === 0)
            {
                alert("No entered records to save.");
                return;
            }

            if (ngRecords.length > 0)
            {
                var message =
                    ngRecords.length +
                    " record(s) are marked as NG.\n\n";

                $.each(
                    ngRecords,
                    function(i, item)
                    {
                        message +=
                            "Record " +
                            item.index +
                            " → " +
                            item.status;

                        if (item.idNumber &&
                            item.idNumber.trim() !== "")
                        {
                            message +=
                                " → ID: " +
                                item.idNumber;
                        }

                        message += "\n";
                    }
                );

                message +=
                    "\nDo you want to save these records?";


                if (!confirm(message))
                {

                    $.each(
                        ngRecords,
                        function(i, item)
                        {
                            item.row.addClass("ng-row");
                        }
                    );

                    return;
                }

                $.each(
                    ngRecords,
                    function(i, item)
                    {
                        item.row.removeClass("ng-row");
                    }
                );
            }

            var formData = new FormData();

            formData.append(
                "LineId",
                $("#LineId").val()
            );

            formData.append(
                "ProjectId",
                $("#ProjectId").val()
            );

            formData.append(
                "ModelId",
                $("#ModelId").val()
            );

            formData.append(
                "PartId",
                $("#PartId").val()
            );

            formData.append(
                "ProdLineLeader",
                $("#ProdLineLeader").val()
            );

            formData.append(
                "CheckedBy",
                $("#CheckedBy").val()
            );

            formData.append(
                "ApprovedBy",
                $("#ApprovedBy").val()
            );

            $.each(
                enteredRows,
                function(saveIndex, item)
                {

                    formData.append(
                        "SOPPORResults[" +
                        saveIndex +
                        "].RiskId",
                        item.riskId
                    );

                    formData.append(
                        "SOPPORResults[" +
                        saveIndex +
                        "].StatusId",
                        item.statusId
                    );

                    formData.append(
                        "SOPPORResults[" +
                        saveIndex +
                        "].IdNumber",
                        item.idNumber
                    );

                    var fileInput =
                        document.getElementById(
                            "FileUpload1-" +
                            item.originalIndex
                        );


                    if (fileInput &&
                        fileInput.files &&
                        fileInput.files.length > 0)
                    {
                        formData.append(
                            "SOPPORResults[" +
                            saveIndex +
                            "].ImageFile",
                            fileInput.files[0]
                        );
                    }
                }
            );

        $.ajax(
        {
            url: '/SOPPOR/SaveBulkSOPPOR',

            type: 'POST',

            contentType: false,

            processData: false,

            data: formData,

            success: function(res)
            {

                location.reload();
            },

            error: function(xhr)
            {
                console.log(xhr.responseText);

                alert(
                    "Save Failed.\n\n" +
                    xhr.responseText
                );
            }
        });

        }

    </script>

</body>
</html>