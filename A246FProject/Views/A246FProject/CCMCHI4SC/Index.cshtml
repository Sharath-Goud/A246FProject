@model A246FProject.Models.CCMCHI4SCViewModel
@using Microsoft.AspNetCore.Mvc.Rendering
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>CCMMC Checklist</title>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Poppins,sans-serif;
        }

        body {
            background: linear-gradient(135deg,#0d0d1a,#0a0a2e,#0d1b2a);
            padding: 20px;
            color: #fff;
        }

        /* CARD */
        .form-card {
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 14px;
            overflow: hidden;
        }

        .form-card-header {
            padding: 12px 18px;
            background: rgba(167,139,250,0.15);
            font-weight: 600;
            font-size: 15px;
        }

        /* FORM */
        .form-body {
            padding: 18px;
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        .form-row {
            display: grid;
            grid-template-columns: repeat(3,1fr);
            gap: 14px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        label {
            font-size: 11px;
            color: rgba(255,255,255,0.5);
        }

        input, select {
            background: rgba(255,255,255,.06);
            border: 0.5px solid rgba(255,255,255,.12);
            border-radius: 8px;
            padding: 9px 12px;
            font-size: 13px;
            color: #fff;
            outline: none;
        }

            select option {
                background: #1a1040;
            }

            input:focus, select:focus {
                border-color: rgba(167,139,250,.5);
                background: rgba(167,139,250,.08);
            }

        .btn-search {
            background: linear-gradient(135deg, #a78bfa, #7c3aed);
            border: none;
            border-radius: 8px;
            padding: 10px 20px;
            color: #fff;
            cursor: pointer;
            font-size: 13px;
        }

        .btn-submit {
            background: linear-gradient(135deg,#60a5fa,#2563eb);
            border: none;
            padding: 10px 20px;
            border-radius: 8px;
            color: #fff;
            cursor: pointer;
        }

        .table {
            margin-top: 18px;
            background: rgba(255,255,255,0.04);
            border-radius: 14px;
            overflow-x: auto;
            border: 1px solid rgba(255,255,255,0.08);
        }

        .table-header {
            display: grid;
            grid-template-columns: 80px 200px 150px 120px 80px 100px 100px 100px 100px 100px 90px;
            min-width: 1240px;
            padding: 12px;
            font-size: 13px;
            font-weight: 600;
            background: rgba(167,139,250,0.15);
        }

        .row {
            display: grid;
            grid-template-columns: 80px 200px 150px 120px 80px 100px 100px 100px 100px 100px 90px;
            min-width: 1240px;
            padding: 4px 12px;
            align-items: center;
            border-top: 1px solid rgba(255,255,255,0.05);
        }

            .table-header div,
            .row div {
                padding: 4px;
                word-break: break-word;
            }

            .row input {
                width: 85px;
                height: 34px;
                padding: 4px 8px;
            }

        .empty {
            padding: 30px;
            text-align: center;
            color: rgba(255,255,255,0.3);
        }

        .table-header {
            font-size: 13px;
            font-weight: 600;
        }

            .table-header div {
                font-size: 13px;
                font-weight: 600;
            }

        .row {
            font-size: 13px;
            padding: 4px 12px;
        }

            .row div {
                font-size: 13px;
                font-weight: 400;
                line-height: 16px;
                vertical-align: middle;
            }

        .inspection-project {
            width: 200px;
            max-width: 200px;
            white-space: normal;
            word-break: break-word;
            overflow-wrap: break-word;
            line-height: 16px;
            margin: 0;
            padding: 0;
        }

        /* RESPONSIVE */
        @@media(max - width:900px) {
            .form-row

        {
            grid-template-columns: 1fr;
        }

        .table-header, .row {
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }

        }

       
    </style>
</head>

<body>

<form asp-action="Index" method="post">

    <div class="form-card">

        <div class="form-card-header">
            CCMMC CheckList
        </div>

        <div class="form-body">

            <div class="form-row">

                <div class="form-group">
                    <label>Line</label>
                    <select asp-for="LineId"
                            id="LineId"
                            asp-items="@(new SelectList(Model.Lines,
                                    "LineId",
                                    "LineName"))">
                        <option value="">-- Select Line --</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Project</label>
                    <select asp-for="ProjectId"
                            id="ProjectId"
                            asp-items="@(new SelectList(Model.Projects,
                                    "ProjectId",
                                    "ProjectName"))">
                        <option value="">-- Select Project --</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Model</label>
                    <select asp-for="ModelId"
                            id="ModelId"
                            asp-items="@(new SelectList(Model.ModelNos,
                                    "ModelId",
                                    "Model"))">
                        <option value="">-- Select Model --</option>
                    </select>
                </div>

            </div>

            <div class="form-row">

                <div class="form-group">
                    <label>Part</label>
                    <select asp-for="PartId"
                            id="PartId"
                            asp-items="@(new SelectList(Model.PartNos,
                                    "PartId",
                                    "Part"))">
                        <option value="">-- Select Part --</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Machine</label>
                    <select asp-for="MachineId"
                            id="MachineId"
                            asp-items="@(new SelectList(Model.Machines,
                                    "MachineId",
                                    "Machine"))">
                        <option value="">-- Select Machine --</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Production Line Leader</label>
                    <input asp-for="ProdLineLeader" />
                </div>

            </div>

            <div class="form-row">

                <div class="form-group">
                    <label>Checked By</label>
                    <input asp-for="CheckedBy" />
                </div>

                <div class="form-group">
                    <label>Approved By</label>
                    <input asp-for="ApprovedBy" />
                </div>

                <div class="form-group"
                     style="justify-content:flex-end;">

                    <label style="visibility:hidden;">
                        Search
                    </label>

                    <button type="submit"
                            class="btn-search" >
                        Search
                    </button>

                </div>

            </div>

        </div>

    </div>

</form>

    @if (ViewBag.Message != null)
    {
        <div style="
            background:#dc3545;
            color:white;
            padding:10px;
            border-radius:8px;
            margin:10px 0;">

            @ViewBag.Message

        </div>
    }

<div class="table">

        <div class="table-header">

            <div>Work Station</div>
            <div>Inspection Project</div>
            <div>Inspection Specifications</div>
            <div>Frequency</div>
            <div>Section</div>
            <div>Value1</div>
            <div>Value2</div>
            <div>Value3</div>
            <div>Value4</div>
            <div>Value5</div>
            <div>Action</div>

        </div>

    <div id="body">

        @if (Model.dtChecklist != null &&
             Model.dtChecklist.Rows.Count > 0)
        {
            foreach (System.Data.DataRow row in Model.dtChecklist.Rows)
            {
                    <div class="row">

                        <div>@row["WorkStation"]</div>

                        <div class="inspection-project">
                            @row["InspectionProject"]
                        </div>

                        <div>@row["InspectionSpecifications"]</div>

                        <div>@row["Frequency"]</div>

                        <div>
                            @row["Section"]

                            <input type="hidden"
                                   class="SectionId"
                                   value="@row["SectionId"]" />
                        </div>

                        <div>
                            <input type="text" class="Value1" />
                        </div>

                        <div>
                            <input type="text" class="Value2" />
                        </div>

                        <div>
                            <input type="text" class="Value3" />
                        </div>

                        <div>
                            <input type="text" class="Value4" />
                        </div>

                        <div>
                            <input type="text" class="Value5" />
                        </div>

                        <div>
                            <button type="button"
                                    class="btn-search btnRowSave">
                                Save
                            </button>
                        </div>

                    </div>
            }
        }
        else
        {
            <div class="empty">
                No records found. Click Search.
            </div>
        }

    </div>

</div>


<div style="margin-top:15px;">
        <button id="btnSubmit"
                class="btn-submit"
                type="button">
            Submit
        </button>
</div>


<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>

    $("#ProjectId").change(function () {

        var projectId = $(this).val();

        $.ajax({
            url: '/CCMCHI4SC/GetModelNoByProject',
            type: 'POST',
            data: { projectId: projectId },

            success: function (data) {

                $("#ModelId").empty();

                $("#ModelId").append(
                    '<option value="">-- Select Model --</option>'
                );

                $.each(data, function (i, item) {

                    $("#ModelId").append(
                        '<option value="' +
                        item.modelId +
                        '">' +
                        item.model +
                        '</option>'
                    );
                });
            }
        });
    });


    $("#ModelId").change(function () {

        var modelId = $(this).val();

        $.ajax({
            url: '/CCMCHI4SC/GetPartNoByModel',
            type: 'POST',
            data: { modelId: modelId },

            success: function (data) {

                $("#PartId").empty();

                $("#PartId").append(
                    '<option value="">-- Select Part --</option>'
                );

                $.each(data, function (i, item) {

                    $("#PartId").append(
                        '<option value="' +
                        item.partId +
                        '">' +
                        item.part +
                        '</option>'
                    );
                });
            }
        });
    });

         $(document).on("click", ".btnRowSave", function () {

            // The row whose Save button was clicked
            var clickedRow = $(this).closest(".row");

            var rowsToSave = [];

            // Start from first row and process only up to clicked row
            $("#body .row").each(function () {

                var row = $(this);

                var sectionId = row.find(".SectionId").val();

                var value1 = $.trim(row.find(".Value1").val());
                var value2 = $.trim(row.find(".Value2").val());
                var value3 = $.trim(row.find(".Value3").val());
                var value4 = $.trim(row.find(".Value4").val());
                var value5 = $.trim(row.find(".Value5").val());

                // Check whether this row contains at least one entered value
                var hasValue =
                    value1 !== "" ||
                    value2 !== "" ||
                    value3 !== "" ||
                    value4 !== "" ||
                    value5 !== "";

                // Add only rows having entered values
                if (sectionId && hasValue) {

                    rowsToSave.push({

                        SectionId: parseInt(sectionId) || 0,

                        Value1: value1 === "" ? null : value1,
                        Value2: value2 === "" ? null : value2,
                        Value3: value3 === "" ? null : value3,
                        Value4: value4 === "" ? null : value4,
                        Value5: value5 === "" ? null : value5,

                        // Keep HTML row reference so that
                        // only successfully saved rows are removed
                        _htmlRow: row
                    });
                }

                // Stop after reaching the clicked Save row
                if (row[0] === clickedRow[0]) {
                    return false;
                }
            });


            // Nothing entered before/up to clicked row
            if (rowsToSave.length === 0) {

                alert("Please enter at least one value before saving.");
                return;
            }


            // Remove _htmlRow before sending data to controller
            var resultList = rowsToSave.map(function (x) {

                return {

                    SectionId: x.SectionId,

                    Value1: x.Value1,
                    Value2: x.Value2,
                    Value3: x.Value3,
                    Value4: x.Value4,
                    Value5: x.Value5
                };

            });


            var data = {

                LineId: parseInt($("#LineId").val()) || 0,

                ProjectId: parseInt($("#ProjectId").val()) || 0,

                ModelId: parseInt($("#ModelId").val()) || 0,

                PartId: parseInt($("#PartId").val()) || 0,

                MachineId: parseInt($("#MachineId").val()) || 0,

                ProdLineLeader: $("#ProdLineLeader").val(),

                CheckedBy: $("#CheckedBy").val(),

                ApprovedBy: $("#ApprovedBy").val(),

                CCMCHI4SCResults: resultList
            };


            $.ajax({

                url: '/CCMCHI4SC/SaveA246FCCMMC1CheckList',

                type: 'POST',

                contentType: 'application/json',

                data: JSON.stringify(data),

                success: function (result) {

                    // If controller returns success:false
                    if (result &&
                        result.success !== undefined &&
                        result.success === false) {

                        alert(result.message || "Error while saving.");
                        return;
                    }


                    alert("Data Saved Successfully");


                    // Remove ONLY rows which were actually saved
                    rowsToSave.forEach(function (x) {

                        x._htmlRow.fadeOut(300, function () {

                            $(this).remove();

                            // Check after removal
                            if ($("#body .row").length === 0) {

                                $("#body").html(
                                    '<div class="empty">' +
                                    'No records found.' +
                                    '</div>'
                                );
                            }

                        });

                    });

                },

                error: function (xhr) {

                    alert("Error while saving");
                }

            });

        });

        $("#btnSubmit").click(function () {

            var results = [];

            $(".row").each(function () {

                results.push({

                    SectionId: $(this).find(".SectionId").val(),

                    Value1: $(this).find(".Value1").val() || 0,
                    Value2: $(this).find(".Value2").val() || 0,
                    Value3: $(this).find(".Value3").val() || 0,
                    Value4: $(this).find(".Value4").val() || 0,
                    Value5: $(this).find(".Value5").val() || 0

                });

            });

            var data = {

                LineId: $("#LineId").val(),
                ProjectId: $("#ProjectId").val(),
                ModelId: $("#ModelId").val(),
                PartId: $("#PartId").val(),

                ProdLineLeader: $("#ProdLineLeader").val(),
                CheckedBy: $("#CheckedBy").val(),
                ApprovedBy: $("#ApprovedBy").val(),

                CCMCHI4SCResults: results

            };

            $.ajax({

                url: '/CCMCHI4SC/SaveA246FCCMMC1CheckList',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(data),

                success: function (result) {

                    alert("All Rows Saved Successfully");
                    $(".Value1").val("");
                    $(".Value2").val("");
                    $(".Value3").val("");
                    $(".Value4").val("");
                    $(".Value5").val("");

                }
            });

        });
</script>

</body>
</html>