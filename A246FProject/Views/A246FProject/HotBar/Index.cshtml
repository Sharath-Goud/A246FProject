@model A246FProject.Models.HotBarViewModel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hot Bar CheckList</title>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins',sans-serif;
        }

        body {
            background: linear-gradient(135deg,#0d0d1a,#0a0a2e,#0d1b2a);
            min-height: 100vh;
            color: #e2e8f0;
            padding: 20px;
        }

        /* CARD */

        .form-card {
            background: rgba(255,255,255,.04);
            border: 1px solid rgba(255,255,255,.08);
            border-radius: 16px;
            overflow: hidden;
            margin-bottom: 20px;
        }

        .form-card-header {
            background: rgba(167,139,250,.12);
            border-bottom: 1px solid rgba(167,139,250,.2);
            padding: 14px 22px;
            font-size: 16px;
            font-weight: 600;
            color: #fff;
        }

        .form-body {
            padding: 22px;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .form-row {
            display: grid;
            grid-template-columns: repeat(3,1fr);
            gap: 14px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
        }

        label {
            font-size: 11px;
            color: rgba(255,255,255,.45);
            margin-bottom: 6px;
        }

        input,
        select {
            background: rgba(255,255,255,.06);
            border: 1px solid rgba(255,255,255,.12);
            border-radius: 8px;
            padding: 10px 12px;
            font-size: 13px;
            color: #fff;
            outline: none;
        }

            input::placeholder {
                color: rgba(255,255,255,.35);
            }

            select option {
                background: #1a1040;
            }

            input:focus,
            select:focus {
                border-color: #a78bfa;
                background: rgba(167,139,250,.08);
            }

        /* BUTTONS */

        .btn-search {
            width: 100%;
            background: linear-gradient(135deg,#a78bfa,#7c3aed);
            border: none;
            border-radius: 8px;
            padding: 11px;
            color: #fff;
            cursor: pointer;
            font-size: 14px;
            font-weight: 500;
        }

        .btn-submit {
            background: linear-gradient(135deg,#60a5fa,#2563eb);
            border: none;
            border-radius: 8px;
            padding: 10px 24px;
            color: #fff;
            cursor: pointer;
            font-size: 13px;
        }

        .results-table {
            background: rgba(255,255,255,.04);
            border: 1px solid rgba(255,255,255,.08);
            border-radius: 16px;
            overflow: hidden;
        }

        .custom-table tbody td {
            font-size: 14px;
            font-weight: 500;
        }

        .custom-table thead th {
            font-size: 14px;
            font-weight: 600;
        }

        .custom-table tbody td input {
            height: 34px;
            font-size: 14px;
        }

        .table-scroll {
            overflow-x: auto;
            width: 100%;
        }

        .custom-table {
            font-size: 14px;
            width: 100%;
            min-width: 1000px;
            border-collapse: collapse;
        }

            .custom-table td:nth-child(2) {
                white-space: normal;
                word-break: break-word;
                overflow-wrap: break-word;
                line-height: 16px;
                text-align: left;
            }

            .custom-table td:nth-child(3) {
                white-space: normal;
                word-break: break-word;
                overflow-wrap: break-word;
            }

            .custom-table th:nth-child(1),
            .custom-table td:nth-child(1) {
                width: 80px;
            }

            .custom-table th:nth-child(2),
            .custom-table td:nth-child(2) {
                width: 220px;
            }

            .custom-table th:nth-child(3),
            .custom-table td:nth-child(3) {
                width: 150px;
            }

            .custom-table th:nth-child(4),
            .custom-table td:nth-child(4) {
                width: 120px;
            }

            .custom-table th:nth-child(5),
            .custom-table td:nth-child(5) {
                width: 80px;
            }

            .custom-table th:nth-child(6),
            .custom-table td:nth-child(6),
            .custom-table th:nth-child(7),
            .custom-table td:nth-child(7),
            .custom-table th:nth-child(8),
            .custom-table td:nth-child(8),
            .custom-table th:nth-child(9),
            .custom-table td:nth-child(9),
            .custom-table th:nth-child(10),
            .custom-table td:nth-child(10) {
                width: 100px;
            }

            .custom-table th:nth-child(11),
            .custom-table td:nth-child(11) {
                width: 200px;
            }

        .CableSerialNo {
            width: 180px !important;
            min-width: 180px;
        }

        .custom-table th:nth-child(12),
        .custom-table td:nth-child(12) {
            width: 100px;
        }

        .custom-table thead {
            background: rgba(167,139,250,.08);
        }

            .custom-table thead th {
                padding: 14px 12px;
                text-align: left;
                font-size: 12px;
                font-weight: 600;
                color: rgba(255,255,255,.75);
                border-bottom: 1px solid rgba(255,255,255,.08);
                white-space: nowrap;
            }

        .custom-table tbody td {
            padding: 8px 12px;
            text-align: left;
            color: #e2e8f0;
            border-top: 1px solid rgba(255,255,255,.05);
            font-size: 13px;
            font-weight: 400;
            line-height: 16px;
            vertical-align: middle;
        }

            .custom-table tbody td input {
                width: 85px;
                height: 34px;
                font-size: 13px;
            }

        .empty-row {
            height: 100px;
            color: rgba(255,255,255,.25);
            font-size: 13px;
        }

        .actions {
            margin-top: 16px;
        }

        @@media(max - width:900px) {
            .form-row {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>

    <form asp-action="Index" method="post">

        <div class="form-card">

            <div class="form-card-header">
                Hot Bar CheckList
            </div>

            <div class="form-body">

                <div class="form-row">

                    <div class="form-group">
                        <label>Line</label>
                        <select asp-for="LineId"
                                id="LineId"
                                asp-items="@(new SelectList(Model.Lines,
                                    "LineId",
                                    "LineName"))">
                            <option value="">-- Select Line --</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Project</label>
                        <select asp-for="ProjectId"
                                id="ProjectId"
                                asp-items="@(new SelectList(Model.Projects,
                                    "ProjectId",
                                    "ProjectName"))">
                            <option value="">-- Select Project --</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Model</label>
                        <select asp-for="ModelId"
                                id="ModelId"
                                asp-items="@(new SelectList(Model.ModelNos,
                                    "ModelId",
                                    "Model"))">
                            <option value="">-- Select Model --</option>
                        </select>
                    </div>

                </div>

                <div class="form-row">

                    <div class="form-group">
                        <label>Part</label>
                        <select asp-for="PartId"
                                id="PartId"
                                asp-items="@(new SelectList(Model.PartNos,
                                    "PartId",
                                    "Part"))">
                            <option value="">-- Select Part --</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Production Line Leader</label>
                        <input asp-for="ProdLineLeader" id="ProdLineLeader" />
                    </div>
                    <div class="form-group">
                        <label>Checked By</label>
                        <input asp-for="CheckedBy" id="CheckedBy" />
                    </div>
                </div>

                <div class="form-row">

                    <div class="form-group">
                        <label>Approved By</label>
                        <input asp-for="ApprovedBy" id="ApprovedBy" />
                    </div>

                    <div class="form-group"
                         style="justify-content:flex-end;">

                        <label style="visibility:hidden;">
                            Search
                        </label>

                        <button type="submit"
                                class="btn-search">
                            Search
                        </button>

                    </div>

                </div>

            </div>

        </div>

    </form>

    @if (ViewBag.Message != null)
    {
        <div id="validationMessage" style="
        background:#dc3545;
        color:white;
        padding:10px 15px;
        border-radius:8px;
        margin:10px 0;
        font-size:13px;
        font-weight:500;">

            @ViewBag.Message

        </div>
    }

    <div class="results-table">

        <div class="table-scroll">

            <table class="custom-table">

                <thead>

                    <tr>
                        <th>Work Station</th>
                        <th>Inspection Project</th>
                        <th>Inspection Specifications</th>
                        <th>Frequency</th>
                        <th>section</th>
                        <th>Value1</th>
                        <th>Value2</th>
                        <th>Value3</th>
                        <th>Value4</th>
                        <th>Value5</th>
                        <th>Cables Serial Number</th>
                        <th>Save</th>
                    </tr>

                </thead>

                <tbody id="body">

                    @if (Model.dtChecklist != null &&
                    Model.dtChecklist.Rows.Count > 0)
                    {
                        foreach (System.Data.DataRow row in Model.dtChecklist.Rows)
                        {
                            <tr class="row">

                                <td>@row["WorkStation"]</td>

                                <td>@row["InspectionProject"]</td>

                                <td class="InspectionSpecifications">
                                    @row["InspectionSpecifications"]
                                </td>

                                <td>@row["Frequency"]</td>

                                <td>
                                    @row["Section"]

                                    <input type="hidden"
                                           class="SectionId"
                                           value="@row["SectionId"]" />

                                    <input type="hidden"
                                           class="StartSpec"
                                           value="@row["StartSpec"]" />

                                    <input type="hidden"
                                           class="EndSpec"
                                           value="@row["EndSpec"]" />
                                </td>

                                <td><input type="text" class="Value1" /></td>
                                <td><input type="text" class="Value2" /></td>
                                <td><input type="text" class="Value3" /></td>
                                <td><input type="text" class="Value4" /></td>
                                <td><input type="text" class="Value5" /></td>

                                <td>
                                    <input type="text"
                                           class="CableSerialNo" />
                                </td>

                                <td>
                                    <button type="button"
                                            class="btn-search btnRowSave">
                                        Save
                                    </button>
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="12" class="empty-row">
                                No records found. Click Search.
                            </td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>

    </div>

    <div class="actions">
        <button type="button" class="btn-submit">
            Submit
        </button>
    </div>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>
                $("#ProjectId").change(function () {

            var projectId = $(this).val();

            $.ajax({
                url: '/HotBar/GetModelNoByProject',
                type: 'POST',
                data: { projectId: projectId },

                success: function (data) {

                    $("#ModelId").empty();

                    $("#ModelId").append(
                        '<option value="">-- Select Model --</option>'
                    );

                    $.each(data, function (i, item) {

                        $("#ModelId").append(
                            '<option value="' +
                            item.modelId +
                            '">' +
                            item.model +
                            '</option>'
                        );
                    });
                }
            });
        });

        $("#ModelId").change(function () {

            var modelId = $(this).val();

            $.ajax({
                url: '/HotBar/GetPartNoByModel',
                type: 'POST',
                data: { modelId: modelId },

                success: function (data) {

                    $("#PartId").empty();

                    $("#PartId").append(
                        '<option value="">-- Select Part --</option>'
                    );

                    $.each(data, function (i, item) {

                        $("#PartId").append(
                            '<option value="' +
                            item.partId +
                            '">' +
                            item.part +
                            '</option>'
                        );
                    });
                }
            });
        });
    </script>
   
    <script>

    function getInspectionSpecification(row) {

        return $.trim(
            row.find(".InspectionSpecifications").text()
        );
    }


                function convertToNumber(value) {

            value = $.trim(value);

            if (value === "") {
                return null;
            }

            let number = Number(value);

            return Number.isFinite(number)
                ? number
                : null;
        }


        function validateValue(value, startSpec, endSpec) {

            value = $.trim(value);

            // Empty input is allowed
            if (value === "") {
                return true;
            }

            // NG is invalid
            if (value.toUpperCase() === "NG") {
                return false;
            }

            // Entered value must be numeric
            let numericValue = convertToNumber(value);

            if (numericValue === null) {
                return false;
            }

            // Get specification values
            let min = convertToNumber(startSpec);
            let max = convertToNumber(endSpec);


            // No specifications available
            if (min === null && max === null) {
                return true;
            }


            // Both StartSpec and EndSpec available
            if (min !== null && max !== null) {

                return numericValue >= min &&
                       numericValue <= max;
            }


            // Only StartSpec available
            if (min !== null) {

                return numericValue >= min;
            }


            // Only EndSpec available
            if (max !== null) {

                return numericValue <= max;
            }


            return true;
        }

        function getStartSpec(row) {

            return $.trim(
                row.find(".StartSpec").val()
            );
        }


        function getEndSpec(row) {

            return $.trim(
                row.find(".EndSpec").val()
            );
        }

        function validateRow(row) {

            let startSpec = getStartSpec(row);
            let endSpec = getEndSpec(row);

            let inputs = row.find(
                ".Value1, .Value2, .Value3, .Value4, .Value5"
            );

            let isValid = true;

            inputs.each(function () {

                let value = $.trim($(this).val());

                if (value !== "") {

                    if (
                        !validateValue(
                            value,
                            startSpec,
                            endSpec
                        )
                    ) {

                        isValid = false;

                        return false;
                    }
                }

            });

            return isValid;
        }


    function highlightInput(input) {

        input.css({
            "background": "rgba(220,53,69,0.65)",
            "border": "2px solid #dc3545",
            "color": "#ffffff"
        });
    }


    function removeInputHighlight(input) {

        input.css({
            "background": "",
            "border": "",
            "color": ""
        });
    }


            $(document).on(

            "input change",

            ".Value1, .Value2, .Value3, .Value4, .Value5",

            function () {

                let input = $(this);

                let row = input.closest("tr");

                let startSpec = getStartSpec(row);

                let endSpec = getEndSpec(row);

                let value = $.trim(input.val());


                if (value === "") {

                    removeInputHighlight(input);

                }
                else {

                    let isValid = validateValue(
                        value,
                        startSpec,
                        endSpec
                    );


                    if (!isValid) {

                        highlightInput(input);

                    }
                    else {

                        removeInputHighlight(input);
                    }
                }


                if (!validateRow(row)) {

                    row.css(
                        "background",
                        "rgba(220,53,69,0.20)"
                    );

                }
                else {

                    row.css(
                        "background",
                        ""
                    );
                }

            }
        );


    $(document).on(
        "click",
        ".btnRowSave",
        function () {

            let clickedRow =
                $(this).closest("tr");


            let rowsToSave = [];

            $("#body tr.row").each(function () {

                let row = $(this);

                if (!validateRow(row)) {

                    row.css(
                        "background",
                        "rgba(220,53,69,0.20)"
                    );

                    row.find(
                        ".Value1, .Value2, .Value3, .Value4, .Value5"
                    ).each(function () {

                        let input = $(this);

                        // Get minimum and maximum specification
                        let startSpec = getStartSpec(row);

                        let endSpec = getEndSpec(row);

                        // Get entered value
                        let value = $.trim(input.val());

                        // Validate entered value
                        if (
                            value !== "" &&
                            !validateValue(
                                value,
                                startSpec,
                                endSpec
                            )
                        ) {

                            highlightInput(input);
                        }
                        else {

                            removeInputHighlight(input);
                        }

                    });


                    alert(
                        "Invalid value found based on the Inspection Specifications. " +
                        "Please correct the highlighted value."
                    );

                    return false;
                }

                let sectionId =
                    row.find(".SectionId").val();

                let value1 =
                    $.trim(row.find(".Value1").val());

                let value2 =
                    $.trim(row.find(".Value2").val());

                let value3 =
                    $.trim(row.find(".Value3").val());

                let value4 =
                    $.trim(row.find(".Value4").val());

                let value5 =
                    $.trim(row.find(".Value5").val());

                let cableSerialNo =
                    $.trim(
                        row.find(".CableSerialNo").val()
                    );


                let hasValue =

                    value1 !== "" ||
                    value2 !== "" ||
                    value3 !== "" ||
                    value4 !== "" ||
                    value5 !== "" ||
                    cableSerialNo !== "";

                if (sectionId && hasValue) {

                    rowsToSave.push({

                        SectionId:
                            parseInt(sectionId) || 0,

                        Value1:
                            value1 === ""
                                ? null
                                : value1,

                        Value2:
                            value2 === ""
                                ? null
                                : value2,

                        Value3:
                            value3 === ""
                                ? null
                                : value3,

                        Value4:
                            value4 === ""
                                ? null
                                : value4,

                        Value5:
                            value5 === ""
                                ? null
                                : value5,

                        CablesSerialNumber:
                            cableSerialNo === ""
                                ? null
                                : cableSerialNo,

                        _htmlRow:
                            row
                    });
                }

                if (row[0] === clickedRow[0]) {

                    return false;
                }

            });

            if (rowsToSave.length === 0) {

                alert(
                    "Please enter at least one value before saving."
                );

                return;
            }

            let resultList =
                rowsToSave.map(function (x) {

                    return {

                        SectionId:
                            x.SectionId,

                        Value1:
                            x.Value1,

                        Value2:
                            x.Value2,

                        Value3:
                            x.Value3,

                        Value4:
                            x.Value4,

                        Value5:
                            x.Value5,

                        CablesSerialNumber:
                            x.CablesSerialNumber
                    };

                });

            let model = {

                LineId:
                    parseInt($("#LineId").val()) || 0,

                ProjectId:
                    parseInt($("#ProjectId").val()) || 0,

                ModelId:
                    parseInt($("#ModelId").val()) || 0,

                PartId:
                    parseInt($("#PartId").val()) || 0,

                MachineId:
                    parseInt($("#MachineId").val()) || 0,

                ProdLineLeader:
                    $("#ProdLineLeader").val(),

                CheckedBy:
                    $("#CheckedBy").val(),

                ApprovedBy:
                    $("#ApprovedBy").val(),

                HotBarResult:
                    resultList
            };

            $.ajax({

                url:
                    '/HotBar/SaveA246FMHB1CheckList',

                type:
                    'POST',

                contentType:
                    'application/json; charset=utf-8',

                data:
                    JSON.stringify(model),

                success: function (response) {

                    if (
                        response &&
                        response.success === false
                    ) {

                        alert(
                            response.message ||
                            "Error while saving."
                        );

                        return;
                    }


                    alert(
                        "Data Saved Successfully"
                    );

                    rowsToSave.forEach(function (x) {

                        x._htmlRow.remove();

                    });

                    if (
                        $("#body tr.row").length === 0
                    ) {

                        $("#body").html(`
                            <tr>
                                <td colspan="12"
                                    class="empty-row">
                                    No records found.
                                </td>
                            </tr>
                        `);
                    }

                },

                error: function () {

                    alert(
                        "Server Error while saving."
                    );
                }

            });

        }
    );

    $(document).on(
        "click",
        ".btn-submit",
        function (e) {

            e.preventDefault();


            let results = [];

            let hasInvalidValue = false;

            $("#body tr.row").each(function () {

                let row = $(this);

                if (!validateRow(row)) {

                    hasInvalidValue = true;


                    row.css(
                        "background",
                        "rgba(220,53,69,0.20)"
                    );


                    let startSpec = getStartSpec(row);

                    let endSpec = getEndSpec(row);

                    row.find(
                        ".Value1, .Value2, .Value3, .Value4, .Value5"
                    ).each(function () {

                        let input = $(this);

                        let value = $.trim(input.val());

                        if (
                            value !== "" &&
                            !validateValue(
                                value,
                                startSpec,
                                endSpec
                            )
                        ) {

                            highlightInput(input);
                        }
                        else {

                            removeInputHighlight(input);
                        }

                    });

                    return false;
                }

                let sectionId =
                    row.find(".SectionId").val();

                let value1 =
                    $.trim(row.find(".Value1").val());

                let value2 =
                    $.trim(row.find(".Value2").val());

                let value3 =
                    $.trim(row.find(".Value3").val());

                let value4 =
                    $.trim(row.find(".Value4").val());

                let value5 =
                    $.trim(row.find(".Value5").val());

                let cableSerialNo =
                    $.trim(
                        row.find(".CableSerialNo").val()
                    );


                let hasValue =

                    value1 !== "" ||
                    value2 !== "" ||
                    value3 !== "" ||
                    value4 !== "" ||
                    value5 !== "" ||
                    cableSerialNo !== "";

                if (sectionId && hasValue) {

                    results.push({

                        SectionId:
                            parseInt(sectionId) || 0,

                        Value1:
                            value1 === ""
                                ? null
                                : value1,

                        Value2:
                            value2 === ""
                                ? null
                                : value2,

                        Value3:
                            value3 === ""
                                ? null
                                : value3,

                        Value4:
                            value4 === ""
                                ? null
                                : value4,

                        Value5:
                            value5 === ""
                                ? null
                                : value5,

                        CablesSerialNumber:
                            cableSerialNo === ""
                                ? null
                                : cableSerialNo
                    });
                }

            });


            if (hasInvalidValue) {

                alert(
                    "Invalid value found based on the Inspection Specifications. " +
                    "Please correct the highlighted value before submitting."
                );

                return;
            }


            if (results.length === 0) {

                alert(
                    "Please enter at least one value before submitting."
                );

                return;
            }

            let model = {

                LineId:
                    parseInt($("#LineId").val()) || 0,

                ProjectId:
                    parseInt($("#ProjectId").val()) || 0,

                ModelId:
                    parseInt($("#ModelId").val()) || 0,

                PartId:
                    parseInt($("#PartId").val()) || 0,

                MachineId:
                    parseInt($("#MachineId").val()) || 0,

                ProdLineLeader:
                    $("#ProdLineLeader").val(),

                CheckedBy:
                    $("#CheckedBy").val(),

                ApprovedBy:
                    $("#ApprovedBy").val(),

                HotBarResult:
                    results
            };

            $.ajax({

                url:
                    '/HotBar/SaveA246FMHB1CheckList',

                type:
                    'POST',

                contentType:
                    'application/json; charset=utf-8',

                data:
                    JSON.stringify(model),

                success: function (response) {

                    if (
                        response &&
                        response.success === true
                    ) {

                        alert(
                            response.message ||
                            "Saved Successfully"
                        );


                        // Clear inputs
                        $(".Value1").val("");
                        $(".Value2").val("");
                        $(".Value3").val("");
                        $(".Value4").val("");
                        $(".Value5").val("");
                        $(".CableSerialNo").val("");


                        // Remove highlights
                        $("#body tr.row").css(
                            "background",
                            ""
                        );


                        $(
                            ".Value1, .Value2, .Value3, " +
                            ".Value4, .Value5"
                        ).each(function () {

                            removeInputHighlight(
                                $(this)
                            );

                        });

                    }
                    else {

                        alert(
                            "Save failed: " +
                            (
                                response.message ||
                                "Unknown error"
                            )
                        );
                    }

                },

                error: function () {

                    alert(
                        "Server Error while saving."
                    );
                }

            });

        }
    );

</script>
</body>
</html>