@model A246FProject.Models.VisualInspectionViewModel
@using Microsoft.AspNetCore.Mvc.Rendering
@using System.Data

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Visual Inspection</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Poppins, sans-serif;
        }

        body {
            background: linear-gradient(135deg, #0d0d1a, #0a0a2e, #0d1b2a);
            min-height: 100vh;
            color: #e2e8f0;
            padding: 20px;
        }

        h1 {
            font-size: 22px;
            font-weight: 600;
            color: #fff;
            margin-bottom: 4px;
        }

        .sub {
            color: rgba(255,255,255,.4);
            font-size: 13px;
            margin-bottom: 18px;
        }

        /* FORM CARD */
        .form-card {
            background: rgba(255,255,255,.04);
            border: 0.5px solid rgba(255,255,255,.08);
            border-radius: 16px;
            overflow: hidden;
            margin-bottom: 16px;
        }

        .form-card-header {
            background: rgba(167,139,250,.12);
            border-bottom: 0.5px solid rgba(167,139,250,.2);
            padding: 14px 22px;
            font-size: 15px;
            font-weight: 600;
            color: #fff;
        }

        .form-body {
            padding: 22px;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .form-row {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 14px;
        }

        .form-row-2 {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 14px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        label {
            font-size: 11px;
            color: rgba(255,255,255,.45);
            letter-spacing: 0.5px;
        }

        input, select {
            background: rgba(255,255,255,.06);
            border: 0.5px solid rgba(255,255,255,.12);
            border-radius: 8px;
            padding: 9px 12px;
            font-size: 13px;
            color: #fff;
            outline: none;
            transition: border-color .2s, background .2s;
        }

            select option {
                background: #1a1040;
            }

            input::placeholder {
                color: rgba(255,255,255,.25);
            }

            input:focus, select:focus {
                border-color: rgba(167,139,250,.5);
                background: rgba(167,139,250,.08);
            }

        .btn-search {
            background: linear-gradient(135deg, #a78bfa, #7c3aed);
            border: none;
            border-radius: 8px;
            padding: 10px 20px;
            color: #fff;
            cursor: pointer;
            font-size: 13px;
        }

            .btn-search:hover {
                opacity: .85;
            }

        .btn-submit {
            background: linear-gradient(135deg, #60a5fa, #2563eb);
            border: none;
            border-radius: 8px;
            padding: 10px 32px;
            color: #fff;
            cursor: pointer;
            font-size: 13px;
            font-family: Poppins, sans-serif;
            font-weight: 500;
            transition: opacity .2s;
        }

            .btn-submit:hover {
                opacity: .85;
            }

        /* NOTE BOX */
        .note-box {
            background: rgba(255,255,255,.03);
            border: 0.5px solid rgba(255,255,255,.08);
            border-radius: 10px;
            padding: 12px 16px;
            margin-bottom: 12px;
        }

            .note-box span {
                font-size: 12px;
                font-weight: 600;
                color: #f87171;
                line-height: 1.8;
            }

        /* TABLE */
        .results-table {
            background: rgba(255,255,255,.04);
            border: 0.5px solid rgba(255,255,255,.08);
            border-radius: 16px;
            overflow: hidden;
            margin-bottom: 16px;
        }

        .header-row {
            display: grid;
            grid-template-columns: 160px 1fr 1fr 120px 120px 180px 120px;
            background: rgba(167,139,250,.08);
            padding: 12px 16px;
            font-size: 11px;
            color: rgba(255,255,255,.45);
            letter-spacing: 0.5px;
            gap: 10px;
        }

        .data-row {
            display: grid;
            grid-template-columns: 160px 1fr 1fr 120px 120px 180px 120px;
            padding: 10px 16px;
            font-size: 13px;
            border-top: 0.5px solid rgba(255,255,255,.05);
            gap: 10px;
            align-items: center;
            transition: background .15s;
        }

            .data-row:hover {
                background: rgba(255,255,255,.03);
            }

            .data-row input, .data-row select {
                padding: 6px 10px;
                font-size: 12px;
                width: 100%;
            }

        .empty {
            padding: 40px;
            text-align: center;
            color: rgba(255,255,255,.25);
            font-size: 13px;
        }

        .actions {
            margin-top: 4px;
            display: flex;
            gap: 10px;
        }

        /* STATUS BADGES */
        .badge {
            display: inline-block;
            padding: 3px 10px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
        }

        .badge-ok {
            background: rgba(52,211,153,.15);
            color: #34d399;
            border: 0.5px solid rgba(52,211,153,.3);
        }

        .badge-ng {
            background: rgba(248,113,113,.15);
            color: #f87171;
            border: 0.5px solid rgba(248,113,113,.3);
        }

        .badge-na {
            background: rgba(148,163,184,.15);
            color: #94a3b8;
            border: 0.5px solid rgba(148,163,184,.3);
        }

        @@media (max-width: 900px) {
            .form-row, .form-row-2 {
                grid-template-columns: 1fr;
            }

            .header-row, .data-row {
                grid-template-columns: repeat(2, 1fr);
            }
        }
    </style>
</head>
<body>

    <form asp-action="Index" method="post">
        <div class="form-card">
            <div class="form-card-header">SVisual Inspection</div>
            <div class="form-body">

                <!-- Row 1 -->
                <div class="form-row">
                    <div class="form-group">
                        <label>Line</label>
                        <select asp-for="LineId"
                                asp-items="@(new SelectList(Model.Lines,"LineId","LineName"))">
                            <option value="">--Select Line--</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Project</label>
                        <select asp-for="ProjectId"
                                id="ProjectId"
                                asp-items="@(new SelectList(Model.Projects,"ProjectId","ProjectName"))">
                            <option value="">--Select Project--</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Model</label>
                        <select asp-for="ModelId"
                                asp-items="@(new SelectList(Model.ModelNos,"ModelId","Model"))"
                                class="form-control"
                                id="ModelId">
                            <option value="">--Select Model--</option>
                        </select>
                    </div>
                </div>

                <!-- Row 2 -->
                <div class="form-row">
                    <div class="form-group">
                        <label>Visual</label>

                        <select asp-for="VisualsId"
                                asp-items="@(new SelectList(Model.Visualss,"VisualsId","Visual"))"
                                class="form-control"
                                id="VisualsId">
                            <option value="">--Select Inspection--</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Part Number</label>
                        <select asp-for="PartId"
                                asp-items="@(new SelectList(Model.PartNos,"PartId","Part"))"
                                class="form-control"
                                id="PartId">
                            <option value="">--Select Part--</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Production Line Leader</label>
                        <input type="text" id="txtLineLeader" placeholder="Production Line Leader" />
                    </div>
                
                </div>

                <!-- Row 3 -->
                <div class="form-row">
                    <div class="form-group">
                        <label>Checked By</label>
                        <input type="text" id="txtCheckedBy" placeholder="Checked By" />
                    </div>
                    <div class="form-group">
                        <label>Approved By</label>
                        <input type="text" id="txtApprovedBy" placeholder="Approved By" />
                    </div>
                    <div class="form-group" style="display:flex; justify-content:flex-end;">
                        <label style="visibility:hidden;">Search</label>
                        <button type="submit" class="btn-search">
                            Search
                        </button>
                    </div>
                </div>

            </div>
        </div>
    </form>

    <!-- NOTE BOX -->
    <div class="note-box">
        <span>NOTE:-</span>
        <span>N - NA</span>
        <span>, V - OK</span>
        <span>, X - NG</span>
    </div>

    <!-- RESULTS TABLE -->
    <div class="results-table">
        <div class="header-row">
            <div>SNO</div>
            <div>Station Name</div>
            <div>Inspection Project</div>
            <div>Sample Size</div>
            <div>Inspection Specifaction</div>
            <div>Result</div>
            <div>Defective Number</div>
            <div>Save</div>
        </div>
        <div id="tableBody">
            <div class="empty">No records found. Use Search to load data.</div>
        </div>
    </div>

    <!-- ACTIONS -->
    <div class="actions">
        <button class="btn-submit" onclick="submitData()">Submit</button>
    </div>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
                $("#ProjectId").change(function () {

            var projectId = $(this).val();

            // Load Model
            $.ajax({
                url: '/VisualInspection/GetModelNoByProject',
                type: 'POST',
                data: { projectId: projectId },
                success: function (result) {

                    $("#ModelId").empty();

                    $("#ModelId").append(
                        '<option value="">--Select Model--</option>');

                    $.each(result, function (i, item) {

                        $("#ModelId").append(
                            '<option value="' +
                            item.modelId +
                            '">' +
                            item.model +
                            '</option>');

                    });

                }
            });

            // Load Visual Inspection

            $.ajax({

                url: '/VisualInspection/GetVisuals',

                type: 'POST',

                data: { projectId: projectId },

                success: function (result) {

                    $("#VisualsId").empty();

                    $("#VisualsId").append(
                        '<option value="">--Select Inspection--</option>');

                    $.each(result, function (i, item) {

                        $("#VisualsId").append(
                            '<option value="' +
                            item.visualsId +
                            '">' +
                            item.visual +
                            '</option>');

                    });

                }

            });

        });

         $("#ModelId").change(function () {

            var modelId = $(this).val();

            $.ajax({

                url: '/VisualInspection/GetPartNoByModel',

                type: 'POST',

                data: { modelId: modelId },

                success: function (result) {

                    $("#PartId").empty();

                    $("#PartId").append(
                        '<option value="">--Select Part--</option>');

                    $.each(result, function (i, item) {

                        $("#PartId").append(
                            '<option value="' +
                            item.partId +
                            '">' +
                            item.part +
                            '</option>');

                    });

                }

            });

        });
    </script>
</body>
</html>