@model A246FProject.Models.VisualInspectionViewModel
@using Microsoft.AspNetCore.Mvc.Rendering
@using System.Data

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Visual Inspection</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Poppins, sans-serif;
        }

        body {
            background: linear-gradient(135deg, #0d0d1a, #0a0a2e, #0d1b2a);
            min-height: 100vh;
            color: #e2e8f0;
            padding: 20px;
        }

        h1 {
            font-size: 22px;
            font-weight: 600;
            color: #fff;
            margin-bottom: 4px;
        }

        .sub {
            color: rgba(255,255,255,.4);
            font-size: 13px;
            margin-bottom: 18px;
        }

        .form-card {
            background: rgba(255,255,255,.04);
            border: 0.5px solid rgba(255,255,255,.08);
            border-radius: 16px;
            overflow: hidden;
            margin-bottom: 16px;
        }

        .form-card-header {
            background: rgba(167,139,250,.12);
            border-bottom: 0.5px solid rgba(167,139,250,.2);
            padding: 14px 22px;
            font-size: 15px;
            font-weight: 600;
            color: #fff;
        }

        .form-body {
            padding: 22px;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .form-row {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 14px;
        }

        .form-row-2 {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 14px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        label {
            font-size: 11px;
            color: rgba(255,255,255,.45);
            letter-spacing: 0.5px;
        }

        input, select {
            background: rgba(255,255,255,.06);
            border: 0.5px solid rgba(255,255,255,.12);
            border-radius: 8px;
            padding: 9px 12px;
            font-size: 13px;
            color: #fff;
            outline: none;
            transition: border-color .2s, background .2s;
        }

            select option {
                background: #1a1040;
            }

            input::placeholder {
                color: rgba(255,255,255,.25);
            }

            input:focus, select:focus {
                border-color: rgba(167,139,250,.5);
                background: rgba(167,139,250,.08);
            }

        .btn-search {
            background: linear-gradient(135deg, #a78bfa, #7c3aed);
            border: none;
            border-radius: 8px;
            padding: 10px 20px;
            color: #fff;
            cursor: pointer;
            font-size: 13px;
        }

            .btn-search:hover {
                opacity: .85;
            }

        .btn-submit {
            background: linear-gradient(135deg, #60a5fa, #2563eb);
            border: none;
            border-radius: 8px;
            padding: 10px 32px;
            color: #fff;
            cursor: pointer;
            font-size: 13px;
            font-family: Poppins, sans-serif;
            font-weight: 500;
            transition: opacity .2s;
        }

            .btn-submit:hover {
                opacity: .85;
            }

        .note-box {
            background: rgba(255,255,255,.03);
            border: 0.5px solid rgba(255,255,255,.08);
            border-radius: 10px;
            padding: 12px 16px;
            margin-bottom: 12px;
        }

            .note-box span {
                font-size: 12px;
                font-weight: 600;
                color: #f87171;
                line-height: 1.8;
            }

        .results-table {
            background: rgba(255,255,255,.04);
            border: 0.5px solid rgba(255,255,255,.08);
            border-radius: 16px;
            overflow: hidden;
            margin-bottom: 16px;
        }



        .empty {
            padding: 40px;
            text-align: left;
            color: rgba(255,255,255,.25);
            font-size: 13px;
        }

        .actions {
            margin-top: 4px;
            display: flex;
            gap: 10px;
        }

        .table-custom {
            width: 100%;
            border-collapse: collapse;
            color: white;
        }

            .table-custom thead {
                background: rgba(167,139,250,.10);
            }

            .table-custom th {
                padding: 14px;
                text-align: left;
                font-size: 13px;
                font-weight: 600;
                color: #fff;
                border-bottom: 1px solid rgba(255,255,255,.15);
            }

            .table-custom td {
                padding: 12px;
                font-size: 12px;
                text-align: left;
                border-bottom: 1px solid rgba(255,255,255,.08);
                vertical-align: middle;
            }

            .table-custom tr:hover {
                background: rgba(255,255,255,.04);
            }

        .table-select,
        .table-input {
            width: 100%;
            min-width: 100px;
            background: rgba(255,255,255,.06);
            border: 1px solid rgba(255,255,255,.12);
            color: white;
            padding: 8px;
            border-radius: 6px;
        }

            .table-select option {
                background: #1a1040;
            }

        .table-custom td:nth-child(1) {
            width: 70px;
        }

        .table-custom td:nth-child(2) {
            width: 180px;
        }

        .table-custom td:nth-child(3) {
            width: 250px;
        }

        .table-custom td:nth-child(4) {
            width: 120px;
        }

        .table-custom td:nth-child(5) {
            width: 250px;
        }

        .table-custom td:nth-child(6) {
            width: 150px;
        }

        .table-custom td:nth-child(7) {
            width: 150px;
        }

        .table-custom td:nth-child(8) {
            width: 100px;
        }

        .badge {
            display: inline-block;
            padding: 3px 10px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
        }

        .badge-ok {
            background: rgba(52,211,153,.15);
            color: #34d399;
            border: 0.5px solid rgba(52,211,153,.3);
        }

        .badge-ng {
            background: rgba(248,113,113,.15);
            color: #f87171;
            border: 0.5px solid rgba(248,113,113,.3);
        }

        .badge-na {
            background: rgba(148,163,184,.15);
            color: #94a3b8;
            border: 0.5px solid rgba(148,163,184,.3);
        }

        @@media (max-width: 900px) {
            .form-row, .form-row-2 {
                grid-template-columns: 1fr;
            }

            .header-row, .data-row {
                grid-template-columns: repeat(2, 1fr);
            }
        }
    </style>
</head>
<body>

    <form asp-action="Index" method="post">
        <div class="form-card">
            <div class="form-card-header">Visual Inspection</div>
            <div class="form-body">

                <!-- Row 1 -->
                <div class="form-row">
                    <div class="form-group">
                        <label>Line</label>
                        <select asp-for="LineId"
                                asp-items="@(new SelectList(Model.Lines,"LineId","LineName"))">
                            <option value="">--Select Line--</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Project</label>
                        <select asp-for="ProjectId"
                                id="ProjectId"
                                asp-items="@(new SelectList(Model.Projects,"ProjectId","ProjectName"))">
                            <option value="">--Select Project--</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Model</label>
                        <select asp-for="ModelId"
                                asp-items="@(new SelectList(Model.ModelNos,"ModelId","Model"))"
                                class="form-control"
                                id="ModelId">
                            <option value="">--Select Model--</option>
                        </select>
                    </div>
                </div>

                <!-- Row 2 -->
                <div class="form-row">
                    <div class="form-group">
                        <label>Visual</label>

                        <select asp-for="VisualsId"
                                asp-items="@(new SelectList(Model.Visualss,"VisualsId","Visual"))"
                                class="form-control"
                                id="VisualsId">
                            <option value="">--Select Inspection--</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Part Number</label>
                        <select asp-for="PartId"
                                asp-items="@(new SelectList(Model.PartNos,"PartId","Part"))"
                                class="form-control"
                                id="PartId">
                            <option value="">--Select Part--</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Production Line Leader</label>
                        <input asp-for="ProdLineLeader"
                               id="txtLineLeader"
                               placeholder="Production Line Leader" />
                    </div>
                
                </div>

                <!-- Row 3 -->
                <div class="form-row">
                    <div class="form-group">
                        <label>Checked By</label>
                        <input asp-for="CheckedBy"
                               id="txtCheckedBy"
                               placeholder="Checked By" />
                    </div>
                    <div class="form-group">
                        <label>Approved By</label>
                        <input asp-for="ApprovedBy"
                               id="txtApprovedBy"
                               placeholder="Approved By" />
                    </div>
                    <div class="form-group" style="display:flex; justify-content:flex-end;">
                        <label style="visibility:hidden;">Search</label>
                        <button type="submit" class="btn-search">
                            Search
                        </button>
                    </div>
                </div>

            </div>
        </div>
    </form>

    <!-- NOTE BOX -->
    <div class="note-box">
        <span>NOTE:-</span>
        <span>N - NA</span>
        <span>, V - OK</span>
        <span>, X - NG</span>
    </div>

    <!-- RESULTS TABLE -->
    <div class="results-table">
        <table class="table-custom">

            <thead>
                <tr>
                    <th>SNO</th>
                    <th>Station Name</th>
                    <th>Inspection Project</th>
                    <th>Sample Size</th>
                    <th>Inspection Specification</th>
                    <th>Result</th>
                    <th>Defective Number</th>
                    <th>Save</th>
                </tr>
            </thead>

            <tbody>

                @if (Model.dtChecklist != null && Model.dtChecklist.Rows.Count > 0)
                {
                    string previousStation = "";

                    foreach (DataRow row in Model.dtChecklist.Rows)
                    {
                        // Hide only for PartId 23 and 26
                        if ((Model.PartId == 23 || Model.PartId == 26) &&
                        row["SNo"].ToString() == "430")
                        {
                            continue;
                        }
                        bool isFirstRow = previousStation != row["StationName"].ToString();

                        <tr class="inspection-row"
                                data-sno="@row["SNo"]">

                                <input type="hidden" class="dataid" value="@row["DataId"]" />
                            <td>
                                @row["SNo"]
                            </td>

                            <!-- Station Name -->
                            @if (isFirstRow)
                            {
                                <td class="station-first">
                                    @row["StationName"]
                                </td>

                                previousStation = row["StationName"].ToString();
                            }
                            else
                            {
                                <td class="station-continue"></td>
                            }

                            <td>@row["InpectionProject"]</td>

                            <td>@row["SampleSize"]</td>

                            <td>@row["InspectionSpecifaction"]</td>

                            <td>
                                <select class="table-select result">
                                    <option value="">Select</option>
                                    <option value="OK">OK</option>
                                    <option value="NG">NG</option>
                                    <option value="NA">NA</option>
                                </select>
                            </td>

                            <td>
                                <input type="text" class="table-input defective" />
                            </td>

                            <td>
                                <button type="button" class="btn-save-row btn-search">
                                    Save
                                </button>
                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="empty">
                            No records found.
                        </td>
                    </tr>
                }

            </tbody>

        </table>
    </div>

    <div class="actions">
        <button type="button"
                class="btn-submit"
                onclick="submitData()">
            Submit
        </button>
    </div>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
                $("#ProjectId").change(function () {

            var projectId = $(this).val();

            $.ajax({
                url: '/VisualInspection/GetModelNoByProject',
                type: 'POST',
                data: { projectId: projectId },
                success: function (result) {

                    $("#ModelId").empty();

                    $("#ModelId").append(
                        '<option value="">--Select Model--</option>');

                    $.each(result, function (i, item) {

                        $("#ModelId").append(
                            '<option value="' +
                            item.modelId +
                            '">' +
                            item.model +
                            '</option>');

                    });

                }
            });


            $.ajax({

                url: '/VisualInspection/GetVisuals',

                type: 'POST',

                data: { projectId: projectId },

                success: function (result) {

                    $("#VisualsId").empty();

                    $("#VisualsId").append(
                        '<option value="">--Select Inspection--</option>');

                    $.each(result, function (i, item) {

                        $("#VisualsId").append(
                            '<option value="' +
                            item.visualsId +
                            '">' +
                            item.visual +
                            '</option>');

                    });

                }

            });

        });

         $("#ModelId").change(function () {

            var modelId = $(this).val();

            $.ajax({

                url: '/VisualInspection/GetPartNoByModel',

                type: 'POST',   

                data: { modelId: modelId },

                success: function (result) {

                    $("#PartId").empty();

                    $("#PartId").append(
                        '<option value="">--Select Part--</option>');

                    $.each(result, function (i, item) {

                        $("#PartId").append(
                            '<option value="' +
                            item.partId +
                            '">' +
                            item.part +
                            '</option>');

                    });

                }

            });

        });

         $(document).on("click", ".btn-save-row", function () {

            var row = $(this).closest("tr");

            var model = {
                VisualInspectionResults: [{
                    DataId: row.find(".dataid").val(),
                    Section1: row.find(".result").val(),
                    DefectiveNumber: row.find(".defective").val()
                }],
                LineId: $("#LineId").val(),
                ProjectId: $("#ProjectId").val(),
                ModelId: $("#ModelId").val(),
                PartId: $("#PartId").val(),
                VisualsId: parseInt($("#VisualsId").val()) || 0,
                Model: $("#ModelId option:selected").text(),
                ProdLineLeader: $("#txtLineLeader").val(),
                CheckedBy: $("#txtCheckedBy").val(),
                ApprovedBy: $("#txtApprovedBy").val()
            };

            $.ajax({
                url: '/VisualInspection/SaveSingle',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(model),
                success: function (res) {
                    alert("Row Saved successfully");
                }
            });
        });

                function submitData() {

            var list = [];

            $("tbody tr").each(function () {

                var row = $(this);

                var dataId = row.find(".dataid").val();
                var result = row.find(".result").val();
                var defective = row.find(".defective").val();

                if (dataId && result !== "") {

                    list.push({
                        DataId: parseInt(dataId) || 0,
                        Section1: result,
                        DefectiveNumber: defective || "0"
                    });
                }
            });

            if (list.length === 0) {
                alert("Please enter at least one inspection result.");
                return;
            }

            var model = {

                VisualInspectionResults: list,

                LineId: parseInt($("#LineId").val()) || 0,
                ProjectId: parseInt($("#ProjectId").val()) || 0,
                ModelId: parseInt($("#ModelId").val()) || 0,
                PartId: parseInt($("#PartId").val()) || 0,
                VisualsId: parseInt($("#VisualsId").val()) || 0,

                Model: $("#ModelId option:selected").text(),

                ProdLineLeader: $("#txtLineLeader").val(),
                CheckedBy: $("#txtCheckedBy").val(),
                ApprovedBy: $("#txtApprovedBy").val()
            };

            $.ajax({
                url: '/VisualInspection/Submit',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(model),
                success: function (res) {

                    if (res.success) {
                        alert("Data Submitted Successfully");

                        $(".result").val("");
                        $(".defective").val("");

                        $("#txtLineLeader").val("");
                        $("#txtCheckedBy").val("");
                        $("#txtApprovedBy").val("");
                    }
                    else {
                        alert(res.message);
                    }
                },
                error: function (xhr) {
                    console.log(xhr.responseText);
                    alert("Server Error");
                }
            });
        }
        
    </script>
</body>
</html>