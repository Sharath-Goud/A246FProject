@model A246FProject.Models.A246FCTPParameterViewModel
@using Microsoft.AspNetCore.Mvc.Rendering
@using System.Data
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>A246F CTP Parameters</title>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Poppins, sans-serif;
        }

        body {
            background: linear-gradient(135deg, #0d0d1a, #0a0a2e, #0d1b2a);
            min-height: 100vh;
            color: #e2e8f0;
            padding: 20px;
        }

        h1 {
            font-size: 22px;
            font-weight: 600;
            color: #fff;
            margin-bottom: 4px;
        }

        .sub {
            color: rgba(255,255,255,.4);
            font-size: 13px;
            margin-bottom: 18px;
        }

        .form-card {
            background: rgba(255,255,255,.04);
            border: 0.5px solid rgba(255,255,255,.08);
            border-radius: 16px;
            overflow: hidden;
            margin-bottom: 16px;
        }

        .form-card-header {
            background: rgba(167,139,250,.12);
            border-bottom: 0.5px solid rgba(167,139,250,.2);
            padding: 14px 22px;
            font-size: 15px;
            font-weight: 600;
            color: #fff;
        }

        .form-body {
            padding: 22px;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .form-row {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 14px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        label {
            font-size: 11px;
            color: rgba(255,255,255,.45);
            text-transform: uppercase;
        }

        input, select {
            background: rgba(255,255,255,.06);
            border: 0.5px solid rgba(255,255,255,.12);
            border-radius: 8px;
            padding: 9px 12px;
            font-size: 13px;
            color: #fff;
            outline: none;
        }

            select option {
                background: #1a1040;
            }

            input:focus, select:focus {
                border-color: rgba(167,139,250,.5);
                background: rgba(167,139,250,.08);
            }

        /* BUTTON */
        .btn-search {
            background: linear-gradient(135deg, #a78bfa, #7c3aed);
            border: none;
            border-radius: 8px;
            padding: 10px 20px;
            color: #fff;
            cursor: pointer;
            font-size: 13px;
        }

        .btn-submit {
            background: linear-gradient(135deg, #60a5fa, #2563eb);
            border: none;
            border-radius: 8px;
            padding: 10px 24px;
            color: #fff;
            cursor: pointer;
            font-size: 13px;
        }

        /* ================= TABLE ================= */

        .results-table {
            background: rgba(255,255,255,.04);
            border: 1px solid rgba(255,255,255,.08);
            border-radius: 12px;
            overflow-x: auto;
            padding: 0;
        }

        .custom-table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
        }

            .custom-table thead tr {
                background: rgba(167,139,250,.12);
            }

            .custom-table th {
                padding: 12px 10px;
                text-align: left;
                color: #fff;
                font-size: 13px;
                font-weight: 600;
                border-bottom: 1px solid rgba(255,255,255,.08);
            }

            .custom-table td {
                padding: 10px 10px;
                color: #fff;
                font-size: 13px;
                border-bottom: 1px solid rgba(255,255,255,.06);
                vertical-align: top;
                line-height: 1.5;
            }

                /* Station No */
                .custom-table th:nth-child(1),
                .custom-table td:nth-child(1) {
                    width: 70px;
                }

                /* Station Name */
                .custom-table th:nth-child(2),
                .custom-table td:nth-child(2) {
                    width: 200px;
                }

                /* Equipment */
                .custom-table th:nth-child(3),
                .custom-table td:nth-child(3) {
                    width: 210px;
                }

                /* Parameter */
                .custom-table th:nth-child(4),
                .custom-table td:nth-child(4) {
                    width: 210px;
                }

                /* Unit */
                .custom-table th:nth-child(5),
                .custom-table td:nth-child(5) {
                    width: 80px;
                }

                /* LSL */
                .custom-table th:nth-child(6),
                .custom-table td:nth-child(6) {
                    width: 80px;
                }

                /* USL */
                .custom-table th:nth-child(7),
                .custom-table td:nth-child(7) {
                    width: 80px;
                }

                /* Value */
                .custom-table th:nth-child(8),
                .custom-table td:nth-child(8) {
                    width: 95px;
                    text-align: center;
                }

                /* Action */
                .custom-table th:nth-child(9),
                .custom-table td:nth-child(9) {
                    width: 90px;
                    text-align: center;
                }

                /* rowspan cells */
                .custom-table td[rowspan] {
                    vertical-align: top;
                    padding-top: 12px;
                }

        .value-box {
            width: 80px;
            height: 34px;
            border: 1px solid rgba(255,255,255,.15);
            border-radius: 4px;
            background: rgba(255,255,255,.06);
            color: #fff;
            text-align: center;
        }

        .btn-save {
            background: #3498db;
            border: none;
            color: white;
            padding: 7px 16px;
            border-radius: 3px;
            cursor: pointer;
            font-size: 13px;
        }

            .btn-save:hover {
                background: #2980b9;
            }

        .header-row {
            display: grid;
            grid-template-columns: repeat(9, 1fr);
            background: rgba(167,139,250,.08);
            padding: 12px;
            font-size: 11px;
            color: rgba(255,255,255,.45);
            text-transform: uppercase;
        }

        .empty {
            padding: 40px;
            text-align: center;
            color: rgba(255,255,255,.25);
            font-size: 13px;
        }

        .actions {
            margin-top: 16px;
        }

        @@media (max-width: 900px) {
            .form-row

        {
            grid-template-columns: 1fr;
        }

        .header-row {
            grid-template-columns: repeat(3, 1fr);
            gap: 10px;
        }

        }
    </style>
</head>

<body>

    <div class="form-card">

        <div class="form-card-header">
            A246F CTP Parameter
        </div>

        <form asp-action="Index" method="post">

            <div class="form-body">

                <!-- Row 1 -->

                <div class="form-row">

                    <div class="form-group">
                        <label>Line</label>

                        <select asp-for="LineId"
                                id="LineId"
                                asp-items="@(new SelectList(Model.Lines,
                    "LineId",
                    "LineName"))">
                            <option value="">-- Select Line --</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Project</label>

                        <select asp-for="ProjectId"
                                id="ProjectId"
                                asp-items="@(new SelectList(Model.Projects,
                                    "ProjectId",
                                    "ProjectName"))">
                            <option value="">-- Select Project --</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Model</label>

                        <select asp-for="ModelId"
                                id="ModelId"
                                asp-items="@(new SelectList(Model.ModelNos,
                                    "ModelId",
                                    "Model"))">
                            <option value="">-- Select Model --</option>
                        </select>
                    </div>

                </div>

                <!-- Row 2 -->

                <div class="form-row">

                    <div class="form-group">
                        <label>Part</label>

                        <select asp-for="PartId"
                                id="PartId"
                                asp-items="@(new SelectList(Model.PartNos,
                                    "PartId",
                                    "Part"))">
                            <option value="">-- Select Part --</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Machine</label>

                        <select asp-for="MachineId"
                                id="MachineId"
                                asp-items="@(new SelectList(Model.Machines,
                    "MachineId",
                    "Machine"))">
                            <option value="">-- Select Machine --</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Production Line Leader</label>

                        <input asp-for="ProdLineLeader"
                               type="text"
                               placeholder="Production Line Leader" />
                    </div>

                </div>

                <!-- Row 3 -->

                <div class="form-row">

                    <div class="form-group">
                        <label>Checked By</label>

                        <input asp-for="CheckedBy"
                               type="text" />
                    </div>

                    <div class="form-group">
                        <label>Approved By</label>

                        <input asp-for="ApprovedBy"
                               type="text" />
                    </div>

                    <div class="form-group"
                         style="justify-content:flex-end;">

                        <button type="submit"
                                class="btn-search">
                            Search
                        </button>
                    </div>
                </div>
            </div>
        </form>
    </div>

    <div class="results-table">

        @if (Model.dtChecklist != null &&
        Model.dtChecklist.Rows.Count > 0)
        {
            <table class="custom-table">
                <thead>
                    <tr>
                        <th>Station No</th>
                        <th>Station Name</th>
                        <th>Equipment Name/Model</th>
                        <th>Parameter Items</th>
                        <th>Unit</th>
                        <th>LSL</th>
                        <th>USL</th>
                        <th>Value</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>

                    @{
                        string currentStationId = "";
                    }

                    @for (int i = 0; i < Model.dtChecklist.Rows.Count; i++)
                    {
                        string stationId =
                        Model.dtChecklist.Rows[i]["StationId"].ToString();
                        bool isFirstRow =
                        stationId != currentStationId;
                        int rowSpan = 0;
                        if (isFirstRow)

                        {

                            currentStationId = stationId;
                            for (int j = i; j < Model.dtChecklist.Rows.Count; j++)

                            {
                                if (Model.dtChecklist.Rows[j]["StationId"].ToString() == stationId)

                                {
                                    rowSpan++;
                                }

                                else
                                {
                                    break;
                                }
                            }
                        }

                        <tr>

                            @if (isFirstRow)
                            {
                                <td rowspan="@rowSpan" style="vertical-align:top;">
                                    @Model.dtChecklist.Rows[i]["StationNo"]
                                </td>

                                <td rowspan="@rowSpan" style="vertical-align:top;">
                                    @Model.dtChecklist.Rows[i]["Station"]
                                </td>

                                <td rowspan="@rowSpan" style="vertical-align:top;">
                                    @Model.dtChecklist.Rows[i]["EquipmentModel"]
                                </td>
                            }

                            <td>
                                @Model.dtChecklist.Rows[i]["Parameter"]
                            </td>

                            <td>
                                @Model.dtChecklist.Rows[i]["unit"]
                            </td>

                            <td>
                                @Model.dtChecklist.Rows[i]["LSL"]
                            </td>

                            <td>
                                @Model.dtChecklist.Rows[i]["USL"]
                            </td>

                            <td>

                                <input type="hidden"
                                       name="A246FCTPParameterResults[@i].LimitId"
                                       value="@Model.dtChecklist.Rows[i]["LimitId"]" />

                                <input type="text"
                                       class="value-box"
                                       name="A246FCTPParameterResults[@i].Value" />

                            </td>

                            <td>
                                <button type="button"
                                        class="btn-search"
                                        onclick="SaveSingleRow(this,@i)">
                                    Save
                                </button>
                            </td>

                        </tr>
                    }

                </tbody>
            </table>
        }
        else
        {
            <div class="empty">
                No records found. Use search to load data.
            </div>
        }
    </div>
    <div class="actions">
        <button type="button"
                class="btn-submit"
                onclick="Save();">
            Submit
        </button>

    </div>
    <script>
        var LoggedInRole = '@ViewBag.Role';
    </script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>

        $("#ModelId").change(function () {

            var modelId = $("#ModelId").val();

            $.ajax({
                url: '/CTPParameter/GetPartNoByModel',
                type: 'POST',
                data: { modelId: modelId },

                success: function (data) {

                    $("#PartId").empty();

                    $("#PartId").append(
                        '<option value="">-- Select Part --</option>'
                    );

                    $.each(data, function (i, item) {

                        $("#PartId").append(
                            '<option value="' +
                            item.partId +
                            '">' +
                            item.part +
                            '</option>'
                        );
                    });
                }
            });

        });

                $("#ProjectId").change(function () {

            var projectId = $(this).val();

            $.ajax({
                url: '/CTPParameter/GetModelNoByProject',
                type: 'POST',
                data: { projectId: projectId },

                success: function (data) {

                    $("#ModelId").empty();

                    $("#ModelId").append(
                        '<option value="">-- Select Model --</option>'
                    );

                    $.each(data, function (i, item) {

                        $("#ModelId").append(
                            '<option value="' +
                            item.modelId +
                            '">' +
                            item.model +
                            '</option>'
                        );

                    });

                    $("#PartId").empty();

                    $("#PartId").append(
                        '<option value="">-- Select Part --</option>'
                    );
                }
            });

        });



        function Save()
        {
            var Results = [];

            $("input[name$='.Value']").each(function (index)
            {
                var value = $(this).val();

                var limitId =
                    $("input[name='A246FCTPParameterResults[" +
                    index +
                    "].LimitId']").val();
                    if(value != "" && !isNaN(value))
                    {
                        Results.push({
                            LimitId: limitId,
                            Value: value
                        });
                    }
            });

            var obj = {

                LineId: $("#LineId").val(),

                ProjectId: $("#ProjectId").val(),

                ModelId: $("#ModelId").val(),

                PartId: $("#PartId").val(),

                MachineId: $("#MachineId").val(),

                ProdLineLeader:
                    $("input[name='ProdLineLeader']").val(),

                CheckedBy:
                    $("input[name='CheckedBy']").val(),

                ApprovedBy:
                    $("input[name='ApprovedBy']").val(),

                A246FCTPParameterResults:
                    Results
            };

            $.ajax({
                url: '/CTPParameter/SaveA246FCTPParameter',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(obj),

                success: function (response)
                {
                    alert('Saved Successfully');

                    location.reload();
                },

                error: function ()
                {
                    alert('Save Failed');
                }
            });
        }


                function SaveSingleRow(btn, index)
        {
            var limitId =
                $("input[name='A246FCTPParameterResults[" +
                    index +
                    "].LimitId']").val();

            var value =
                $("input[name='A246FCTPParameterResults[" +
                    index +
                    "].Value']").val();

            if (value == "")
            {
                alert("Please enter value");
                return;
            }

            var Results = [];

            Results.push({
                LimitId: limitId,
                Value: value
            });
            
            var obj =
            {
                LineId: $("#LineId").val(),

                ProjectId: $("#ProjectId").val(),

                ModelId: $("#ModelId").val(),

                PartId: $("#PartId").val(),

                MachineId: $("#MachineId").val(),

                ProdLineLeader:
                    $("input[name='ProdLineLeader']").val(),

                CheckedBy:
                    $("input[name='CheckedBy']").val(),

                ApprovedBy:
                    $("input[name='ApprovedBy']").val(),

                A246FCTPParameterResults:
                    Results
            };
            console.log('ctp data sending : ',JSON.stringify(obj));
            $.ajax({
                url: '/CTPParameter/SaveA246FCTPParameter',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(obj),

                        success: function (response)
        {
            alert("Saved Successfully");

            // disable VALUE input
            $("input[name='A246FCTPParameterResults[" + index + "].Value']")
                .prop("disabled", true);

            // disable SAVE button
            $(btn)
                .prop("disabled", true)
                .text("Saved")
                .css({
                    "background": "#28a745",
                    "cursor": "not-allowed",
                    "opacity": "0.7"
                });
        },

                error: function ()
                {
                    alert("Save Failed");
                }
            });
        } 

    </script>
</body>
</html>