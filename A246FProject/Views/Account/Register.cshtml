@model A246FProject.Models.User

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>

    <meta charset="utf-8" />

    <title>Register</title>

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI',sans-serif;
        }

        body {
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            background: #0f172a;
            overflow: hidden;
        }

            body::before,
            body::after {
                content: '';
                position: absolute;
                width: 300px;
                height: 300px;
                border-radius: 50%;
                filter: blur(80px);
                opacity: .7;
                animation: floatBlobs 8s infinite alternate;
            }

            body::before {
                background: #ff512f;
                top: 10%;
                left: 15%;
            }

            body::after {
                background: #2193b0;
                bottom: 10%;
                right: 15%;
            }

        @@keyframes floatBlobs {

            0% {
                transform: translate(0,0) scale(1);
            }

            100% {
                transform: translate(50px,-50px) scale(1.2);
            }
        }

        .register-box {
            width: 420px;
            padding: 40px;
            background: rgba(255,255,255,.08);
            backdrop-filter: blur(18px);
            border-radius: 20px;
            box-shadow: 0 0 40px rgba(0,0,0,.4);
            position: relative;
            color: white;
            animation: fadeUp 1s forwards;
            opacity: 0;
            transform: translateY(40px);
        }

        @@keyframes fadeUp {

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .register-box::before {
            content: '';
            position: absolute;
            inset: -2px;
            border-radius: 20px;
            background: linear-gradient(45deg,#ff512f,#2193b0,#dd2476);
            filter: blur(8px);
            z-index: -1;
            opacity: .7;
            animation: glowPulse 3s infinite;
        }

        @@keyframes glowPulse {

            0%, 100% {
                opacity: .4;
            }

            50% {
                opacity: .9;
            }
        }

        h2 {
            text-align: center;
            margin-bottom: 25px;
            font-size: 30px;
        }

        .input-box {
            margin-bottom: 18px;
        }

            .input-box input {
                width: 100%;
                padding: 12px;
                border: none;
                outline: none;
                border-radius: 10px;
                background: rgba(255,255,255,.1);
                color: white;
                transition: .3s;
            }

                .input-box input::placeholder {
                    color: #ddd;
                }

                .input-box input:focus {
                    border: 1px solid #00f2fe;
                    box-shadow: 0 0 12px #00f2fe;
                    transform: scale(1.03);
                }

        .btn {
            width: 100%;
            padding: 12px;
            border: none;
            border-radius: 10px;
            background: linear-gradient(45deg,#ff512f,#dd2476);
            color: white;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            transition: .3s;
        }

            .btn:hover {
                transform: scale(1.05);
                box-shadow: 0 0 20px rgba(255,81,47,.6);
            }

        .error {
            color: red;
            text-align: center;
            margin-bottom: 10px;
        }

        .login-link {
            margin-top: 20px;
            text-align: center;
        }

            .login-link a {
                color: #00f2fe;
                text-decoration: none;
                font-weight: bold;
            }

                .login-link a:hover {
                    text-decoration: underline;
                }

        .role-group {
            display: flex;
            align-items: center;
            gap: 25px;
            margin-top: 5px;
        }

        .role-item {
            display: flex;
            align-items: center;
            gap: 6px;
            color: white;
            font-size: 15px;
            cursor: pointer;
        }

            .role-item input[type="radio"] {
                width: auto !important;
                margin: 0;
                transform: scale(1.1);
            }
    </style>

</head>

<body>

    <div class="register-box">

        <h2>Create Account</h2>

        @if (ViewBag.Error != null)
        {
            <div class="error">@ViewBag.Error</div>
        }

        <form asp-action="Register" method="post">

            <div class="input-box">

                <input asp-for="EmployeeId" placeholder="Employee ID" />

            </div>

            <div class="input-box">

                <input asp-for="Name" placeholder="Full Name" />

            </div>

            <div class="input-box">

                <input asp-for="Password"
                       type="password"
                       placeholder="Password" />

            </div>

            <div class="input-box">

                <input asp-for="ConfirmPassword"
                       type="password"
                       placeholder="Confirm Password" />

            </div>
            <div class="input-box">

                <label style="color:white;display:block;margin-bottom:10px;font-weight:600;">
                    Role
                </label>

                <div class="role-group">

                    <label class="role-item">
                        <input type="radio"
                               asp-for="Role"
                               value="Admin" />
                        Admin
                    </label>

                    <label class="role-item">
                        <input type="radio"
                               asp-for="Role"
                               value="User"
                               checked />
                        User
                    </label>

                </div>

            </div>

            <button type="submit" class="btn">
                Register
            </button>

        </form>

        <div class="login-link">

            Already have an account?

            <br><br>

            <a asp-action="Login">

                Login Here

            </a>

        </div>

    </div>

</body>

</html>