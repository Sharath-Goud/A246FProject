@model A246FProject.Models.Reports.NegativeValidationReportViewModel
@using System.Data
@using Microsoft.AspNetCore.Mvc.Rendering
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Negative Validation Report</title>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Poppins, sans-serif;
        }

        body {
            background: linear-gradient(135deg, #0d0d1a, #0a0a2e, #0d1b2a);
            min-height: 100vh;
            color: #e2e8f0;
            padding: 20px;
        }

        h1 {
            font-size: 22px;
            font-weight: 600;
            color: #fff;
            margin-bottom: 4px;
        }

        .sub {
            color: rgba(255,255,255,.4);
            font-size: 13px;
            margin-bottom: 18px;
        }

        /* FORM CARD */
        .form-card {
            background: rgba(255,255,255,.04);
            border: 0.5px solid rgba(255,255,255,.08);
            border-radius: 16px;
            overflow: hidden;
            margin-bottom: 16px;
        }

        .form-card-header {
            background: rgba(167,139,250,.12);
            border-bottom: 0.5px solid rgba(167,139,250,.2);
            padding: 14px 22px;
            font-size: 15px;
            font-weight: 600;
            color: #fff;
        }

        .form-body {
            padding: 22px;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .form-row {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 14px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        label {
            font-size: 11px;
            color: rgba(255,255,255,.45);
        }

        input, select {
            background: rgba(255,255,255,.06);
            border: 0.5px solid rgba(255,255,255,.12);
            border-radius: 8px;
            padding: 9px 12px;
            font-size: 13px;
            color: #fff;
            outline: none;
        }

            select option {
                background: #1a1040;
            }

            input:focus, select:focus {
                border-color: rgba(167,139,250,.5);
                background: rgba(167,139,250,.08);
            }

        .note-box {
            background: rgba(255,255,255,.04);
            border: 1px solid rgba(255,255,255,.08);
            border-left: 4px solid #ef4444;
            border-radius: 10px;
            padding: 15px 20px;
            margin: 15px 0;
            color: #ff6b6b;
            font-size: 14px;
            line-height: 1.8;
            font-weight: 500;
        }

            .note-box strong {
                color: #ff4040;
                font-size: 15px;
            }

        .custom-table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
        }

            .custom-table th {
                background: rgba(167,139,250,.12);
                color: #fff;
                padding: 12px;
                font-size: 12px;
                text-align: left;
                border-bottom: 1px solid rgba(255,255,255,.1);
            }

            .custom-table td {
                padding: 10px;
                font-size: 12px;
                color: #fff;
                border-bottom: 1px solid rgba(255,255,255,.06);
                vertical-align: top;
                word-wrap: break-word;
            }

            .custom-table select,
            .custom-table input {
                width: 100%;
                font-size: 12px;
                border-radius: 4px;
            }

                .custom-table input[type="file"] {
                    font-size: 11px;
                }

            .custom-table td {
                white-space: normal;
            }

                .custom-table td[rowspan] {
                    vertical-align: top;
                    font-weight: 500;
                }


        .btn-search {
            background: linear-gradient(135deg, #a78bfa, #7c3aed);
            border: none;
            border-radius: 8px;
            padding: 10px 20px;
            color: #fff;
            cursor: pointer;
            font-size: 13px;
        }

        .btn-submit {
            background: linear-gradient(135deg, #60a5fa, #2563eb);
            border: none;
            border-radius: 8px;
            padding: 10px 24px;
            color: #fff;
            cursor: pointer;
            font-size: 13px;
        }

        /* TABLE */
        .results-table {
            background: rgba(255,255,255,.04);
            border: 0.5px solid rgba(255,255,255,.08);
            border-radius: 16px;
            overflow: hidden;
        }

        .header-row {
            display: grid;
            grid-template-columns: repeat(9, 1fr);
            background: rgba(167,139,250,.08);
            padding: 12px;
            font-size: 11px;
            color: rgba(255,255,255,.45);
        }

        .empty {
            padding: 40px;
            text-align: center;
            color: rgba(255,255,255,.25);
            font-size: 13px;
        }

        .actions {
            margin-top: 16px;
        }

        @@media (max-width: 900px) {
            .form-row {
                grid-template-columns: 1fr;
            }

            .header-row {
                grid-template-columns: repeat(3, 1fr);
                gap: 10px;
            }
        }
    </style>
</head>

<body>

    <form asp-action="Index" asp-controller="NegativeValidationReport" method="post" enctype="multipart/form-data">

        <div class="form-card">

            <div class="form-card-header">
                Negative Validation Report
            </div>

            <div class="form-body">

                <div class="form-row">

                    <div class="form-group">

                        <label>Line</label>

                        <select asp-for="LineId"
                                asp-items="@(new SelectList(Model.Lines, "LineId", "LineName"))">

                            <option value="">-- Select Line --</option>

                        </select>

                    </div>

                    <div class="form-group">

                        <label>Shift</label>

                        <select asp-for="ShiftId"
                                asp-items="@(new SelectList(Model.Shifts, "ShiftId", "ShiftName"))">

                            <option value="">--Select Shift--</option>

                        </select>

                    </div>

                    <div class="form-group">

                        <label>Project</label>

                        <select asp-for="ProjectId"
                                id="ProjectId">

                            <option value="">-- Select Project --</option>

                            @foreach (var item in Model.Projects)

                            {
                                <option value="@item.ProjectId">
                                    @item.ProjectName
                                </option>
                            }

                        </select>

                    </div>

                </div>

                <div class="form-row">

                    <div class="form-group">

                        <label>Date</label>

                        <input asp-for="FromDate"
                               type="date"
                               class="form-control" />

                    </div>

                    <div class="form-group">
                    </div>

                    <div class="form-group"
                         style="justify-content:flex-end;">

                        <button type="submit"
                                name="command"
                                value="Search"
                                class="btn-search">
                            Search
                        </button>

                    </div>

                </div>

            </div>

        </div>

        <div class="note-box">
            <div><strong>NOTE:-</strong></div>
            <div>Good Sample indicates good. It must be <b>OK</b>.</div>
            <div>Good Sample indicates abnormal. It must be <b>NG</b>.</div>
            <div>Fail Sample indicates good. It must be <b>NG</b>.</div>
            <div>Fail Sample indicates abnormal. It must be <b>OK</b>.</div>
        </div>

        <div class="results-table">

            <table class="custom-table">

                <thead>

                    <tr>

                        <th>Station</th>

                        <th>Inspection</th>

                        <th>Frequency</th>

                        <th>Periods</th>

                        <th>Good Sample</th>

                        <th>Fail Sample</th>

                        <th>Result</th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model.dtReports.Rows.Count > 0)
                    {
                        string currentGroup = "";

                        for (int i = 0; i < Model.dtReports.Rows.Count; i++)
                        {
                            var row = Model.dtReports.Rows[i];

                            string group =
                            row["StationName"].ToString() + "|" +
                            row["Inspection"].ToString() + "|" +
                            row["Frequency"].ToString();

                            bool firstRow = group != currentGroup;

                            int rowspan = 0;

                            if (firstRow)
                            {
                                currentGroup = group;

                                for (int j = i; j < Model.dtReports.Rows.Count; j++)
                                {
                                    string nextGroup =
                                    Model.dtReports.Rows[j]["StationName"].ToString() + "|" +
                                    Model.dtReports.Rows[j]["Inspection"].ToString() + "|" +
                                    Model.dtReports.Rows[j]["Frequency"].ToString();

                                    if (nextGroup == group)
                                        rowspan++;
                                    else
                                        break;
                                }
                            }

                            <tr>

                                @if (firstRow)
                                {
                                    <td rowspan="@rowspan">
                                        @row["StationName"]
                                    </td>

                                    <td rowspan="@rowspan">
                                        @row["Inspection"]
                                    </td>

                                    <td rowspan="@rowspan">
                                        @row["Frequency"]
                                    </td>
                                }

                                <td>
                                    @row["Periods"]
                                </td>

                                <td>
                                    @row["GoodSample"]
                                </td>

                                <td>
                                    @row["FailSample"]
                                </td>

                                <td style="font-weight:bold;
                        color:@(row["Result"].ToString()=="PASS"
                                                        ? "green"
                                                        : "red")">

                            @row["Result"]

                                </td>

                            </tr>
                                        }
                    }

                </tbody>

            </table>

        </div>

        <div class="actions">

            <button type="button"
                    class="btn-submit"
                    onclick="Save()">
                Submit
            </button>

        </div>

    </form>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>

    <script>
        $(document).ready(function () {

            $("#datepicker").datepicker({
                dateFormat: "dd/mm/yy",
                changeMonth: true,
                changeYear: true,
                showAnim: "fadeIn"
            });

        });
    </script>
</body>
</html>