@{
    ViewData["Title"] = ViewData["Title"] ?? "A246F Project";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - A246FProject</title>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Poppins, sans-serif;
        }

        body {
            background: linear-gradient(135deg, #0d0d1a, #0a0a2e, #0d1b2a);
            min-height: 100vh;
            color: #e2e8f0;
        }

        .sidebar {
            position: fixed;
            left: 16px;
            top: 16px;
            bottom: 16px;
            width: 240px;
            background: linear-gradient(160deg, #1a1040 0%, #0d1b2a 100%);
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0,0,0,.4);
            border: 0.5px solid rgba(255,255,255,.06);
            display: flex;
            flex-direction: column;
            overflow: hidden; 
        }

        .logo {
            font-size: 17px;
            font-weight: 600;
            margin-bottom: 14px;
            padding: 20px;
            border-bottom: 0.5px solid rgba(255,255,255,.08);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .nav-btn {
            width: 100%;
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 12px;
            background: none;
            border: none;
            color: rgba(255,255,255,.65);
            font-size: 13px;
            cursor: pointer;
            border-radius: 10px;
            transition: .25s;
        }

            .nav-btn:hover {
                background: rgba(167,139,250,.12);
                color: #fff;
            }

            .nav-btn.active {
                background: linear-gradient(90deg, rgba(167,139,250,.25), rgba(99,179,237,.12));
                color: #fff;
                border-left: 4px solid #ffffff;
                box-shadow: 0 0 10px rgba(109,93,252,0.6);
            }

        .chevron {
            margin-left: auto;
            font-size: 12px;
            transition: transform .3s ease;
            opacity: .8;
        }

        .nav-btn.active .chevron {
            transform: rotate(180deg);
        }

        .dropdown {
            max-height: 0;
            overflow: hidden;
            transition: max-height .35s ease;
        }

            .dropdown.open {
                max-height: 600px;
            }

        .dd-item {
            padding: 8px 12px 8px 34px;
            font-size: 12px;
            color: rgba(255,255,255,.55);
            cursor: pointer;
            border-radius: 8px;
            transition: .2s;
        }

            .dd-item:hover {
                background: rgba(167,139,250,.1);
                color: #d8b4fe;
            }

            .dd-item.selected {
                color: #d8b4fe;
            }

        .header {
            position: fixed;
            left: 280px;
            right: 16px;
            top: 16px;
            height: 56px;
            background: rgba(255,255,255,.04);
            backdrop-filter: blur(16px);
            border: 0.5px solid rgba(255,255,255,.08);
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 18px;
        }

        .search {
            display: flex;
            align-items: center;
            gap: 8px;
            background: rgba(255,255,255,.06);
            padding: 6px 12px;
            border-radius: 30px;
            border: 0.5px solid rgba(255,255,255,.08);
            width: 260px;
        }

            .search input {
                background: none;
                border: none;
                outline: none;
                color: #fff;
                width: 100%;
            }

        .main {
            margin-left: 280px;
            padding: 90px 20px 20px 20px;
        }

        @@keyframes fade {
            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .main {
            animation: fade .4s ease;
        }

        .register-icon {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: rgba(255,255,255,.08);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            text-decoration: none;
            transition: .3s;
        }

            .register-icon:hover {
                background: #7c3aed;
                color: white;
            }

        .logout-icon {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: rgba(255,255,255,.08);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            text-decoration: none;
            transition: .3s;
        }

            .logout-icon:hover {
                background: #7c3aed;
                color: white;
            }

        .profile-avatar {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: #7c3aed;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            cursor: pointer;
            transition: .3s;
        }

            .profile-avatar:hover {
                transform: scale(1.05);
            }

        .profile-popup {
            position: absolute;
            top: 65px;
            right: 20px;
            width: 320px;
            background: linear-gradient( 160deg, #1a1040 0%, #0d1b2a 100%);
            border: 1px solid rgba(255,255,255,.08);
            border-radius: 20px;
            overflow: hidden;
            display: none;
            z-index: 9999;
            box-shadow: 0 25px 50px rgba(0,0,0,.5);
        }

            .profile-popup.show {
                display: block;
                animation: popupShow .25s ease;
            }

        @@keyframes popupShow {
            from {
                opacity: 0;
                transform: translateY(-10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .popup-top {
            padding: 24px;
            text-align: center;
            background: rgba(124,58,237,.15);
        }

        .popup-avatar {
            width: 70px;
            height: 70px;
            border-radius: 50%;
            background: #7c3aed;
            margin: auto;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            font-weight: 700;
        }

        .popup-name {
            margin-top: 12px;
            font-size: 18px;
            font-weight: 600;
        }

        .popup-role {
            color: #c4b5fd;
            font-size: 13px;
            margin-top: 4px;
        }

        .popup-body {
            padding: 20px;
        }

        .profile-row {
            display: flex;
            justify-content: space-between;
            padding: 12px 0;
            border-bottom: 1px solid rgba(255,255,255,.06);
        }

            .profile-row span {
                color: #94a3b8;
            }

            .profile-row strong {
                color: white;
            }

        .popup-footer {
            padding: 16px;
        }

        .popup-logout {
            display: block;
            text-align: center;
            background: #7c3aed;
            color: white;
            text-decoration: none;
            padding: 10px;
            border-radius: 10px;
        }

        .sidebar-scroll {
            flex: 1;
            overflow-y: auto;
            padding-right: 6px;
        }

            .sidebar-scroll::-webkit-scrollbar {
                width: 6px;
            }

            .sidebar-scroll::-webkit-scrollbar-thumb {
                background: rgba(255,255,255,0.15);
                border-radius: 10px;
            }
    </style>
</head>

<body>

    <div class="sidebar">

        <div class="logo">
            <i class="ti ti-shield-check"></i>
            QA SYSTEM
        </div>
            <div class="sidebar-scroll">
            <button class="nav-btn" data-menu="menu" onclick="setActiveMenu(this, 'menu')">
                    <i class="ti ti-forms"></i>
                    A246F Forms
                    <i class="fa-solid fa-chevron-down chevron"></i>
                </button>

                <div class="dropdown" id="menu">

                    <div class="dd-item" onclick="go('/CTPParameter/Index')">
                        A246F CTP Parameters
                    </div>
                    <div class="dd-item" onclick="go('/GlueWeighing/Index')">
                        Glue Weighing
                    </div>
                    <div class="dd-item" onclick="go('/SOPPOR/Index')">
                        SOP/POR
                    </div>
                    <div class="dd-item" onclick="go('/FirstArticleInspection/Index')">
                        First Article Inspection
                    </div>
                    <div class="dd-item" onclick="go('/FirstArticleDimension/Index')">
                        First Article Dimension
                        </div>
                    <div class="dd-item" onclick="go('/VisualInspection/Index')">
                        Visual Inspection
                    </div>
                    <div class="dd-item" onclick="go('/CCMCHI4SC/Index')">
                        CCM &amp; CHI &amp; 4SC
                    </div>
                    <div class="dd-item" onclick="go('/WireCombMolding/Index')">
                        Wire Comb Molding
                    </div>
                    <div class="dd-item" onclick="go('/HotBar/Index')">
                        Hot Bar
                    </div>
                    <div class="dd-item" onclick="go('/Destructive/Index')">
                        Destructive
                    </div>
                    <div class="dd-item" onclick="go('/ShellCrimp/Index')">
                        Shell Crimp
                    </div>
                    <div class="dd-item" onclick="go('/InnerMold/Index')">
                        Inner Mold
                    </div>
                    <div class="dd-item" onclick="go('/AOI/Index')">
                        AOI
                    </div>
                    <div class="dd-item" onclick="go('/LaserEngraving/Index')">
                        Laser Engraving
                    </div>
                    <div class="dd-item" onclick="go('/NewHanking/Index')">
                        New Hanking
                    </div>
                    <div class="dd-item" onclick="go('/OQCInspection/Index')">
                        OQC Inspection
                    </div>

                </div>
            <button class="nav-btn" data-menu="reportsMenu" onclick="setActiveMenu(this, 'reportsMenu')">
                    <i class="ti ti-report-analytics"></i>
                    Reports
                    <i class="fa-solid fa-chevron-down chevron"></i>
                </button>

                <div class="dropdown" id="reportsMenu">

                    <div class="dd-item" onclick="go('/A246FCTPParameterReport/Index')">
                        CTP Parameter Report
                    </div>

                    <div class="dd-item" onclick="go('/GlueWeighingReport/Index')">
                        Glue Weighing Report
                    </div>

                    <div class="dd-item" onclick="go('/SOPPORReport/Index')">
                        SOP/POR Report
                    </div>

                    <div class="dd-item" onclick="go('/FirstArticleInspectionReport/Index')">
                        First Article Inspection Report
                    </div>

                    <div class="dd-item" onclick="go('/FirstArticleDimensionReport/Index')">
                        First Article Dimension Report
                    </div>

                    <div class="dd-item" onclick="go('/VisualInspectionReport/Index')">
                        Visual Inspection Report
                    </div>

                    <div class="dd-item" onclick="go('/CCMCHI4SCReport/Index')">
                        CCM CHI 4SC Report
                    </div>

                    <div class="dd-item" onclick="go('/WireCombMoldingReport/Index')">
                        Wire Comb Molding Report
                    </div>

                    <div class="dd-item" onclick="go('/HotBarReport/Index')">
                        Hot Bar Report
                    </div>

                    <div class="dd-item" onclick="go('/DestructiveReport/Index')">
                        Destructive Report
                    </div>

                    <div class="dd-item" onclick="go('/ShellCrimpReport/Index')">
                        Shell Crimp Report
                    </div>

                    <div class="dd-item" onclick="go('/InnerMoldReport/Index')">
                        Inner Mold Report
                    </div>

                    <div class="dd-item" onclick="go('/AOIReport/Index')">
                        AOI Report
                    </div>

                    <div class="dd-item" onclick="go('/LaserEngravingReport/Index')">
                        Laser Engraving Report
                    </div>

                    <div class="dd-item" onclick="go('/NewHankingReport/Index')">
                        New Hanking Report
                    </div>

                    <div class="dd-item" onclick="go('/OQCInspectionReport/Index')">
                        OQC Inspection Report
                    </div>

                </div>

            <button class="nav-btn" data-menu="serinReportsMenu" onclick="setActiveMenu(this, 'serinReportsMenu')">
                    <i class="ti ti-report-analytics"></i>
                    Serin Reports
                    <i class="fa-solid fa-chevron-down chevron"></i>
                </button>

                <div class="dropdown" id="serinReportsMenu">

                    <div class="dd-item" onclick="go('/GlueWeighingReport/Index')">
                        Glue Weighing Report
                    </div>

                    <div class="dd-item" onclick="go('/SerinDestructiveReport/Index')">
                        Destructive Report
                    </div>

                    <div class="dd-item" onclick="go('/SerinDimensionReport/Index')">
                        Dimensions Report
                    </div>
                </div>
            </div>
    </div>

    <div class="header">

        <div class="search">
            <i class="ti ti-search"></i>
            <input placeholder="Search..." />
        </div>

        <div style="display:flex;gap:16px;align-items:center;">

            <a href="/Account/Register"
               title="Registration"
               class="register-icon">
                <i class="fa-solid fa-user-plus"></i>
            </a>

            <a href="/Account/Logout"
               title="Logout"
               class="logout-icon">
                <i class="fa-solid fa-right-from-bracket"></i>
            </a>

            <div class="profile-avatar"
                 onclick="toggleProfilePopup()">

                @Context.Session.GetString("Name")?.Substring(0, 1).ToUpper()

            </div>

            <div id="profilePopup" class="profile-popup">

                <div class="popup-top">

                    <div class="popup-avatar">
                        @Context.Session.GetString("Name")?.Substring(0, 1).ToUpper()
                    </div>

                    <div class="popup-name">
                        @Context.Session.GetString("Name")
                    </div>

                    <div class="popup-role">
                        @Context.Session.GetString("Role")
                    </div>

                </div>

                <div class="popup-body">

                    <div class="profile-row">
                        <span>Employee ID</span>
                        <strong>@Context.Session.GetString("User")</strong>
                    </div>

                    <div class="profile-row">
                        <span>Name</span>
                        <strong>@Context.Session.GetString("Name")</strong>
                    </div>

                    <div class="profile-row">
                        <span>Role</span>
                        <strong>@Context.Session.GetString("Role")</strong>
                    </div>

                </div>

            </div>

        </div>

    </div>

    <div class="main">
        @RenderBody()
    </div>

    <script>

        function toggleMenu(menuId, btn) {

            // close other dropdowns
            document.querySelectorAll('.dropdown').forEach(x => {
                if (x.id !== menuId) x.classList.remove('open');
            });

            // remove active state from other buttons
            document.querySelectorAll('.nav-btn').forEach(x => {
                if (x !== btn) x.classList.remove('open');
            });

            // toggle selected menu
            document.getElementById(menuId).classList.toggle('open');

            // toggle active button
            btn.classList.toggle('open');
        }

        function go(url) {
            window.location.href = url;
        }

        document.querySelectorAll('.dd-item').forEach(x => {
            x.addEventListener('click', function () {
                document.querySelectorAll('.dd-item').forEach(i => i.classList.remove('selected'));
                this.classList.add('selected');
            });
        });


        function toggleReports() {
            document.getElementById('reportsMenu')
                    .classList.toggle('open');
        }

        function toggleSerinReports() {
            document.getElementById('serinReportsMenu')
                    .classList.toggle('open');
        }

        function setActiveMenu(btn, menuId) {

            const menu = document.getElementById(menuId);

            const isOpen = menu.classList.contains("open");

            document.querySelectorAll('.dropdown').forEach(x => {
                x.classList.remove('open');
            });

            document.querySelectorAll('.nav-btn').forEach(x => {
                x.classList.remove('active');
            });

            if (!isOpen) {
                menu.classList.add("open");
                btn.classList.add("active");
                localStorage.setItem("activeMenu", menuId);
            } else {
                localStorage.removeItem("activeMenu");
            }
        }

        window.onload = function () {

            let savedMenu = localStorage.getItem("activeMenu");

            if (savedMenu) {
                let btn = document.querySelector(`[data-menu="${savedMenu}"]`);
                let menu = document.getElementById(savedMenu);

                if (btn && menu) {
                    btn.classList.add("active");
                    menu.classList.add("open");
                }
            }
        }
    </script>

    <script>

        function toggleProfilePopup() {
            document
                .getElementById("profilePopup")
                .classList.toggle("show");
        }

        document.addEventListener("click", function(e) {

            const popup =
                document.getElementById("profilePopup");

            const avatar =
                document.querySelector(".profile-avatar");

            if (!popup.contains(e.target) &&
                !avatar.contains(e.target))
            {
                popup.classList.remove("show");
            }
        });

    </script>

    @RenderSection("Scripts", required: false)

</body>
</html>